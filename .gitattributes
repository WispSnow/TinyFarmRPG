# 统一换行符：文本文件在仓库与工作区均使用 LF，
# 避免 Windows 协作者 core.autocrlf 引入 CRLF 抖动。
* text=auto eol=lf

# 第三方源码保持原样，不做换行转换
external/** -text

# 二进制资源（显式声明，避免误判）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.ttf binary
*.otf binary
*.wav binary
*.ogg binary
*.mp3 binary
*.efk binary
*.efkefc binary
*.efkmat binary
*.efkmodel binary
*.efkcurve binary
