body, div, h1, h2, h3, h4, p, hr {
    display: block;
}

#shop-panel {
    left: 48dp;
    top: 34dp;
    width: 544dp;
    height: 292dp;
    padding: 16dp 18dp 16dp 18dp;
}

#shop-header {
    width: 100%;
    height: 48dp;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

#shop-header-copy {
    width: 404dp;
    height: 48dp;
}

#shop-title {
    width: 100%;
    height: 22dp;
    line-height: 22dp;
    color: #ffffffff;
    font-effect: shadow(1dp 1dp #000000cc);
}

#shop-greeting {
    margin-top: 6dp;
    width: 100%;
    color: #d8e3e6ff;
}

#shop-body {
    margin-top: 12dp;
    width: 100%;
    height: 212dp;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
}

#shop-list-column {
    width: 190dp;
    height: 212dp;
}

#shop-detail-column {
    width: 312dp;
    height: 212dp;
}

.shop-section-title {
    width: 100%;
    height: 20dp;
    line-height: 20dp;
    color: #fce97fff;
    font-effect: shadow(1dp 1dp #000000cc);
}

#shop-list-header {
    width: 100%;
    height: 54dp;
}

#shop-list-title {
    width: 100%;
}

#shop-mode-toggle {
    margin-top: 8dp;
    width: 100%;
    height: 26dp;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
}

#shop-mode-toggle.focused,
#shop-buy-list.focused,
#shop-sell-list.focused,
#shop-quantity-controls.focused {
    border: 1dp #fce97f66;
    background-color: #15212a99;
}

.shop-mode-button {
    width: 88dp;
    height: 26dp;
    line-height: 26dp;
}

.shop-mode-button.selected {
    color: #fce97fff;
    transform: translateY(-1dp);
}

.shop-empty-text {
    margin-top: 10dp;
    width: 100%;
    color: #d8e3e6ff;
}

#shop-buy-list,
#shop-sell-list {
    margin-top: 8dp;
    width: 100%;
    height: 150dp;
    overflow-y: auto;
}

.shop-buy-entry,
.shop-sell-entry {
    width: 100%;
    height: 48dp;
    margin-bottom: 8dp;
    padding: 8dp 10dp 8dp 10dp;
    text-align: left;
    display: flex;
    flex-direction: row;
    align-items: center;
}

.shop-buy-entry.selected,
.shop-sell-entry.selected {
    color: #fce97fff;
    transform: translateY(-1dp);
}

.shop-entry-icon {
    width: 28dp;
    height: 28dp;
}

.shop-entry-copy {
    margin-left: 8dp;
    width: 92dp;
    height: 32dp;
}

.shop-entry-name {
    width: 100%;
    height: 18dp;
    line-height: 18dp;
    color: #ffffffff;
}

.shop-entry-meta {
    margin-top: 2dp;
    width: 100%;
    height: 14dp;
    line-height: 14dp;
    color: #b9c9d0ff;
    font-size: 14dp;
}

.shop-entry-price {
    width: 56dp;
    height: 18dp;
    line-height: 18dp;
    text-align: right;
    color: #fce97fff;
}

#shop-gold-label {
    margin-top: 10dp;
    width: 100%;
    color: #ffffffff;
}

#shop-detail-card {
    margin-top: 8dp;
    width: 100%;
    height: 118dp;
    padding: 10dp 12dp 10dp 12dp;
    border: 1dp #7c91a8cc;
    background-color: #15212af0;
}

#shop-detail-name {
    width: 100%;
    height: 20dp;
    line-height: 20dp;
    color: #ffffffff;
}

#shop-detail-description {
    margin-top: 6dp;
    width: 100%;
    height: 36dp;
    color: #cdd8dcff;
}

.shop-detail-row {
    margin-top: 4dp;
    width: 100%;
    height: 16dp;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.shop-detail-label {
    width: 80dp;
    color: #9fb0baff;
}

#shop-detail-price,
#shop-detail-quantity,
#shop-detail-owned,
#shop-detail-total,
#shop-detail-after {
    width: 124dp;
    text-align: right;
    color: #ffffffff;
}

#shop-quantity-controls {
    margin-top: 10dp;
    width: 160dp;
    height: 32dp;
    display: flex;
    flex-direction: row;
    align-items: center;
}

#shop-quantity-readout {
    width: 80dp;
    height: 32dp;
    line-height: 32dp;
    text-align: center;
    color: #ffffffff;
}

.shop-qty-button {
    width: 32dp;
}

#shop-status {
    margin-top: 10dp;
    width: 100%;
    height: 34dp;
    color: #fff4b3ff;
}

#shop-actions {
    margin-top: 8dp;
    width: 100%;
    height: 32dp;
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
}

.shop-action-button {
    width: 96dp;
    margin-right: 10dp;
}

.shop-action-button.focused {
    color: #fce97fff;
    transform: translateY(-1dp);
}
