body, div, h1, h2, h3, h4, p, hr {
    display: block;
}

#shop-panel {
    left: 120dp;
    top: 78dp;
    width: 400dp;
    height: 168dp;
    padding: 20dp 22dp 18dp 22dp;
}

#shop-header {
    width: 100%;
    height: 28dp;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

#shop-title {
    width: 268dp;
    height: 24dp;
    line-height: 24dp;
    color: #ffffffff;
    font-effect: shadow(1dp 1dp #000000cc);
}

#shop-greeting {
    margin-top: 18dp;
    width: 100%;
    color: #f5edd8ff;
}

#shop-placeholder {
    margin-top: 16dp;
    width: 100%;
    color: #fff4b3ff;
}

#shop-hint {
    margin-top: 20dp;
    width: 100%;
    color: #c9d6d8ff;
}

.shop-menu-close {
    width: 96dp;
    tab-index: auto;
    nav-left: auto;
    nav-right: auto;
    nav-up: auto;
    nav-down: auto;
}
