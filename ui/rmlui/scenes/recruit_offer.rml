<rml>
<head>
    <link type="text/rcss" href="../theme/base.rcss"/>
    <link type="text/rcss" href="../theme/reset.rcss"/>
    <link type="text/rcss" href="../theme/modal.rcss"/>
    <link type="text/rcss" href="../theme/nav.rcss"/>
    <link type="text/rcss" href="../theme/spritesheet.rcss"/>
    <link type="text/rcss" href="../theme/portrait.rcss"/>
    <link type="text/rcss" href="../theme/menu_widgets.rcss"/>
    <link type="text/rcss" href="../theme/overlay_scene.rcss"/>
    <link type="text/rcss" href="recruit_offer.rcss"/>
</head>
<body class="tf-screen-root tf-nav-root" data-model="recruit_offer">
    <div id="recruit-offer-overlay" class="tf-modal-overlay"></div>

    <div id="recruit-offer-panel" class="tf-scene-panel">
        <div id="recruit-offer-speaker" class="tf-scene-title-gold">{{ speaker_text }}</div>

        <div id="recruit-offer-card" class="tf-scene-card-frame">
            <div id="recruit-offer-portrait"
                 data-class-portrait-player="portrait_player"
                 data-class-portrait-lyria="portrait_lyria"
                 data-class-portrait-tori="portrait_tori"></div>
            <div id="recruit-offer-copy">
                <div id="recruit-offer-name" class="tf-scene-title">{{ actor_name }}</div>
                <div id="recruit-offer-line" class="tf-scene-title">{{ offer_text }}</div>
            </div>
        </div>

        <div id="recruit-offer-actions">
            <button id="recruit-offer-accept-button"
                    class="tf-button-light recruit-offer-action-button"
                    data-event-click="accept"
                    data-i18n="recruit_offer.join">Join</button>
            <button id="recruit-offer-decline-button"
                    class="tf-button-light recruit-offer-action-button"
                    data-event-click="decline"
                    data-i18n="recruit_offer.not_now">Not now</button>
        </div>
    </div>
</body>
</rml>
