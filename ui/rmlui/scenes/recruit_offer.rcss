body, div, h1, h2, h3, h4, p, hr {
    display: block;
}

/* 几何 / 布局; 颜色与文字效果通过 RML 上的 tf-scene-* utility 提供。
   position: absolute 来自 .tf-scene-panel utility。 */

/* 覆盖默认 tf-modal-overlay (60% 黑) 为 Tokyo Night 暗蓝 75%, 与 Inventory 一致,
   让世界 dusk 色调不再渗透到面板边缘。 */
#recruit-offer-overlay {
    background-color: #1a1b26c0;
}

#recruit-offer-panel {
    left: 128dp;
    top: 58dp;
    width: 352dp;
    height: 214dp;
    padding: 16dp;
}

#recruit-offer-speaker {
    width: 100%;
    height: 18dp;
    line-height: 18dp;
}

#recruit-offer-card {
    margin-top: 10dp;
    width: 320dp;
    height: 100dp;
    padding: 10dp;
    display: flex;
    flex-direction: row;
}

#recruit-offer-portrait {
    width: 64dp;
    height: 64dp;
    decorator: image(portrait-player);
}

#recruit-offer-portrait.portrait-player {
    decorator: image(portrait-player);
}

#recruit-offer-portrait.portrait-lyria {
    decorator: image(portrait-lyria);
}

#recruit-offer-portrait.portrait-tori {
    decorator: image(portrait-tori);
}

#recruit-offer-copy {
    margin-left: 12dp;
    width: 222dp;
}

#recruit-offer-name {
    width: 100%;
    height: 22dp;
    line-height: 22dp;
}

#recruit-offer-line {
    margin-top: 8dp;
    width: 100%;
    height: 42dp;
    line-height: 18dp;
}

#recruit-offer-actions {
    margin-top: 18dp;
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 12dp;
}

.recruit-offer-action-button {
    width: 116dp;
}
