body, div, h1, h2, h3, h4, p, hr {
    display: block;
}

#battle-hud {
    position: absolute;
    left: 0;
    top: 256dp;
    width: 640dp;
    height: 104dp;
    background-color: #101722f2;
    border-width: 1dp 0 0 0;
    border-color: #4d6077ff;
}

#battle-top-status {
    position: absolute;
    left: 318dp;
    top: 6dp;
    width: 314dp;
    height: 34dp;
}

#battle-turn-order-bar {
    position: absolute;
    left: 6dp;
    top: 6dp;
    width: 304dp;
    height: 34dp;
    display: flex;
    flex-direction: row;
    gap: 3dp;
    overflow: hidden;
}

.battle-turn-order-entry {
    position: relative;
    width: 30dp;
    height: 30dp;
    padding: 0;
    background-color: #00000000;
    border-width: 0dp;
    border-color: #00000000;
}

.battle-turn-order-entry.acted-turn-entry {
    color: #8993a5ff;
}

.battle-turn-order-entry.ko-turn-entry {
    color: #5f6672ff;
}

.battle-turn-order-entry.current-turn-entry {
    margin-top: -2dp;
}

.battle-turn-order-portrait {
    width: 28dp;
    height: 28dp;
    background-color: #0d1320ee;
    border-width: 1dp;
    border-color: #2d3a4fff;
    decorator: none;
    overflow: hidden;
    image-color: #ffffffff;
}

.battle-turn-order-entry.enemy-turn-entry .battle-turn-order-portrait {
    background-color: #1f1420ee;
    border-color: #533948ff;
}

.battle-turn-order-entry.current-turn-entry .battle-turn-order-portrait {
    border-color: #fce97fff;
}

.battle-turn-order-entry.acted-turn-entry .battle-turn-order-portrait,
.battle-turn-order-entry.ko-turn-entry .battle-turn-order-portrait {
    border-color: #2c3440ff;
}

.battle-turn-order-entry.acted-turn-entry .battle-turn-order-portrait {
    image-color: #ffffff77;
}

.battle-turn-order-entry.ko-turn-entry .battle-turn-order-portrait {
    image-color: #ffffff44;
}

.battle-turn-order-label {
    display: block;
    width: 26dp;
    height: 26dp;
    line-height: 26dp;
    color: #ffffffff;
    font-size: 9dp;
    text-align: center;
    font-effect: shadow(1dp 1dp #000000cc);
}

.battle-turn-order-entry.enemy-turn-entry .battle-turn-order-label {
    color: #ffc2d5ff;
}

.battle-turn-order-entry.acted-turn-entry .battle-turn-order-label,
.battle-turn-order-entry.ko-turn-entry .battle-turn-order-label {
    color: #747d8dff;
}

.battle-turn-order-badge {
    position: absolute;
    left: 20dp;
    top: 20dp;
    width: 9dp;
    height: 9dp;
    line-height: 9dp;
    color: #ffffffff;
    background-color: #05070bcc;
    border-width: 1dp;
    border-color: #f4d475ee;
    font-size: 6dp;
    text-align: center;
    font-effect: shadow(1dp 1dp #000000dd);
}

.battle-turn-order-entry.acted-turn-entry .battle-turn-order-badge {
    color: #c5cbd7dd;
    border-color: #77808ccc;
    background-color: #05070baa;
}

.battle-turn-order-entry.ko-turn-entry .battle-turn-order-badge {
    color: #7d8491cc;
    border-color: #444b56bb;
    background-color: #05070b88;
}

#battle-party-panel {
    position: absolute;
    left: 6dp;
    top: 6dp;
    width: 452dp;
    height: 92dp;
    display: flex;
    flex-direction: row;
    gap: 4dp;
}

.battle-party-card {
    position: relative;
    width: 110dp;
    height: 92dp;
    padding: 4dp;
    background-color: #182333ee;
    border-width: 1dp;
    border-color: #405067ff;
}

.battle-party-card.active-party-member {
    border-color: #fce97fff;
    background-color: #21314aee;
}

.battle-party-card.ko-party-member {
    color: #777f8fff;
    background-color: #171a20ee;
    border-color: #303844ff;
}

.battle-party-main {
    display: flex;
    flex-direction: row;
    gap: 4dp;
    width: 100dp;
    height: 82dp;
}

.battle-party-identity {
    width: 36dp;
    height: 82dp;
}

.battle-portrait {
    width: 36dp;
    height: 36dp;
    margin-top: 4dp;
    background-color: #0d1320ff;
    border-width: 1dp;
    border-color: #2d3a4fff;
    decorator: none;
}

.battle-party-stats {
    width: 60dp;
    height: 82dp;
}

.battle-party-name {
    width: 36dp;
    height: 14dp;
    line-height: 14dp;
    color: #ffffffff;
    text-align: center;
    font-effect: shadow(1dp 1dp #000000cc);
    overflow: hidden;
}

.battle-stat-label {
    width: 60dp;
    height: 11dp;
    line-height: 11dp;
    color: #d8dee9ff;
    font-size: 8dp;
    overflow: hidden;
}

.battle-stat-kind,
.battle-stat-value {
    display: inline-block;
    height: 11dp;
    line-height: 11dp;
}

.battle-stat-kind {
    width: 13dp;
    color: #abb6c9ff;
}

.battle-stat-value {
    width: 47dp;
    font-size: 7dp;
    text-align: right;
}

.battle-hp-label {
    margin-top: 8dp;
}

.battle-mp-label {
    margin-top: 7dp;
}

.battle-stat-bar {
    width: 60dp;
    height: 6dp;
    background-color: #090c12ff;
    border-width: 1dp;
    border-color: #293241ff;
}

.battle-stat-fill {
    height: 4dp;
}

.battle-state-icon-row {
    width: 60dp;
    height: 12dp;
    margin-top: 5dp;
    display: flex;
    flex-direction: row;
    gap: 2dp;
    overflow: hidden;
}

.battle-party-card.ko-party-member .battle-state-icon-row {
    display: none;
}

.battle-state-icon {
    position: relative;
    width: 11dp;
    height: 11dp;
}

.battle-state-icon-image {
    width: 9dp;
    height: 9dp;
    background-color: #0b1019ee;
    border-width: 1dp;
    border-color: #56657aff;
    decorator: none;
    image-color: #ffffffff;
    overflow: hidden;
}

.battle-state-icon.unknown-state-icon .battle-state-icon-image {
    border-color: #69717dcc;
    image-color: #ffffffaa;
}

.tf-input-mouse .battle-state-icon:hover .battle-state-icon-image {
    border-color: #fce97fff;
}

.battle-state-icon-label {
    display: block;
    width: 7dp;
    height: 7dp;
    line-height: 7dp;
    color: #ffffffff;
    font-size: 6dp;
    text-align: center;
    font-effect: shadow(1dp 1dp #000000cc);
}

.battle-state-turns {
    position: absolute;
    left: 5dp;
    top: 5dp;
    width: 6dp;
    height: 6dp;
    line-height: 6dp;
    color: #ffffffff;
    background-color: #05070bcc;
    border-width: 1dp;
    border-color: #f4d475ee;
    font-size: 5dp;
    text-align: center;
    font-effect: shadow(1dp 1dp #000000dd);
}

.battle-state-tooltip {
    position: absolute;
    left: 0;
    top: -48dp;
    width: 110dp;
    min-height: 42dp;
    padding: 4dp;
    background-color: #0d1320f6;
    border-width: 1dp;
    border-color: #697b95ff;
    color: #ffffffff;
}

.battle-state-tooltip-title,
.battle-state-tooltip-turns,
.battle-state-tooltip-description {
    width: 100dp;
    font-effect: shadow(1dp 1dp #000000cc);
    overflow: hidden;
}

.battle-state-tooltip-title {
    height: 11dp;
    line-height: 11dp;
    color: #fce97fff;
    font-size: 8dp;
}

.battle-state-tooltip-turns {
    height: 9dp;
    line-height: 9dp;
    color: #abb6c9ff;
    font-size: 7dp;
}

.battle-state-tooltip-description {
    min-height: 12dp;
    line-height: 9dp;
    color: #d8dee9ff;
    font-size: 7dp;
    white-space: normal;
    word-break: break-word;
}

.battle-hp-fill {
    background-color: #cf4354ff;
}

.battle-mp-fill {
    background-color: #4b85d9ff;
}

#battle-command-panel {
    position: absolute;
    left: 464dp;
    top: 6dp;
    width: 168dp;
    height: 92dp;
}

#battle-turn,
#battle-result,
#battle-back-hint,
#battle-list-empty,
#battle-target-empty {
    color: #ffffffff;
    font-effect: shadow(1dp 1dp #000000cc);
    pointer-events: none;
}

#battle-turn {
    width: 314dp;
    height: 16dp;
    line-height: 16dp;
    text-align: right;
    overflow: hidden;
}

#battle-result {
    width: 314dp;
    height: 16dp;
    line-height: 16dp;
    text-align: right;
    white-space: normal;
    word-break: break-word;
    overflow: hidden;
    color: #d8dee9ff;
}

#battle-actions {
    position: relative;
    width: 168dp;
    height: 92dp;
}

#battle-main-actions,
#battle-list-menu,
#battle-target-menu {
    position: absolute;
    left: 0;
    top: 0;
    width: 168dp;
}

#battle-main-actions {
    height: 62dp;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 4dp;
}

.battle-text-button {
    background-color: #151d29ff;
    border-width: 1dp;
    border-color: #56657aff;
    color: #ffffffff;
    text-align: center;
    font-effect: shadow(1dp 1dp #000000aa);
}

.battle-action-button {
    width: 82dp;
    height: 18dp;
    line-height: 16dp;
}

#battle-list-menu,
#battle-target-menu {
    height: 72dp;
    display: flex;
    flex-direction: column;
    gap: 3dp;
}

.battle-list-entry,
.battle-target-entry {
    width: 168dp;
    height: 18dp;
    line-height: 16dp;
    text-align: left;
    padding-left: 5dp;
    padding-right: 5dp;
}

.battle-entry-label,
.battle-entry-sublabel {
    display: inline-block;
    line-height: 16dp;
}

.battle-entry-label {
    width: 82dp;
}

.battle-entry-sublabel {
    width: 70dp;
    color: #abb6c9ff;
    text-align: right;
}

.tf-input-mouse .battle-text-button:hover,
.tf-input-nav .battle-text-button:focus {
    background-color: #223047ff;
    border-color: #fce97fff;
    color: #fce97fff;
}

.tf-input-mouse .battle-text-button:hover:active,
.tf-input-nav .battle-text-button:focus:active,
.battle-text-button:active {
    background-color: #101722ff;
    color: #c7d8f4ff;
}

.battle-list-entry.disabled,
.battle-target-entry.disabled,
.battle-list-entry:disabled,
.battle-target-entry:disabled,
.battle-action-button.disabled,
.battle-action-button:disabled {
    color: #6e7480ff;
    background-color: #111820ff;
    border-color: #2d3540ff;
}

.battle-list-entry.disabled .battle-entry-sublabel,
.battle-list-entry:disabled .battle-entry-sublabel {
    color: #6e7480ff;
}

.tf-input-mouse .battle-text-button.disabled:hover,
.tf-input-nav .battle-text-button.disabled:focus,
.tf-input-mouse .battle-text-button:disabled:hover,
.tf-input-nav .battle-text-button:disabled:focus {
    background-color: #111820ff;
    border-color: #2d3540ff;
    color: #6e7480ff;
}

.battle-target-entry.is-ally {
    color: #8db8ffff;
}

.battle-target-entry.is-dead {
    color: #6e7480ff;
}

#battle-back-hint {
    position: absolute;
    left: 0;
    top: 76dp;
    width: 168dp;
    height: 14dp;
    line-height: 14dp;
    color: #abb6c9ff;
}

#battle-list-empty,
#battle-target-empty {
    width: 168dp;
    height: 18dp;
    line-height: 16dp;
    color: #abb6c9ff;
    text-align: center;
}
