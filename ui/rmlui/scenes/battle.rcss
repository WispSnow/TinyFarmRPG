body, div, h1, h2, h3, h4, p, hr {
    display: block;
}

#battle-hud {
    position: absolute;
    left: 0;
    top: 256dp;
    width: 640dp;
    height: 104dp;
    background-color: #101722f2;
    border-width: 1dp 0 0 0;
    border-color: #4d6077ff;
}

#battle-top-status {
    position: absolute;
    left: 318dp;
    top: 6dp;
    width: 314dp;
    height: 34dp;
}

#battle-log-panel {
    position: absolute;
    left: 318dp;
    top: 42dp;
    width: 314dp;
    height: 45dp;
    padding: 0;
    background-color: #00000000;
    border-width: 0dp;
    border-color: #00000000;
    overflow: hidden;
    pointer-events: none;
}

#battle-victory-overlay {
    position: absolute;
    left: 0;
    top: 0;
    width: 640dp;
    height: 256dp;
    background-color: #03070fcc;
}

#battle-victory-panel {
    position: absolute;
    left: 170dp;
    top: 34dp;
    width: 300dp;
    height: 178dp;
    padding: 10dp;
    background-color: #111822f2;
    border-width: 1dp;
    border-color: #f0d77eff;
}

#battle-victory-title {
    width: 280dp;
    height: 34dp;
    line-height: 34dp;
    color: #fff2a6ff;
    font-size: 24dp;
    text-align: center;
    font-effect: shadow(1dp 1dp #000000dd);
}

#battle-victory-rewards {
    width: 280dp;
    height: 88dp;
    margin-top: 6dp;
}

.battle-victory-row {
    width: 280dp;
    height: 20dp;
    display: flex;
    flex-direction: row;
    background-color: #1a2535ee;
    border-width: 1dp;
    border-color: #46546aff;
}

.battle-victory-label {
    width: 148dp;
    height: 18dp;
    line-height: 18dp;
    padding-left: 6dp;
    color: #d8dee9ff;
    font-size: 10dp;
}

.battle-victory-value {
    width: 116dp;
    height: 18dp;
    line-height: 18dp;
    padding-right: 6dp;
    color: #fce97fff;
    font-size: 10dp;
    text-align: right;
}

#battle-victory-item-list {
    width: 280dp;
    height: 62dp;
    margin-top: 4dp;
    overflow: hidden;
}

.battle-victory-empty {
    width: 280dp;
    height: 20dp;
    line-height: 20dp;
    color: #8b95a7ff;
    font-size: 9dp;
    text-align: center;
}

.battle-victory-item {
    width: 280dp;
    height: 20dp;
    display: flex;
    flex-direction: row;
    margin-bottom: 1dp;
    background-color: #101722cc;
}

.battle-victory-item-icon {
    width: 18dp;
    height: 18dp;
    margin-left: 2dp;
    decorator: none;
}

.battle-victory-item-label {
    width: 194dp;
    height: 20dp;
    line-height: 20dp;
    padding-left: 5dp;
    color: #e8eef8ff;
    font-size: 9dp;
    overflow: hidden;
}

.battle-victory-item-count {
    width: 52dp;
    height: 20dp;
    line-height: 20dp;
    padding-right: 6dp;
    color: #fce97fff;
    font-size: 9dp;
    text-align: right;
}

#battle-victory-continue {
    width: 108dp;
    height: 24dp;
    line-height: 22dp;
    margin-left: 86dp;
    margin-top: 8dp;
    padding: 0;
    text-align: center;
    background-color: #151d29ff;
    border-width: 1dp;
    border-color: #56657aff;
    color: #ffffffff;
    tab-index: auto;
    nav-up: auto;
    nav-down: auto;
    nav-left: auto;
    nav-right: auto;
}

.tf-input-mouse #battle-victory-continue:hover,
.tf-input-nav #battle-victory-continue:focus {
    background-color: #223047ff;
    border-color: #fce97fff;
    color: #fce97fff;
}

.tf-input-mouse #battle-victory-continue:hover:active,
.tf-input-nav #battle-victory-continue:focus:active,
#battle-victory-continue:active {
    background-color: #101722ff;
    color: #c7d8f4ff;
}

#battle-victory-continue.disabled {
    color: #7e8796ff;
    border-color: #394454ff;
    background-color: #161e2add;
}

.tf-input-mouse #battle-victory-continue.disabled:hover,
.tf-input-nav #battle-victory-continue.disabled:focus {
    background-color: #161e2add;
    border-color: #394454ff;
    color: #7e8796ff;
}

.battle-log-entry {
    width: 314dp;
    height: 15dp;
    line-height: 15dp;
    color: #d8dee9ff;
    font-size: 8dp;
    text-align: right;
    font-effect: shadow(1dp 1dp #000000cc);
    overflow: hidden;
    white-space: nowrap;
}

.battle-log-entry.log-damage {
    color: #ff9a9aff;
}

.battle-log-entry.log-recovery {
    color: #93e0a5ff;
}

.battle-log-entry.log-state {
    color: #d7bcffff;
}

.battle-log-entry.log-system {
    color: #fce97fff;
}

.battle-log-entry.log-error {
    color: #ff7373ff;
}

#battle-turn-order-bar {
    position: absolute;
    left: 6dp;
    top: 6dp;
    width: 304dp;
    height: 34dp;
    display: flex;
    flex-direction: row;
    gap: 3dp;
    overflow: hidden;
}

.battle-turn-order-entry {
    position: relative;
    width: 30dp;
    height: 30dp;
    padding: 0;
    background-color: #00000000;
    border-width: 0dp;
    border-color: #00000000;
}

.battle-turn-order-entry.acted-turn-entry {
    color: #8993a5ff;
}

.battle-turn-order-entry.ko-turn-entry {
    color: #5f6672ff;
}

.battle-turn-order-entry.current-turn-entry {
    margin-top: -2dp;
}

.battle-turn-order-portrait {
    width: 28dp;
    height: 28dp;
    background-color: #0d1320ee;
    border-width: 1dp;
    border-color: #2d3a4fff;
    decorator: none;
    overflow: hidden;
    image-color: #ffffffff;
}

.battle-turn-order-entry.enemy-turn-entry .battle-turn-order-portrait {
    background-color: #1f1420ee;
    border-color: #533948ff;
}

.battle-turn-order-entry.current-turn-entry .battle-turn-order-portrait {
    border-color: #fce97fff;
}

.battle-turn-order-entry.acted-turn-entry .battle-turn-order-portrait,
.battle-turn-order-entry.ko-turn-entry .battle-turn-order-portrait {
    border-color: #2c3440ff;
}

.battle-turn-order-entry.acted-turn-entry .battle-turn-order-portrait {
    image-color: #ffffff77;
}

.battle-turn-order-entry.ko-turn-entry .battle-turn-order-portrait {
    image-color: #ffffff44;
}

.battle-turn-order-label {
    display: block;
    width: 26dp;
    height: 26dp;
    line-height: 26dp;
    color: #ffffffff;
    font-size: 9dp;
    text-align: center;
    font-effect: shadow(1dp 1dp #000000cc);
}

.battle-turn-order-entry.enemy-turn-entry .battle-turn-order-label {
    color: #ffc2d5ff;
}

.battle-turn-order-entry.acted-turn-entry .battle-turn-order-label,
.battle-turn-order-entry.ko-turn-entry .battle-turn-order-label {
    color: #747d8dff;
}

.battle-turn-order-badge {
    position: absolute;
    left: 20dp;
    top: 20dp;
    width: 9dp;
    height: 9dp;
    line-height: 9dp;
    color: #ffffffff;
    background-color: #05070bcc;
    border-width: 1dp;
    border-color: #f4d475ee;
    font-size: 6dp;
    text-align: center;
    font-effect: shadow(1dp 1dp #000000dd);
}

.battle-turn-order-entry.acted-turn-entry .battle-turn-order-badge {
    color: #c5cbd7dd;
    border-color: #77808ccc;
    background-color: #05070baa;
}

.battle-turn-order-entry.ko-turn-entry .battle-turn-order-badge {
    color: #7d8491cc;
    border-color: #444b56bb;
    background-color: #05070b88;
}

#battle-party-panel {
    position: absolute;
    left: 4dp;
    top: 4dp;
    width: 508dp;
    height: 88dp;
    display: flex;
    flex-direction: row;
    gap: 4dp;
}

.battle-party-card {
    position: relative;
    box-sizing: border-box;
    width: 124dp;
    height: 88dp;
    padding: 4dp;
    background-color: #182333ee;
    border-width: 1dp;
    border-color: #405067ff;
}

.battle-party-card.active-party-member {
    border-color: #fce97fff;
    background-color: #21314aee;
}

.battle-party-card.ko-party-member {
    color: #777f8fff;
    background-color: #171a20ee;
    border-color: #303844ff;
}

.battle-party-main {
    display: flex;
    flex-direction: row;
    gap: 4dp;
    width: 114dp;
    height: 78dp;
}

.battle-party-identity {
    width: 36dp;
    height: 78dp;
}

.battle-portrait {
    width: 36dp;
    height: 36dp;
    margin-top: 4dp;
    background-color: #0d1320ff;
    border-width: 1dp;
    border-color: #2d3a4fff;
    decorator: none;
}

.battle-party-stats {
    width: 74dp;
    height: 78dp;
}

.battle-party-name {
    width: 36dp;
    height: 14dp;
    line-height: 14dp;
    color: #ffffffff;
    text-align: center;
    font-effect: shadow(1dp 1dp #000000cc);
    overflow: hidden;
}

.battle-stat-label {
    width: 74dp;
    height: 11dp;
    line-height: 11dp;
    color: #d8dee9ff;
    font-size: 8dp;
    overflow: hidden;
}

.battle-stat-kind,
.battle-stat-value {
    display: inline-block;
    height: 11dp;
    line-height: 11dp;
}

.battle-stat-kind {
    width: 13dp;
    color: #abb6c9ff;
}

.battle-stat-value {
    width: 61dp;
    font-size: 7dp;
    text-align: right;
}

.battle-hp-label {
    margin-top: 8dp;
}

.battle-mp-label {
    margin-top: 7dp;
}

.battle-stat-bar {
    width: 74dp;
    height: 6dp;
    background-color: #090c12ff;
    border-width: 1dp;
    border-color: #293241ff;
}

.battle-stat-fill {
    height: 4dp;
}

.battle-state-icon-row {
    width: 74dp;
    height: 12dp;
    margin-top: 5dp;
    display: flex;
    flex-direction: row;
    gap: 2dp;
    overflow: hidden;
}

.battle-party-card.ko-party-member .battle-state-icon-row {
    display: none;
}

.battle-state-icon {
    position: relative;
    width: 11dp;
    height: 11dp;
}

.battle-state-icon-image {
    width: 9dp;
    height: 9dp;
    background-color: #0b1019ee;
    border-width: 1dp;
    border-color: #56657aff;
    decorator: none;
    image-color: #ffffffff;
    overflow: hidden;
}

.battle-state-icon.unknown-state-icon .battle-state-icon-image {
    border-color: #69717dcc;
    image-color: #ffffffaa;
}

.tf-input-mouse .battle-state-icon:hover .battle-state-icon-image {
    border-color: #fce97fff;
}

.battle-state-icon-label {
    display: block;
    width: 7dp;
    height: 7dp;
    line-height: 7dp;
    color: #ffffffff;
    font-size: 6dp;
    text-align: center;
    font-effect: shadow(1dp 1dp #000000cc);
}

.battle-state-turns {
    position: absolute;
    left: 5dp;
    top: 5dp;
    width: 6dp;
    height: 6dp;
    line-height: 6dp;
    color: #ffffffff;
    background-color: #05070bcc;
    border-width: 1dp;
    border-color: #f4d475ee;
    font-size: 5dp;
    text-align: center;
    font-effect: shadow(1dp 1dp #000000dd);
}

.battle-state-tooltip {
    position: absolute;
    box-sizing: border-box;
    left: 0;
    top: -48dp;
    width: 124dp;
    min-height: 42dp;
    padding: 4dp;
    background-color: #0d1320f6;
    border-width: 1dp;
    border-color: #697b95ff;
    color: #ffffffff;
}

.battle-state-tooltip-title,
.battle-state-tooltip-turns,
.battle-state-tooltip-description {
    width: 114dp;
    font-effect: shadow(1dp 1dp #000000cc);
    overflow: hidden;
}

.battle-state-tooltip-title {
    height: 11dp;
    line-height: 11dp;
    color: #fce97fff;
    font-size: 8dp;
}

.battle-state-tooltip-turns {
    height: 9dp;
    line-height: 9dp;
    color: #abb6c9ff;
    font-size: 7dp;
}

.battle-state-tooltip-description {
    min-height: 12dp;
    line-height: 9dp;
    color: #d8dee9ff;
    font-size: 7dp;
    white-space: normal;
    word-break: break-word;
}

.battle-hp-fill {
    background-color: #cf4354ff;
}

.battle-mp-fill {
    background-color: #4b85d9ff;
}

#battle-command-panel {
    position: absolute;
    box-sizing: border-box;
    left: 516dp;
    top: 4dp;
    width: 120dp;
    height: 88dp;
    padding: 3dp 5dp;
    background-color: #182333ee;
    border-width: 1dp;
    border-color: #405067ff;
}

#battle-turn,
#battle-result,
#battle-list-empty,
#battle-target-empty {
    color: #ffffffff;
    font-effect: shadow(1dp 1dp #000000cc);
    pointer-events: none;
}

#battle-turn {
    width: 314dp;
    height: 16dp;
    line-height: 16dp;
    text-align: right;
    overflow: hidden;
}

#battle-result {
    width: 314dp;
    height: 16dp;
    line-height: 16dp;
    text-align: right;
    white-space: normal;
    word-break: break-word;
    overflow: hidden;
    color: #d8dee9ff;
}

#battle-actions {
    position: relative;
    width: 108dp;
    height: 80dp;
}

#battle-party-command,
#battle-actor-command,
#battle-list-menu,
#battle-target-menu {
    position: absolute;
    left: 0;
    top: 0;
    width: 108dp;
}

#battle-party-command,
#battle-actor-command {
    height: 80dp;
    display: flex;
    flex-direction: column;
    gap: 2dp;
}

#battle-list-menu,
#battle-target-menu {
    height: 80dp;
    display: flex;
    flex-direction: column;
    gap: 2dp;
    overflow-y: auto;
    overflow-x: hidden;
}

#battle-list-menu scrollbarvertical,
#battle-target-menu scrollbarvertical {
    width: 4dp;
    scrollbar-margin: 0dp;
}

#battle-list-menu scrollbarvertical slidertrack,
#battle-target-menu scrollbarvertical slidertrack {
    background-color: #0b1019aa;
    border-width: 0dp;
    border-color: #00000000;
}

#battle-list-menu scrollbarvertical sliderbar,
#battle-target-menu scrollbarvertical sliderbar {
    background-color: #697b95dd;
    border-width: 0dp;
    border-color: #00000000;
}

.battle-text-button {
    box-sizing: border-box;
    background-color: transparent;
    border-width: 0;
    color: #d8dee9ff;
    text-align: left;
    padding-left: 4dp;
    padding-right: 4dp;
    font-effect: shadow(1dp 1dp #000000aa);
    transition: background-color color 0.1s cubic-out;
}

.battle-party-command-button,
.battle-actor-command-button {
    width: 108dp;
    height: 18dp;
    line-height: 18dp;
}

.battle-list-entry,
.battle-target-entry {
    width: 100%;
    height: 16dp;
    line-height: 16dp;
    padding-left: 4dp;
    padding-right: 4dp;
    font-size: 10dp;
    white-space: nowrap;
    overflow: hidden;
    flex-shrink: 0;
}

.battle-entry-label,
.battle-entry-sublabel {
    display: inline-block;
    height: 16dp;
    line-height: 16dp;
    vertical-align: top;
    white-space: nowrap;
    overflow: hidden;
}

.battle-entry-label {
    width: 50dp;
}

.battle-entry-sublabel {
    width: 40dp;
    color: #abb6c9ff;
    text-align: right;
}

.battle-cursor {
    display: inline-block;
    vertical-align: top;
    color: #fce97fff;
    margin-right: 3dp;
    opacity: 0;
}

@keyframes battle-cursor-blink {
    from { opacity: 1; }
    50%  { opacity: 0.35; }
    to   { opacity: 1; }
}

.tf-input-mouse .battle-text-button:hover,
.tf-input-nav .battle-text-button:focus {
    background-color: #2c3b58ff;
    color: #fce97fff;
}

.tf-input-mouse .battle-text-button:hover .battle-cursor,
.tf-input-nav .battle-text-button:focus .battle-cursor {
    opacity: 1;
    animation: 0.8s linear infinite battle-cursor-blink;
}

.tf-input-mouse .battle-text-button:hover:active,
.tf-input-nav .battle-text-button:focus:active,
.battle-text-button:active {
    background-color: #1d2940ff;
    color: #ffffffff;
}

.battle-list-entry.disabled,
.battle-target-entry.disabled,
.battle-list-entry:disabled,
.battle-target-entry:disabled,
.battle-party-command-button.disabled,
.battle-party-command-button:disabled,
.battle-actor-command-button.disabled,
.battle-actor-command-button:disabled {
    color: #6e7480ff;
    background-color: transparent;
}

.battle-list-entry.disabled .battle-entry-sublabel,
.battle-list-entry:disabled .battle-entry-sublabel {
    color: #6e7480ff;
}

.tf-input-mouse .battle-text-button.disabled:hover,
.tf-input-nav .battle-text-button.disabled:focus,
.tf-input-mouse .battle-text-button:disabled:hover,
.tf-input-nav .battle-text-button:disabled:focus {
    background-color: transparent;
    color: #6e7480ff;
}

.tf-input-mouse .battle-text-button.disabled:hover .battle-cursor,
.tf-input-nav .battle-text-button.disabled:focus .battle-cursor,
.tf-input-mouse .battle-text-button:disabled:hover .battle-cursor,
.tf-input-nav .battle-text-button:disabled:focus .battle-cursor {
    opacity: 0;
    animation: none;
}

.battle-target-entry.is-ally {
    color: #8db8ffff;
}

.battle-target-entry.is-dead {
    color: #6e7480ff;
}

#battle-list-empty,
#battle-target-empty {
    width: 108dp;
    height: 18dp;
    line-height: 18dp;
    color: #abb6c9ff;
    text-align: center;
}
