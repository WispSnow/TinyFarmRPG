#battle-panel {
    left: 40dp;
    top: 20dp;
    width: 560dp;
    height: 320dp;
}

#battle-content {
    position: absolute;
    left: 20dp;
    top: 20dp;
    width: 520dp;
    height: 280dp;
}

#battle-title,
#battle-turn,
#battle-units,
#battle-result {
    position: absolute;
    left: 0;
    width: 520dp;
    line-height: 16dp;
    color: #ffffffff;
    font-effect: shadow(1dp 1dp #000000cc);
    pointer-events: none;
}

#battle-title {
    top: 0;
    height: 16dp;
    text-align: center;
    color: #fce97fff;
}

#battle-turn {
    top: 42dp;
}

#battle-units {
    top: 78dp;
    height: 32dp;
    white-space: normal;
    word-break: break-word;
    overflow: hidden;
}

#battle-result {
    top: 118dp;
    height: 48dp;
    white-space: normal;
    word-break: break-word;
    overflow: hidden;
}

#battle-actions {
    position: absolute;
    left: 0;
    top: 170dp;
    width: 520dp;
    height: 110dp;
}

#battle-menu-title,
#battle-menu-hint,
#battle-back-hint,
#battle-list-empty,
#battle-target-empty {
    color: #ffffffff;
    font-effect: shadow(1dp 1dp #000000cc);
    pointer-events: none;
}

#battle-menu-title {
    position: absolute;
    left: 0;
    top: 0;
    width: 120dp;
    height: 16dp;
    line-height: 16dp;
}

#battle-menu-hint {
    position: absolute;
    left: 132dp;
    top: 0;
    width: 388dp;
    height: 16dp;
    line-height: 16dp;
    color: #d8dee9ff;
}

#battle-back-hint {
    position: absolute;
    left: 0;
    top: 92dp;
    width: 520dp;
    height: 16dp;
    line-height: 16dp;
    color: #a9b1d6ff;
}

#battle-main-actions,
#battle-list-menu,
#battle-target-menu {
    position: absolute;
    left: 0;
    top: 24dp;
    width: 520dp;
    height: 62dp;
}

#battle-main-actions {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8dp;
}

.battle-action-button {
    width: 168dp;
    height: 28dp;
    line-height: 28dp;
}

#battle-list-menu,
#battle-target-menu {
    display: flex;
    flex-direction: column;
    gap: 4dp;
}

.battle-list-entry,
.battle-target-entry {
    width: 520dp;
    height: 28dp;
    line-height: 28dp;
    text-align: left;
    padding-left: 8dp;
    padding-right: 8dp;
}

.battle-entry-label,
.battle-entry-sublabel {
    display: inline-block;
    line-height: 28dp;
}

.battle-entry-label {
    width: 260dp;
}

.battle-entry-sublabel {
    width: 220dp;
    color: #a9b1d6ff;
    text-align: right;
}

.battle-list-entry.disabled,
.battle-list-entry:disabled {
    color: #666666ff;
}

.battle-list-entry.disabled .battle-entry-sublabel,
.battle-list-entry:disabled .battle-entry-sublabel {
    color: #666666ff;
}

.tf-input-mouse .battle-list-entry.disabled:hover,
.tf-input-nav .battle-list-entry.disabled:focus,
.tf-input-mouse .battle-list-entry:disabled:hover,
.tf-input-nav .battle-list-entry:disabled:focus {
    color: #666666ff;
    transform: translateY(0);
}

.battle-target-entry.is-ally {
    color: #8db8ffff;
}

.battle-target-entry.is-dead,
.battle-target-entry.disabled,
.battle-target-entry:disabled {
    color: #666666ff;
}

.tf-input-mouse .battle-target-entry.is-dead:hover,
.tf-input-nav .battle-target-entry.is-dead:focus,
.tf-input-mouse .battle-target-entry.disabled:hover,
.tf-input-nav .battle-target-entry.disabled:focus,
.tf-input-mouse .battle-target-entry:disabled:hover,
.tf-input-nav .battle-target-entry:disabled:focus {
    color: #666666ff;
    transform: translateY(0);
}

#battle-list-empty,
#battle-target-empty {
    width: 520dp;
    height: 28dp;
    line-height: 28dp;
    color: #a9b1d6ff;
    text-align: center;
}
