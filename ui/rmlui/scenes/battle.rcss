body, div, h1, h2, h3, h4, p, hr {
    display: block;
}

#battle-hud {
    position: absolute;
    left: 0;
    top: 230dp;
    width: 640dp;
    height: 130dp;
    background-color: #101722f2;
    border-width: 1dp 0 0 0;
    border-color: #4d6077ff;
}

#battle-party-panel {
    position: absolute;
    left: 8dp;
    top: 8dp;
    width: 432dp;
    height: 114dp;
    display: flex;
    flex-direction: row;
    gap: 4dp;
}

.battle-party-card {
    width: 102dp;
    height: 114dp;
    padding: 4dp;
    background-color: #182333ee;
    border-width: 1dp;
    border-color: #405067ff;
}

.battle-party-card.active-party-member {
    border-color: #fce97fff;
    background-color: #21314aee;
}

.battle-party-card.ko-party-member {
    color: #777f8fff;
    background-color: #171a20ee;
    border-color: #303844ff;
}

.battle-party-main {
    display: flex;
    flex-direction: row;
    gap: 4dp;
    width: 92dp;
    height: 104dp;
}

.battle-portrait {
    width: 32dp;
    height: 32dp;
    margin-top: 2dp;
    background-color: #0d1320ff;
    border-width: 1dp;
    border-color: #2d3a4fff;
    decorator: none;
}

.battle-party-stats {
    width: 56dp;
    height: 104dp;
}

.battle-party-name {
    width: 56dp;
    height: 15dp;
    line-height: 15dp;
    color: #ffffffff;
    font-effect: shadow(1dp 1dp #000000cc);
    overflow: hidden;
}

.battle-stat-label {
    width: 56dp;
    height: 12dp;
    line-height: 12dp;
    margin-top: 3dp;
    color: #d8dee9ff;
    font-size: 9dp;
    overflow: hidden;
}

.battle-stat-bar {
    width: 56dp;
    height: 7dp;
    background-color: #090c12ff;
    border-width: 1dp;
    border-color: #293241ff;
}

.battle-stat-fill {
    height: 5dp;
}

.battle-hp-fill {
    background-color: #cf4354ff;
}

.battle-mp-fill {
    background-color: #4b85d9ff;
}

#battle-command-panel {
    position: absolute;
    left: 448dp;
    top: 8dp;
    width: 184dp;
    height: 114dp;
}

#battle-turn,
#battle-result,
#battle-menu-title,
#battle-menu-hint,
#battle-back-hint,
#battle-list-empty,
#battle-target-empty {
    color: #ffffffff;
    font-effect: shadow(1dp 1dp #000000cc);
    pointer-events: none;
}

#battle-turn {
    width: 184dp;
    height: 14dp;
    line-height: 14dp;
    overflow: hidden;
}

#battle-result {
    width: 184dp;
    height: 26dp;
    line-height: 13dp;
    margin-top: 1dp;
    white-space: normal;
    word-break: break-word;
    overflow: hidden;
    color: #d8dee9ff;
}

#battle-actions {
    position: relative;
    width: 184dp;
    height: 72dp;
    margin-top: 1dp;
}

#battle-menu-title {
    display: inline-block;
    width: 56dp;
    height: 13dp;
    line-height: 13dp;
    color: #fce97fff;
}

#battle-menu-hint {
    display: inline-block;
    width: 124dp;
    height: 13dp;
    line-height: 13dp;
    color: #abb6c9ff;
    overflow: hidden;
}

#battle-main-actions,
#battle-list-menu,
#battle-target-menu {
    position: absolute;
    left: 0;
    top: 15dp;
    width: 184dp;
}

#battle-main-actions {
    height: 56dp;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 4dp;
}

.battle-text-button {
    background-color: #151d29ff;
    border-width: 1dp;
    border-color: #56657aff;
    color: #ffffffff;
    text-align: center;
    font-effect: shadow(1dp 1dp #000000aa);
}

.battle-action-button {
    width: 88dp;
    height: 16dp;
    line-height: 14dp;
}

#battle-list-menu,
#battle-target-menu {
    height: 40dp;
    display: flex;
    flex-direction: column;
    gap: 3dp;
}

.battle-list-entry,
.battle-target-entry {
    width: 184dp;
    height: 16dp;
    line-height: 14dp;
    text-align: left;
    padding-left: 5dp;
    padding-right: 5dp;
}

.battle-entry-label,
.battle-entry-sublabel {
    display: inline-block;
    line-height: 14dp;
}

.battle-entry-label {
    width: 92dp;
}

.battle-entry-sublabel {
    width: 76dp;
    color: #abb6c9ff;
    text-align: right;
}

.tf-input-mouse .battle-text-button:hover,
.tf-input-nav .battle-text-button:focus {
    background-color: #223047ff;
    border-color: #fce97fff;
    color: #fce97fff;
}

.tf-input-mouse .battle-text-button:hover:active,
.tf-input-nav .battle-text-button:focus:active,
.battle-text-button:active {
    background-color: #101722ff;
    color: #c7d8f4ff;
}

.battle-list-entry.disabled,
.battle-target-entry.disabled,
.battle-list-entry:disabled,
.battle-target-entry:disabled,
.battle-action-button.disabled,
.battle-action-button:disabled {
    color: #6e7480ff;
    background-color: #111820ff;
    border-color: #2d3540ff;
}

.battle-list-entry.disabled .battle-entry-sublabel,
.battle-list-entry:disabled .battle-entry-sublabel {
    color: #6e7480ff;
}

.tf-input-mouse .battle-text-button.disabled:hover,
.tf-input-nav .battle-text-button.disabled:focus,
.tf-input-mouse .battle-text-button:disabled:hover,
.tf-input-nav .battle-text-button:disabled:focus {
    background-color: #111820ff;
    border-color: #2d3540ff;
    color: #6e7480ff;
}

.battle-target-entry.is-ally {
    color: #8db8ffff;
}

.battle-target-entry.is-dead {
    color: #6e7480ff;
}

#battle-back-hint {
    position: absolute;
    left: 0;
    top: 58dp;
    width: 184dp;
    height: 13dp;
    line-height: 13dp;
    color: #abb6c9ff;
}

#battle-list-empty,
#battle-target-empty {
    width: 184dp;
    height: 16dp;
    line-height: 14dp;
    color: #abb6c9ff;
    text-align: center;
}
