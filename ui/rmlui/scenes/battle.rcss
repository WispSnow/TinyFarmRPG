body, div, h1, h2, h3, h4, p, hr {
    display: block;
}

@spritesheet battle-party-portrait-player-sheet {
    src: ../../../assets/farm-rpg/Character and Portrait/Portrait/Premade/1.png;
    battle-party-portrait-player: 8px 8px 48px 48px;
}

@spritesheet battle-party-portrait-lyria-sheet {
    src: ../../../assets/farm-rpg/Character and Portrait/Portrait/Premade/9.png;
    battle-party-portrait-lyria: 8px 8px 48px 48px;
}

@spritesheet battle-party-portrait-tori-sheet {
    src: ../../../assets/farm-rpg/Character and Portrait/Portrait/Premade/2.png;
    battle-party-portrait-tori: 8px 8px 48px 48px;
}

#battle-hud {
    position: absolute;
    box-sizing: border-box;
    left: 0;
    top: 256dp;
    width: 640dp;
    height: 104dp;
    padding: 4dp 8dp;
}

#battle-top-status {
    position: absolute;
    left: 318dp;
    top: 6dp;
    width: 314dp;
    height: 34dp;
}

#battle-log-panel {
    position: absolute;
    left: 318dp;
    top: 42dp;
    width: 314dp;
    height: 54dp;
    padding: 0;
    background-color: #00000000;
    border-width: 0dp;
    border-color: #00000000;
    overflow: hidden;
    pointer-events: none;
}

#battle-victory-overlay {
    position: absolute;
    left: 0;
    top: 0;
    width: 640dp;
    height: 256dp;
    background-color: #1a1b26c0;
}

#battle-defeat-overlay {
    position: absolute;
    left: 0;
    top: 0;
    width: 640dp;
    height: 256dp;
    background-color: #1a1b26c0;
}

#battle-victory-panel {
    position: absolute;
    box-sizing: border-box;
    left: 170dp;
    top: 6dp;
    width: 300dp;
    height: 244dp;
    padding: 10dp;
}

#battle-defeat-panel {
    position: absolute;
    box-sizing: border-box;
    left: 154dp;
    top: 20dp;
    width: 328dp;
    height: 214dp;
    padding: 10dp;
}

#battle-victory-title {
    width: 280dp;
    height: 34dp;
    line-height: 34dp;
    color: #fce97fff;
    font-size: 1.5rem;
    text-align: center;
    font-effect: shadow(1dp 1dp #000000dd);
}

#battle-defeat-title {
    width: 308dp;
    height: 34dp;
    line-height: 34dp;
    color: #f7768eff;
    font-size: 1.5rem;
    text-align: center;
    font-effect: shadow(1dp 1dp #000000dd);
}

#battle-victory-rewards {
    width: 280dp;
    height: 144dp;
    margin-top: 6dp;
    box-sizing: border-box;
}

#battle-defeat-summary {
    width: 308dp;
    height: 118dp;
    margin-top: 8dp;
    box-sizing: border-box;
}

.battle-defeat-message {
    width: 288dp;
    line-height: 16dp;
    color: #2a1f17ff;
    font-size: 0.625rem;
    font-effect: shadow(1dp 1dp #ffffff44);
    text-align: center;
}

.battle-defeat-body {
    height: 32dp;
    margin-top: 6dp;
}

.battle-defeat-losses {
    height: 32dp;
    color: #6f4f37cc;
}

.battle-defeat-recovery {
    height: 32dp;
    color: #9ece6aff;
    font-effect: shadow(1dp 1dp #000000cc);
}

.battle-victory-row {
    width: 100%;
    height: 20dp;
    display: flex;
    flex-direction: row;
    margin-bottom: 2dp;
}

.battle-victory-label {
    width: 140dp;
    height: 18dp;
    line-height: 18dp;
    padding-left: 6dp;
    color: #2a1f17ff;
    font-size: 0.625rem;
    font-effect: shadow(1dp 1dp #ffffff44);
}

.battle-victory-value {
    width: 108dp;
    height: 18dp;
    line-height: 18dp;
    padding-right: 6dp;
    color: #e0af68ff;
    font-size: 0.625rem;
    text-align: right;
    font-effect: shadow(1dp 1dp #000000cc);
}

#battle-victory-item-list {
    width: 100%;
    height: 44dp;
    margin-top: 4dp;
    overflow: hidden;
}

.battle-victory-empty {
    width: 100%;
    height: 20dp;
    line-height: 20dp;
    color: #6f4f37cc;
    font-size: 0.5625rem;
    text-align: center;
    font-effect: shadow(1dp 1dp #ffffff44);
}

.battle-victory-item {
    width: 100%;
    height: 20dp;
    display: flex;
    flex-direction: row;
    margin-bottom: 1dp;
    background-color: transparent;
}

.battle-victory-item-icon {
    width: 18dp;
    height: 18dp;
    margin-left: 2dp;
    decorator: none;
}

.battle-victory-item-label {
    width: 180dp;
    height: 20dp;
    line-height: 20dp;
    padding-left: 5dp;
    color: #2a1f17ff;
    font-size: 0.5625rem;
    font-effect: shadow(1dp 1dp #ffffff44);
    overflow: hidden;
}

.battle-victory-item-count {
    width: 52dp;
    height: 20dp;
    line-height: 20dp;
    padding-right: 6dp;
    color: #e0af68ff;
    font-size: 0.5625rem;
    text-align: right;
    font-effect: shadow(1dp 1dp #000000cc);
}

#battle-victory-level-list {
    width: 100%;
    height: 36dp;
    margin-top: 4dp;
    overflow: hidden;
}

.battle-victory-level {
    width: 100%;
    height: 18dp;
    display: flex;
    flex-direction: row;
    background-color: transparent;
}

.battle-victory-level-label {
    width: 134dp;
    height: 18dp;
    line-height: 18dp;
    padding-left: 6dp;
    color: #9ece6aff;
    font-size: 0.5625rem;
    font-effect: shadow(1dp 1dp #000000cc);
    overflow: hidden;
}

.battle-victory-level-stats {
    width: 114dp;
    height: 18dp;
    line-height: 18dp;
    padding-right: 6dp;
    color: #e0af68ff;
    font-size: 0.5625rem;
    text-align: right;
    font-effect: shadow(1dp 1dp #000000cc);
    overflow: hidden;
}

#battle-victory-continue {
    width: 108dp;
    margin-left: 86dp;
    margin-top: 8dp;
}

#battle-defeat-continue {
    width: 108dp;
    margin-left: 100dp;
    margin-top: 8dp;
}

.battle-log-entry {
    width: 314dp;
    height: 18dp;
    line-height: 18dp;
    color: #a9b1d6ff;
    font-size: 0.625rem;
    text-align: right;
    font-effect: shadow(1dp 1dp #000000cc);
    overflow: hidden;
    white-space: nowrap;
}

.battle-log-entry.log-damage {
    color: #f7768eff;
}

.battle-log-entry.log-recovery {
    color: #9ece6aff;
}

.battle-log-entry.log-state {
    color: #7dcfffff;
}

.battle-log-entry.log-system {
    color: #fce97fff;
}

.battle-log-entry.log-error {
    color: #f7768eff;
}

#battle-turn-order-bar {
    position: absolute;
    left: 6dp;
    top: 6dp;
    width: 304dp;
    height: 34dp;
    display: flex;
    flex-direction: row;
    gap: 3dp;
    overflow: hidden;
}

.battle-turn-order-entry {
    position: relative;
    width: 30dp;
    height: 30dp;
    padding: 0;
    background-color: #00000000;
    border-width: 0dp;
    border-color: #00000000;
}

.battle-turn-order-entry.acted-turn-entry {
    color: #666666ff;
}

.battle-turn-order-entry.ko-turn-entry {
    color: #666666ff;
}

.battle-turn-order-entry.current-turn-entry {
    margin-top: -2dp;
}

.battle-turn-order-portrait {
    width: 28dp;
    height: 28dp;
    background-color: #24283b66;
    border-width: 1dp;
    border-color: #414868ff;
    decorator: none;
    overflow: hidden;
    image-color: #ffffffff;
}

.battle-turn-order-entry.enemy-turn-entry .battle-turn-order-portrait {
    background-color: #24283b66;
    border-color: #f7768eff;
}

.battle-turn-order-entry.current-turn-entry .battle-turn-order-portrait {
    border-color: #fce97fff;
}

.battle-turn-order-entry.acted-turn-entry .battle-turn-order-portrait,
.battle-turn-order-entry.ko-turn-entry .battle-turn-order-portrait {
    border-color: #414868ff;
}

.battle-turn-order-entry.acted-turn-entry .battle-turn-order-portrait {
    image-color: #ffffff77;
}

.battle-turn-order-entry.ko-turn-entry .battle-turn-order-portrait {
    image-color: #ffffff44;
}

.battle-turn-order-label {
    display: block;
    width: 26dp;
    height: 26dp;
    line-height: 26dp;
    color: #ffffffff;
    font-size: 0.5625rem;
    text-align: center;
    font-effect: shadow(1dp 1dp #000000cc);
}

.battle-turn-order-entry.enemy-turn-entry .battle-turn-order-label {
    color: #f7768eff;
}

.battle-turn-order-entry.acted-turn-entry .battle-turn-order-label,
.battle-turn-order-entry.ko-turn-entry .battle-turn-order-label {
    color: #666666ff;
}

.battle-turn-order-badge {
    position: absolute;
    left: 20dp;
    top: 20dp;
    width: 9dp;
    height: 9dp;
    line-height: 9dp;
    color: #ffffffff;
    background-color: #1a1b26cc;
    border-width: 1dp;
    border-color: #fce97fee;
    font-size: 0.375rem;
    text-align: center;
    font-effect: shadow(1dp 1dp #000000dd);
}

.battle-turn-order-entry.acted-turn-entry .battle-turn-order-badge {
    color: #666666dd;
    border-color: #414868cc;
    background-color: #1a1b26aa;
}

.battle-turn-order-entry.ko-turn-entry .battle-turn-order-badge {
    color: #666666cc;
    border-color: #414868bb;
    background-color: #1a1b2688;
}

#battle-party-panel {
    position: absolute;
    left: 4dp;
    top: 4dp;
    width: 508dp;
    height: 88dp;
    display: flex;
    flex-direction: row;
    gap: 4dp;
}

.battle-party-card {
    position: relative;
    box-sizing: border-box;
    width: 124dp;
    height: 88dp;
    padding: 4dp;
    border: 1dp #00000000;
    color: #2a1f17ff;
    transform: translateY(0);
    transition: transform 0.08s cubic-out, border-color 0.08s cubic-out, opacity 0.08s cubic-out;
}

.battle-party-card.active-party-member {
    border-color: #fce97fff;
    transform: translateY(-1dp);
}

.battle-party-card.ko-party-member {
    color: #666666ff;
    opacity: 0.5;
}

.battle-party-main {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 114dp;
    height: 78dp;
}

.battle-party-body {
    display: flex;
    flex-direction: row;
    gap: 4dp;
    width: 114dp;
    height: 64dp;
}

.battle-portrait {
    width: 48dp;
    height: 48dp;
    margin-top: 5dp;
    background-color: #00000000;
    border-width: 0dp;
    border-color: #00000000;
    decorator: none;
}

.battle-party-stats {
    width: 62dp;
    height: 58dp;
    margin-top: 5dp;
}

.battle-party-name {
    width: 114dp;
    height: 14dp;
    line-height: 14dp;
    color: #2a1f17ff;
    text-align: center;
    font-effect: shadow(1dp 1dp #ffffff44);
    overflow: hidden;
}

.battle-party-card.active-party-member .battle-party-name {
    color: #fce97fff;
    font-effect: shadow(1dp 1dp #000000cc);
}

.battle-stat-label {
    width: 62dp;
    height: 11dp;
    line-height: 11dp;
    color: #2a1f17ff;
    font-size: 0.5rem;
    font-effect: shadow(1dp 1dp #ffffff44);
    overflow: hidden;
}

.battle-stat-kind,
.battle-stat-value {
    display: inline-block;
    height: 11dp;
    line-height: 11dp;
}

.battle-stat-kind {
    width: 13dp;
    color: #6f4f37cc;
}

.battle-stat-value {
    width: 49dp;
    color: #2a1f17ff;
    font-size: 0.4375rem;
    text-align: right;
}

.battle-hp-label {
    margin-top: 0;
}

.battle-mp-label {
    margin-top: 4dp;
}

.battle-stat-bar {
    width: 62dp;
    height: 6dp;
    background-color: #1a1b26cc;
    border-width: 1dp;
    border-color: #414868ff;
}

.battle-stat-fill {
    height: 4dp;
}

.battle-state-icon-row {
    width: 62dp;
    height: 12dp;
    margin-top: 4dp;
    display: flex;
    flex-direction: row;
    gap: 2dp;
    overflow: hidden;
}

.battle-party-card.ko-party-member .battle-state-icon-row {
    display: none;
}

.battle-state-icon {
    position: relative;
    width: 11dp;
    height: 11dp;
}

.battle-state-icon-image {
    width: 9dp;
    height: 9dp;
    background-color: #1a1b26cc;
    border-width: 1dp;
    border-color: #414868ff;
    decorator: none;
    image-color: #ffffffff;
    overflow: hidden;
}

.battle-state-icon.unknown-state-icon .battle-state-icon-image {
    border-color: #414868cc;
    image-color: #ffffffaa;
}

.tf-input-mouse .battle-state-icon:hover .battle-state-icon-image {
    border-color: #fce97fff;
}

.battle-state-icon-label {
    display: block;
    width: 7dp;
    height: 7dp;
    line-height: 7dp;
    color: #ffffffff;
    font-size: 0.375rem;
    text-align: center;
    font-effect: shadow(1dp 1dp #000000cc);
}

.battle-state-turns {
    position: absolute;
    left: 5dp;
    top: 5dp;
    width: 6dp;
    height: 6dp;
    line-height: 6dp;
    color: #ffffffff;
    background-color: #1a1b26cc;
    border-width: 1dp;
    border-color: #fce97fee;
    font-size: 0.3125rem;
    text-align: center;
    font-effect: shadow(1dp 1dp #000000dd);
}

.battle-state-tooltip {
    position: absolute;
    box-sizing: border-box;
    left: 0;
    top: -48dp;
    width: 124dp;
    min-height: 42dp;
    padding: 4dp;
    background-color: #24283bee;
    border-width: 1dp;
    border-color: #414868ff;
    color: #ffffffff;
}

.battle-state-tooltip-title,
.battle-state-tooltip-turns,
.battle-state-tooltip-description {
    width: 114dp;
    font-effect: shadow(1dp 1dp #000000cc);
    overflow: hidden;
}

.battle-state-tooltip-title {
    height: 11dp;
    line-height: 11dp;
    color: #fce97fff;
    font-size: 0.5rem;
}

.battle-state-tooltip-turns {
    height: 9dp;
    line-height: 9dp;
    color: #a9b1d6ff;
    font-size: 0.4375rem;
}

.battle-state-tooltip-description {
    min-height: 12dp;
    line-height: 9dp;
    color: #ffffffff;
    font-size: 0.4375rem;
    white-space: normal;
    word-break: break-word;
}

.battle-hp-fill {
    background-color: #f7768eff;
}

.battle-mp-fill {
    background-color: #7aa2f7ff;
}

#battle-command-panel {
    position: absolute;
    box-sizing: border-box;
    left: 516dp;
    top: 4dp;
    width: 120dp;
    height: 88dp;
    padding: 3dp 5dp;
    background-color: transparent;
    border-width: 0dp;
    border-color: #00000000;
}

#battle-turn,
#battle-result,
#battle-list-empty,
#battle-target-empty {
    color: #ffffffff;
    font-effect: shadow(1dp 1dp #000000cc);
    pointer-events: none;
}

#battle-turn {
    width: 314dp;
    height: 16dp;
    line-height: 16dp;
    text-align: right;
    overflow: hidden;
}

#battle-result {
    width: 314dp;
    height: 16dp;
    line-height: 16dp;
    text-align: right;
    white-space: normal;
    word-break: break-word;
    overflow: hidden;
    color: #a9b1d6ff;
}

#battle-actions {
    position: relative;
    width: 108dp;
    height: 80dp;
}

#battle-party-command,
#battle-actor-command,
#battle-list-menu,
#battle-target-menu {
    position: absolute;
    left: 0;
    top: 0;
    width: 108dp;
}

#battle-party-command,
#battle-actor-command {
    height: 80dp;
    display: flex;
    flex-direction: column;
    gap: 2dp;
}

#battle-list-menu,
#battle-target-menu {
    height: 80dp;
    display: flex;
    flex-direction: column;
    gap: 2dp;
    overflow-y: auto;
    overflow-x: hidden;
}

#battle-list-menu scrollbarvertical,
#battle-target-menu scrollbarvertical {
    width: 4dp;
    scrollbar-margin: 0dp;
}

#battle-list-menu scrollbarvertical slidertrack,
#battle-target-menu scrollbarvertical slidertrack {
    background-color: #d9a88a33;
    border-width: 0dp;
    border-color: #00000000;
}

#battle-list-menu scrollbarvertical sliderbar,
#battle-target-menu scrollbarvertical sliderbar {
    background-color: #b56f5ddd;
    border-width: 0dp;
    border-color: #00000000;
}

.battle-text-button {
    box-sizing: border-box;
    background-color: transparent;
    border-width: 0;
    color: #2a1f17ff;
    text-align: left;
    padding-left: 4dp;
    padding-right: 4dp;
    font-effect: shadow(1dp 1dp #ffffff44);
    tab-index: auto;
    nav-up: auto;
    nav-down: auto;
    nav-left: auto;
    nav-right: auto;
    transition: padding-left color 0.1s cubic-out;
}

.battle-party-command-button,
.battle-actor-command-button {
    width: 108dp;
    height: 18dp;
    line-height: 18dp;
}

.battle-list-entry-row,
.battle-target-entry-row {
    width: 100%;
    height: 16dp;
    flex-shrink: 0;
}

.battle-list-entry,
.battle-target-entry {
    width: 100%;
    height: 16dp;
    line-height: 16dp;
    padding-left: 4dp;
    padding-right: 4dp;
    font-size: 0.625rem;
    white-space: nowrap;
    overflow: hidden;
    flex-shrink: 0;
}

.battle-entry-label,
.battle-entry-sublabel {
    display: inline-block;
    height: 16dp;
    line-height: 16dp;
    vertical-align: top;
    white-space: nowrap;
    overflow: hidden;
}

.battle-entry-label {
    width: 50dp;
}

.battle-entry-sublabel {
    width: 40dp;
    color: #6f4f37cc;
    text-align: right;
}

.battle-cursor {
    display: inline-block;
    vertical-align: top;
    color: #fce97fff;
    margin-right: 3dp;
    opacity: 0;
}

@keyframes battle-cursor-blink {
    from { opacity: 1; }
    50%  { opacity: 0.35; }
    to   { opacity: 1; }
}

.tf-input-mouse .battle-text-button:hover,
.tf-input-nav .battle-text-button:focus,
.tf-input-nav .battle-text-button.selected {
    padding-left: 8dp;
    background-color: transparent;
    color: #8b4f1aff;
}

.tf-input-mouse .battle-text-button:hover .battle-entry-sublabel,
.tf-input-nav .battle-text-button:focus .battle-entry-sublabel,
.tf-input-nav .battle-text-button.selected .battle-entry-sublabel {
    color: #8b4f1aff;
}

.tf-input-mouse .battle-text-button:hover .battle-cursor,
.tf-input-nav .battle-text-button:focus .battle-cursor,
.tf-input-nav .battle-text-button.selected .battle-cursor {
    opacity: 1;
    animation: 0.8s linear infinite battle-cursor-blink;
}

.tf-input-mouse .battle-text-button:hover:active,
.tf-input-nav .battle-text-button:focus:active,
.battle-text-button:active {
    background-color: transparent;
    color: #6b5544ff;
}

.battle-list-entry.disabled,
.battle-target-entry.disabled,
.battle-list-entry:disabled,
.battle-target-entry:disabled,
.battle-party-command-button.disabled,
.battle-party-command-button:disabled,
.battle-actor-command-button.disabled,
.battle-actor-command-button:disabled {
    color: #85705a99;
    background-color: transparent;
}

.battle-list-entry.disabled .battle-entry-sublabel,
.battle-list-entry:disabled .battle-entry-sublabel,
.battle-target-entry.disabled .battle-entry-sublabel,
.battle-target-entry:disabled .battle-entry-sublabel {
    color: #85705a99;
}

.tf-input-mouse .battle-text-button.disabled:hover,
.tf-input-nav .battle-text-button.disabled:focus,
.tf-input-nav .battle-text-button.disabled.selected,
.tf-input-mouse .battle-text-button:disabled:hover,
.tf-input-nav .battle-text-button:disabled:focus,
.tf-input-nav .battle-text-button:disabled.selected {
    padding-left: 4dp;
    background-color: transparent;
    color: #85705a99;
}

.tf-input-mouse .battle-text-button.disabled:hover .battle-entry-sublabel,
.tf-input-nav .battle-text-button.disabled:focus .battle-entry-sublabel,
.tf-input-nav .battle-text-button.disabled.selected .battle-entry-sublabel,
.tf-input-mouse .battle-text-button:disabled:hover .battle-entry-sublabel,
.tf-input-nav .battle-text-button:disabled:focus .battle-entry-sublabel,
.tf-input-nav .battle-text-button:disabled.selected .battle-entry-sublabel {
    color: #85705a99;
}

.tf-input-mouse .battle-text-button.disabled:hover .battle-cursor,
.tf-input-nav .battle-text-button.disabled:focus .battle-cursor,
.tf-input-nav .battle-text-button.disabled.selected .battle-cursor,
.tf-input-mouse .battle-text-button:disabled:hover .battle-cursor,
.tf-input-nav .battle-text-button:disabled:focus .battle-cursor,
.tf-input-nav .battle-text-button:disabled.selected .battle-cursor {
    opacity: 0;
    animation: none;
}

.battle-target-entry.is-ally {
    color: #7aa2f7ff;
}

.battle-target-entry.is-dead {
    color: #85705a99;
}

#battle-list-empty,
#battle-target-empty {
    width: 108dp;
    height: 18dp;
    line-height: 18dp;
    color: #6f4f37cc;
    text-align: center;
    font-effect: shadow(1dp 1dp #ffffff44);
}
