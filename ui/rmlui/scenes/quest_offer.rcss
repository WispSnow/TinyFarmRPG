body, div, h1, h2, h3, h4, p, hr {
    display: block;
}

/* 几何 / 布局; 颜色与文字效果在 RML 中通过 tf-scene-* utility 提供。
   position: absolute 来自 .tf-scene-panel utility, 此处只声明几何。 */

/* 覆盖默认 tf-modal-overlay (60% 黑) 为更深的 Tokyo Night 暗蓝 75%,
   与 Inventory 一致, 把世界 dusk 色调遮住, 让木板面板的对比更突出。 */
#quest-offer-overlay {
    background-color: #1a1b26c0;
}

#quest-offer-panel {
    left: 112dp;
    top: 24dp;
    width: 384dp;
    height: 280dp;
    padding: 16dp;
}

#quest-offer-speaker {
    width: 100%;
    height: 18dp;
    line-height: 18dp;
}

#quest-offer-line {
    margin-top: 6dp;
    width: 100%;
    height: 34dp;
    line-height: 17dp;
}

#quest-offer-card {
    margin-top: 10dp;
    width: 352dp;
    height: 134dp;
    padding: 10dp;
}

#quest-offer-title {
    width: 100%;
    height: 20dp;
    line-height: 20dp;
}

#quest-offer-description {
    margin-top: 4dp;
    width: 100%;
    height: 34dp;
    line-height: 17dp;
}

.quest-offer-section {
    margin-top: 8dp;
    margin-bottom: 0dp;
    width: 100%;
    height: 22dp;
}

.quest-offer-label {
    width: 82dp;
    height: 20dp;
    line-height: 20dp;
}

.quest-offer-value {
    width: 246dp;
    height: 20dp;
    line-height: 20dp;
    color: #ffffffff;
    font-effect: shadow(1dp 1dp #000000cc);
}

#quest-offer-actions {
    margin-top: 14dp;
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 12dp;
}

.quest-offer-action-button {
    width: 128dp;
}
