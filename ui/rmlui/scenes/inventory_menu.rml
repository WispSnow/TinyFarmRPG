<rml>
<head>
    <link type="text/rcss" href="../theme/base.rcss"/>
    <link type="text/rcss" href="../theme/reset.rcss"/>
    <link type="text/rcss" href="../theme/nav.rcss"/>
    <link type="text/rcss" href="../theme/slot_widgets.rcss"/>
    <link type="text/rcss" href="../theme/spritesheet.rcss"/>
    <link type="text/rcss" href="../theme/portrait.rcss"/>
    <link type="text/rcss" href="../theme/menu_widgets.rcss"/>
    <link type="text/rcss" href="inventory_menu.rcss"/>
</head>
<body class="tf-screen-root tf-nav-root" data-model="inventory_menu">
    <div id="menu-overlay"></div>

    <div id="tab-shortcut-tooltip-panel">
        <div id="tab-shortcut-tooltip-text"></div>
    </div>

    <div id="menu-panel">

        <!-- Two-column content -->
        <div id="content-row">

            <!-- Left: Tabbed content -->
            <tabset id="menu-tabset" data-event-tabchange="switch_tab(ev.tab_index)">
                <tab class="tab-icon tf-nav-auto tf-focus-ring-gold"
                     id="tab-inventory"
                     title="Inventory"
                     data-i18n-title="inventory.tab.inventory"
                     data-event-mouseover="tab_shortcut_hover(0)"
                     data-event-mouseout="tab_shortcut_exit"></tab>
                <panel id="panel-inventory">
                    <div id="inventory-actions">
                        <button class="tf-nav-auto tf-focus-ring-blue"
                                id="sort-btn"
                                title="Sort"
                                data-i18n-title="inventory.action.sort"
                                data-event-click="sort"></button>
                        <button class="tf-nav-auto tf-focus-ring-danger"
                                id="trash-btn"
                                title="Trash"
                                data-i18n-title="inventory.action.trash"
                                data-event-click="trash"
                                data-event-dragdrop="trash_drag_drop"></button>
                    </div>

                    <div id="slot-region">
                        <div id="hotbar-area">
                            <div id="hotbar-grid">
                                <div class="hb-slot tf-slot-focusable tf-slot-hover-scale tf-nav-auto"
                                     data-for="hslot : hotbar_slots"
                                     data-class-has-item="hslot.has_item"
                                     data-class-has-count="hslot.has_count"
                                     data-class-hb-active="hslot.is_active"
                                     data-class-hb-selected="hslot.is_selected"
                                     data-event-dragdrop="hb_slot_drag_drop(hslot.slot_index)"
                                     data-event-mousedown="hb_slot_mouse_down(hslot.slot_index)"
                                     data-event-mouseup="hb_slot_mouse_up(hslot.slot_index)"
                                     data-event-focus="hb_slot_focus(hslot.slot_index)">
                                    <div class="hb-slot-drag-proxy tf-slot-drag-proxy"
                                         data-class-draggable="hslot.can_drag"
                                         data-attr-slot_grid_source="2"
                                         data-attr-slot_index="hslot.slot_index"
                                         data-event-mouseover="hb_slot_hover_enter(hslot.slot_index)"
                                         data-event-mouseout="hb_slot_hover_exit(hslot.slot_index)"
                                         data-event-dragstart="hb_slot_drag_start(hslot.slot_index)"
                                         data-event-dragend="hb_slot_drag_end(hslot.slot_index)">
                                        <div class="inv-slot-icon tf-slot-icon-pop" data-style-decorator="hslot.icon_decorator"></div>
                                        <div class="inv-slot-count tf-slot-count">{{ hslot.count_text }}</div>
                                    </div>
                                    <div class="hb-slot-index">{{ hslot.label }}</div>
                                </div>
                            </div>
                        </div>

                        <div id="backpack-area">
                            <div id="backpack-grid">
                                <div class="bp-slot tf-slot-focusable tf-slot-hover-scale tf-nav-auto"
                                     data-for="slot : backpack_slots"
                                     data-class-has-item="slot.has_item"
                                     data-class-has-count="slot.has_count"
                                     data-class-bp-selected="slot.is_selected"
                                     data-event-mousedown="bp_slot_mouse_down(slot.slot_index)"
                                     data-event-mouseup="bp_slot_mouse_up(slot.slot_index)"
                                     data-event-dragdrop="bp_slot_drag_drop(slot.slot_index)"
                                     data-event-focus="bp_slot_focus(slot.slot_index)">
                                    <div class="bp-slot-drag-proxy tf-slot-drag-proxy"
                                         data-class-draggable="slot.can_drag"
                                         data-attr-slot_grid_source="1"
                                         data-attr-slot_index="slot.slot_index"
                                         data-event-mouseover="bp_slot_hover_enter(slot.slot_index)"
                                         data-event-mouseout="bp_slot_hover_exit(slot.slot_index)"
                                         data-event-dragstart="bp_slot_drag_start(slot.slot_index)"
                                         data-event-dragend="bp_slot_drag_end(slot.slot_index)">
                                        <div class="inv-slot-icon tf-slot-icon-pop" data-style-decorator="slot.icon_decorator"></div>
                                        <div class="inv-slot-count tf-slot-count">{{ slot.count_text }}</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="action-menu"
                             data-if="action_menu_visible">
                            <div id="action-menu-title">{{ action_menu_title }}</div>
                            <button class="action-menu-entry tf-nav-auto tf-focus-ring-blue"
                                    data-for="action : action_menu_entries"
                                    data-class-action-danger="action.is_destructive"
                                    data-event-click="action_entry_click(action.action_id)">{{ action.label }}</button>
                        </div>
                    </div>

                    <div id="detail-area" data-if="has_detail">
                        <div id="detail-name">{{ detail_name }}</div>
                        <div id="detail-category">{{ detail_category }}</div>
                        <div id="detail-description">{{ detail_description }}</div>
                    </div>

                    <div id="menu-footer">
                        <div id="gold-label">{{ gold_label }}</div>
                        <div id="inventory-capacity-label">{{ inventory_capacity_label }}</div>
                    </div>
                </panel>

                <tab class="tab-icon tf-nav-auto tf-focus-ring-gold"
                     id="tab-equipment"
                     title="Equipment"
                     data-i18n-title="inventory.tab.equipment"
                     data-event-mouseover="tab_shortcut_hover(1)"
                     data-event-mouseout="tab_shortcut_exit"></tab>
                <panel id="panel-equipment">
                    <div id="equipment-content">
                        <div id="equipment-header">
                            <div id="equipment-actor-name">{{ equipment_actor_name }}</div>
                            <div id="equipment-actor-summary">{{ equipment_actor_summary }}</div>
                        </div>

                        <div id="equipment-main-row">
                            <div id="equipment-slot-list">
                                <button class="equipment-slot-entry tf-nav-auto tf-focus-ring-blue"
                                        data-for="eqslot : equipment_slots"
                                        data-class-equipment-slot-selected="eqslot.is_selected"
                                        data-class-has-item="eqslot.has_item"
                                        data-event-click="equipment_slot_click(eqslot.slot_index)">
                                    <div class="equipment-slot-placeholder"
                                         data-if="!eqslot.has_item"
                                         data-style-decorator="eqslot.placeholder_decorator"></div>
                                    <div class="equipment-slot-icon"
                                         data-if="eqslot.has_item"
                                         data-style-decorator="eqslot.icon_decorator"></div>
                                </button>
                            </div>

                            <div id="equipment-candidate-panel">
                                <div id="equipment-candidate-list" data-if="has_equipment_candidates">
                                    <button class="equipment-candidate-entry tf-nav-auto tf-focus-ring-blue"
                                            data-for="candidate : equipment_candidates"
                                            data-event-click="equipment_candidate_click(candidate.inventory_slot_index)">
                                        <div class="equipment-candidate-icon" data-style-decorator="candidate.icon_decorator"></div>
                                        <div class="equipment-candidate-text">
                                            <div class="equipment-candidate-name">{{ candidate.item_name }}</div>
                                            <div class="equipment-candidate-delta" data-if="candidate.has_delta">{{ candidate.delta_text }}</div>
                                        </div>
                                    </button>
                                </div>
                                <div id="equipment-candidate-empty"
                                     data-if="!has_equipment_candidates"
                                     data-i18n="inventory.equipment.no_candidates">No candidates</div>
                            </div>
                        </div>

                        <button id="equipment-unequip-btn"
                                class="tf-nav-auto tf-focus-ring-danger"
                                title="Unequip"
                                data-i18n-title="inventory.equipment.unequip"
                                data-event-click="equipment_unequip"></button>
                    </div>

                    <div id="equipment-detail" data-if="has_equipment_detail">
                        <div id="equipment-detail-header">
                            <div id="equipment-detail-title">{{ equipment_detail_name }}</div>
                            <div id="equipment-detail-category">{{ equipment_detail_category }}</div>
                        </div>
                        <div id="equipment-detail-description">{{ equipment_detail_description }}</div>
                    </div>
                </panel>

                <tab class="tab-icon tf-nav-auto tf-focus-ring-gold"
                     id="tab-quests"
                     title="Quests"
                     data-i18n-title="inventory.tab.quests"
                     data-event-mouseover="tab_shortcut_hover(2)"
                     data-event-mouseout="tab_shortcut_exit"></tab>
                <panel id="panel-quests">
                    <div id="quests-content">
                        <div class="quest-section">
                            <div class="quest-section-title" data-i18n="inventory.quest.active_title">Active Quests</div>
                            <div class="quest-empty" data-if="!has_active_quests" data-i18n="inventory.quest.active_empty">No active quests</div>
                            <div class="quest-list" data-if="has_active_quests">
                                <div class="quest-entry" data-for="quest : active_quest_entries">
                                    <div class="quest-entry-header">
                                        <div class="quest-title">{{ quest.title }}</div>
                                        <div class="quest-status">{{ quest.status_label }}</div>
                                    </div>
                                    <div class="quest-description" data-if="quest.has_description">{{ quest.description }}</div>
                                    <div class="quest-progress" data-if="quest.has_progress_summary">{{ quest.progress_summary }}</div>
                                </div>
                            </div>
                        </div>

                        <div class="quest-section quest-section-completed">
                            <div class="quest-section-title" data-i18n="inventory.quest.completed_title">Completed Quests</div>
                            <div class="quest-empty" data-if="!has_completed_quests" data-i18n="inventory.quest.completed_empty">No completed quests</div>
                            <div class="quest-list" data-if="has_completed_quests">
                                <div class="quest-entry quest-entry-completed" data-for="quest : completed_quest_entries">
                                    <div class="quest-entry-header">
                                        <div class="quest-title">{{ quest.title }}</div>
                                        <div class="quest-status">{{ quest.status_label }}</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </panel>

                <tab class="tab-icon tf-nav-auto tf-focus-ring-gold"
                     id="tab-map"
                     title="Map"
                     data-i18n-title="inventory.tab.map"
                     data-event-mouseover="tab_shortcut_hover(3)"
                     data-event-mouseout="tab_shortcut_exit"></tab>
                <panel id="panel-map">
                    <div id="map-content">
                        <div id="map-title">{{ map_title }}</div>
                        <div id="map-preview-frame">
                            <img id="map-preview-image"
                                 data-if="has_map_preview"
                                 data-attr-src="map_preview_src"
                                 data-style-left="map_preview_left"
                                 data-style-top="map_preview_top"
                                 data-style-width="map_preview_width"
                                 data-style-height="map_preview_height"/>
                            <button class="map-marker tf-nav-auto"
                                    data-for="marker : map_markers"
                                    data-class-map-marker-selected="marker.is_selected"
                                    data-class-map-marker-player="marker.kind == 'player'"
                                    data-class-map-marker-quest-offer="marker.kind == 'quest_offer'"
                                    data-class-map-marker-quest-objective="marker.kind == 'quest_objective'"
                                    data-class-map-marker-quest-turn-in="marker.kind == 'quest_turn_in'"
                                    data-class-map-marker-shop="marker.kind == 'shop'"
                                    data-class-map-marker-rest="marker.kind == 'rest'"
                                    data-class-map-marker-npc="marker.kind == 'npc'"
                                    data-style-left="marker.left"
                                    data-style-top="marker.top"
                                    data-style-width="marker.width"
                                    data-style-height="marker.height"
                                    data-style-z-index="marker.z_index"
                                    data-style-decorator="marker.icon_decorator"
                                    data-event-focus="map_marker_focus(marker.marker_index)"
                                    data-event-mouseover="map_marker_hover(marker.marker_index)"
                                    data-event-click="map_marker_click(marker.marker_index)"></button>
                            <div id="map-empty-label" data-if="!has_map_preview" data-i18n="inventory.map.empty">No map data</div>
                        </div>
                        <div id="map-detail-panel" data-if="has_map_detail">
                            <div id="map-detail-header">
                                <div id="map-detail-title">{{ map_detail_title }}</div>
                                <div id="map-detail-type">{{ map_detail_type }}</div>
                            </div>
                            <div id="map-detail-description">{{ map_detail_description }}</div>
                        </div>
                        <div id="map-status" data-if="!has_map_detail">{{ map_status_text }}</div>
                    </div>
                </panel>

                <tab class="tab-icon tf-nav-auto tf-focus-ring-gold"
                     id="tab-options"
                     title="Options"
                     data-i18n-title="inventory.tab.options"
                     data-event-mouseover="tab_shortcut_hover(4)"
                     data-event-mouseout="tab_shortcut_exit"></tab>
                <panel id="panel-options">
                    <div id="options-content">
                        <div class="options-row">
                            <div class="options-row-label" data-i18n="options.damage_popups">Damage Popups</div>
                            <button class="options-control options-toggle tf-nav-auto tf-focus-ring-blue"
                                    data-class-on="options_show_damage_popup"
                                    data-event-click="options_toggle_damage_popup">{{ options_damage_popup_text }}</button>
                        </div>
                        <div class="options-row">
                            <div class="options-row-label" data-i18n="options.enemy_hp_bar">Enemy HP Bar</div>
                            <button class="options-control options-toggle tf-nav-auto tf-focus-ring-blue"
                                    data-class-on="options_show_enemy_hp_bar"
                                    data-event-click="options_toggle_enemy_hp_bar">{{ options_enemy_hp_bar_text }}</button>
                        </div>
                        <div class="options-row">
                            <div class="options-row-label" data-i18n="options.cursor_memory">Cursor Memory</div>
                            <button class="options-control options-toggle tf-nav-auto tf-focus-ring-blue"
                                    data-class-on="options_cursor_memory"
                                    data-event-click="options_toggle_cursor_memory">{{ options_cursor_memory_text }}</button>
                        </div>
                        <div class="options-row">
                            <div class="options-row-label" data-i18n="options.battle_speed">Battle Speed</div>
                            <div class="options-control options-stepper">
                                <button class="options-stepper-btn tf-icon-button icon-arrow-left-light"
                                        data-event-click="options_battle_speed_prev"></button>
                                <div class="options-row-value">{{ options_battle_speed_text }}</div>
                                <button class="options-stepper-btn tf-icon-button icon-arrow-right-light"
                                        data-event-click="options_battle_speed_next"></button>
                            </div>
                        </div>
                    </div>
                </panel>
            </tabset>

            <!-- Right: Party -->
            <div id="party-col">
                <button class="party-card tf-nav-auto tf-focus-ring-blue"
                        data-for="member : party_members"
                        data-class-party-empty="member.empty"
                        data-class-party-selected="member.selected"
                        data-class-party-targetable="member.targetable"
                        data-attrif-disabled="member.empty"
                        data-event-click="party_member_click(member.slot_index)">
                    <img class="party-portrait"
                         data-if="member.has_portrait"
                         data-attr-src="member.portrait_src"/>
                    <div class="party-portrait"
                         data-if="!member.has_portrait"
                         data-style-decorator="member.portrait_decorator"></div>
                    <div class="party-copy">
                        <div class="party-name">{{ member.display_name }}</div>
                        <div class="party-meta">{{ member.level_label }} {{ member.exp_label }}</div>
                        <div class="party-resource">{{ member.hp_text }}</div>
                        <div class="party-resource">{{ member.mp_text }}</div>
                    </div>
                </button>
            </div>

        </div>
    </div>
</body>
</rml>
