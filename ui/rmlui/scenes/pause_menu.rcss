#pause-panel {
    left: 216dp;
    top: 8dp;
    width: 160dp;
    height: 296dp;
    padding: 24dp;
}

#pause-message {
    height: 22dp;
    margin-top: 4dp;
    text-align: center;
    line-height: 18dp;
    font-effect: shadow(1dp 1dp #000000cc);
}

#pause-message.is-error {
    color: #ff4040ff;
}

#pause-message.is-success {
    color: #40ff40ff;
}

#pause-actions {
    display: flex;
    flex-direction: column;
    gap: 6dp;
}

.pause-action-button {
    width: 160dp;
}

#pause-values {
    margin-top: 16dp;
    display: flex;
    flex-direction: column;
    gap: 6dp;
}

.pause-value-row {
    width: 160dp;
    height: 32dp;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}
