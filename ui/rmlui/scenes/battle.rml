<rml>
<head>
    <link type="text/rcss" href="../theme/base.rcss"/>
    <link type="text/rcss" href="../theme/reset.rcss"/>
    <link type="text/rcss" href="../theme/nav.rcss"/>
    <link type="text/rcss" href="../theme/spritesheet.rcss"/>
    <link type="text/rcss" href="../theme/portrait.rcss"/>
    <link type="text/rcss" href="../theme/battle_enemy_icons.rcss"/>
    <link type="text/rcss" href="../theme/battle_state_icons.rcss"/>
    <link type="text/rcss" href="battle.rcss"/>
</head>
<body class="tf-screen-root tf-nav-root" data-model="battle_scene">
    <div id="battle-turn-order-bar">
        <div class="battle-turn-order-entry"
             data-for="entry : turn_order_entries"
             data-class-current-turn-entry="entry.current"
             data-class-acted-turn-entry="entry.acted"
             data-class-ko-turn-entry="entry.ko"
             data-class-enemy-turn-entry="entry.enemy">
            <div class="battle-turn-order-portrait" data-style-decorator="entry.portrait_decorator">
                <span class="battle-turn-order-label" data-if="entry.short_label != ''">{{ entry.short_label }}</span>
            </div>
            <span class="battle-turn-order-badge" data-if="entry.badge_label != ''">{{ entry.badge_label }}</span>
        </div>
    </div>

    <div id="battle-top-status">
        <div id="battle-turn">{{ turn_text }}</div>
        <div id="battle-result">{{ result_text }}</div>
    </div>

    <div id="battle-log-panel">
        <div class="battle-log-entry"
             data-for="entry : battle_log_entries"
             data-class-log-damage="entry.tone_class == 'damage'"
             data-class-log-recovery="entry.tone_class == 'recovery'"
             data-class-log-state="entry.tone_class == 'state'"
             data-class-log-system="entry.tone_class == 'system'"
             data-class-log-error="entry.tone_class == 'error'">{{ entry.text }}</div>
    </div>

    <div id="battle-victory-overlay" data-if="victory_overlay_visible">
        <div id="battle-victory-panel">
            <div id="battle-victory-title">{{ victory_title }}</div>
            <div id="battle-victory-rewards">
                <div class="battle-victory-row">
                    <span class="battle-victory-label">Gold</span>
                    <span class="battle-victory-value">{{ victory_gold_text }}</span>
                </div>
                <div class="battle-victory-row">
                    <span class="battle-victory-label">EXP</span>
                    <span class="battle-victory-value">{{ victory_exp_text }}</span>
                </div>
                <div id="battle-victory-item-list">
                    <div class="battle-victory-empty" data-if="victory_items_empty">{{ victory_item_empty_text }}</div>
                    <div class="battle-victory-item" data-for="item : victory_reward_items">
                        <div class="battle-victory-item-icon" data-style-decorator="item.icon_decorator"></div>
                        <span class="battle-victory-item-label">{{ item.label }}</span>
                        <span class="battle-victory-item-count">{{ item.count_text }}</span>
                    </div>
                </div>
                <div id="battle-victory-level-list" data-if="!victory_level_ups_empty">
                    <div class="battle-victory-level" data-for="level_up : victory_level_ups">
                        <span class="battle-victory-level-label">{{ level_up.label }}</span>
                        <span class="battle-victory-level-stats">{{ level_up.stat_text }}</span>
                    </div>
                </div>
            </div>
            <button id="battle-victory-continue"
                    class="battle-text-button tf-nav-auto"
                    data-class-disabled="!victory_continue_enabled"
                    data-attrif-disabled="!victory_continue_enabled"
                    data-event-click="victory_continue">{{ victory_prompt_text }}</button>
        </div>
    </div>

    <div id="battle-hud">
        <div id="battle-party-panel">
            <div class="battle-party-card"
                 data-for="member : party_status"
                 data-class-active-party-member="member.active"
                 data-class-ko-party-member="member.ko">
                <div class="battle-party-main">
                    <div class="battle-party-identity">
                        <div class="battle-party-name">{{ member.name }}</div>
                        <div class="battle-portrait" data-style-decorator="member.portrait_decorator"></div>
                    </div>
                    <div class="battle-party-stats">
                        <div class="battle-stat-label battle-hp-label">
                            <span class="battle-stat-kind">HP</span><span class="battle-stat-value">{{ member.hp_text }}</span>
                        </div>
                        <div class="battle-stat-bar battle-hp-bar">
                            <div class="battle-stat-fill battle-hp-fill" data-style-width="member.hp_ratio_percent"></div>
                        </div>
                        <div class="battle-stat-label battle-mp-label">
                            <span class="battle-stat-kind">MP</span><span class="battle-stat-value">{{ member.mp_text }}</span>
                        </div>
                        <div class="battle-stat-bar battle-mp-bar">
                            <div class="battle-stat-fill battle-mp-fill" data-style-width="member.mp_ratio_percent"></div>
                        </div>
                        <div class="battle-state-icon-row">
                            <div class="battle-state-icon"
                                 data-for="icon : party_state_icons"
                                 data-if="icon.unit_id == member.unit_id"
                                 data-class-unknown-state-icon="!icon.known"
                                 data-event-mouseover="state_icon_hover_enter(icon.unit_id, icon.entry_index)"
                                 data-event-mouseout="state_icon_hover_exit(icon.unit_id, icon.entry_index)">
                                <div class="battle-state-icon-image" data-style-decorator="icon.icon_decorator">
                                    <span class="battle-state-icon-label" data-if="icon.short_label != ''">{{ icon.short_label }}</span>
                                </div>
                                <span class="battle-state-turns">{{ icon.turns_text }}</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="battle-state-tooltip" data-if="state_tooltip.visible && state_tooltip.active_unit_id == member.unit_id">
                    <div class="battle-state-tooltip-title">{{ state_tooltip.title }}</div>
                    <div class="battle-state-tooltip-turns">{{ state_tooltip.turns }}</div>
                    <div class="battle-state-tooltip-description">{{ state_tooltip.description }}</div>
                </div>
            </div>
        </div>

        <div id="battle-command-panel">
            <div id="battle-actions" data-if="actions_enabled">
                <div id="battle-party-command" data-if="party_command_visible">
                    <button class="battle-text-button tf-nav-auto battle-party-command-button"
                            data-for="command : party_commands"
                            id="battle-party-command-{{ command.entry_index }}"
                            data-class-disabled="!command.enabled"
                            data-attrif-disabled="!command.enabled"
                            data-event-click="party_command_select(command.entry_index)"><span class="battle-cursor">&gt;</span>{{ command.label }}</button>
                </div>

                <div id="battle-actor-command" data-if="actor_command_visible">
                    <button class="battle-text-button tf-nav-auto battle-actor-command-button"
                            data-for="command : actor_commands"
                            id="battle-actor-command-{{ command.entry_index }}"
                            data-class-disabled="!command.enabled"
                            data-attrif-disabled="!command.enabled"
                            data-event-click="actor_command_select(command.entry_index)"><span class="battle-cursor">&gt;</span>{{ command.label }}</button>
                </div>

                <div id="battle-list-menu" data-if="list_menu_visible">
                    <div id="battle-list-empty" data-if="list_empty">{{ list_empty_text }}</div>
                    <button class="battle-text-button tf-nav-auto battle-list-entry"
                            data-for="entry : list_entries"
                            id="battle-list-entry-{{ entry.entry_index }}"
                            data-class-disabled="!entry.enabled"
                            data-attrif-disabled="!entry.enabled"
                            data-event-click="list_entry_select(entry.entry_index)"><span class="battle-cursor">&gt;</span><span class="battle-entry-label">{{ entry.label }}</span><span class="battle-entry-sublabel">{{ entry.sublabel }}</span></button>
                </div>

                <div id="battle-target-menu" data-if="target_menu_visible">
                    <div id="battle-target-empty" data-if="target_empty">{{ target_empty_text }}</div>
                    <button class="battle-text-button tf-nav-auto battle-target-entry"
                            data-for="target : target_entries"
                            id="battle-target-entry-{{ target.entry_index }}"
                            data-class-disabled="!target.enabled"
                            data-attrif-disabled="!target.enabled"
                            data-class-is-ally="target.is_ally"
                            data-class-is-dead="target.is_dead"
                            data-event-click="target_entry_select(target.entry_index)"><span class="battle-cursor">&gt;</span><span class="battle-entry-label">{{ target.label }}</span><span class="battle-entry-sublabel">{{ target.sublabel }}</span></button>
                </div>
            </div>
        </div>
    </div>
</body>
</rml>
