body, div, h1, h2, h3, h4, p, hr {
    display: block;
}

/* 几何 / 布局; 颜色与文字效果通过 RML 上的 tf-scene-* utility 提供。
   position: absolute 来自 .tf-scene-panel utility。 */

/* 与其它弹出场景统一, 把世界 dusk 色调遮成 Tokyo Night 暗蓝。 */
#rest-overlay {
    background-color: #1a1b26c0;
}

#rest-panel {
    left: 168dp;
    top: 100dp;
    width: 272dp;
    height: 128dp;
    padding: 16dp;
}

#rest-title {
    width: 100%;
    height: 20dp;
    text-align: center;
    line-height: 20dp;
}

#rest-selector {
    margin-top: 16dp;
    width: 240dp;
    height: 32dp;
    margin-left: 16dp;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

#rest-hours {
    width: 176dp;
}

#rest-actions {
    margin-top: 16dp;
    width: 240dp;
    margin-left: 16dp;
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 12dp;
}

.rest-action-button {
    width: 128dp;
}
