body, div, h1, h2, h3, h4, p, hr {
    display: block;
}

/* 几何 / 布局; 颜色与文字效果通过 RML 上的 tf-scene-* utility 提供。
   position: absolute 来自 .tf-scene-panel utility。 */

/* 与其它弹出场景统一, 把世界 dusk 色调遮成 Tokyo Night 暗蓝。 */
#rest-overlay {
    background-color: #1a1b26c0;
}

#rest-panel {
    left: 136dp;
    top: 58dp;
    width: 368dp;
    height: 244dp;
    padding: 12dp;
}

#rest-title {
    width: 100%;
    height: 20dp;
    text-align: center;
    line-height: 20dp;
}

#rest-selector {
    margin-top: 8dp;
    margin-left: 12dp;
    width: 344dp;
    height: 32dp;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

#rest-hours {
    width: 280dp;
}

#rest-recovery-summary {
    margin-top: 8dp;
    margin-left: 12dp;
    width: 344dp;
    height: 16dp;
    line-height: 16dp;
    text-align: center;
}

#rest-preview-card {
    margin-top: 8dp;
    margin-left: 12dp;
    width: 328dp;
    height: 86dp;
    padding: 8dp;
}

#rest-preview-empty {
    width: 328dp;
    height: 70dp;
    line-height: 70dp;
    text-align: center;
    color: #7888bd;
    font-size: 0.625rem;
}

#rest-member-list {
    width: 328dp;
    height: 70dp;
}

.rest-member-row {
    width: 328dp;
    height: 17dp;
    display: flex;
    flex-direction: row;
    align-items: center;
}

.rest-member-name {
    width: 62dp;
    height: 17dp;
    line-height: 17dp;
    color: #ffffff;
    font-size: 0.625rem;
    font-effect: shadow(1dp 1dp #000000cc);
}

.rest-stat-text {
    height: 17dp;
    line-height: 17dp;
    color: #f7f7f7;
    font-size: 0.5625rem;
    font-effect: shadow(1dp 1dp #000000cc);
}

.rest-hp-text {
    width: 144dp;
}

.rest-mp-text {
    width: 122dp;
}

#rest-actions {
    margin-top: 10dp;
    margin-left: 12dp;
    width: 344dp;
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 12dp;
}

.rest-action-button {
    width: 126dp;
}
