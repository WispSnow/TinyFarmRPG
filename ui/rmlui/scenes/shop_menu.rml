<rml>
<head>
    <link type="text/rcss" href="../theme/base.rcss"/>
    <link type="text/rcss" href="../theme/reset.rcss"/>
    <link type="text/rcss" href="../theme/modal.rcss"/>
    <link type="text/rcss" href="../theme/nav.rcss"/>
    <link type="text/rcss" href="../theme/spritesheet.rcss"/>
    <link type="text/rcss" href="../theme/menu_widgets.rcss"/>
    <link type="text/rcss" href="shop_menu.rcss"/>
</head>
<body class="tf-screen-root tf-nav-root" data-model="shop_menu">
    <div id="shop-overlay" class="tf-modal-overlay"></div>

    <div id="shop-panel">
        <!-- Header -->
        <div id="shop-header">
            <div id="shop-title">{{ shop_title }}</div>
            <div id="shop-gold">{{ gold_label }}</div>
        </div>
        <div id="shop-greeting">{{ shop_greeting }}</div>

        <!-- Body: two columns -->
        <div id="shop-body">
            <!-- Left: mode toggle + item list -->
            <div id="shop-list-col">
                <div id="shop-mode-toggle" data-class-focused="is_mode_toggle_focused">
                    <button id="shop-mode-buy"
                            class="tf-nav-auto tf-focus-ring-gold shop-tab-btn shop-mode-button"
                            data-class-selected="is_buy_mode"
                            data-event-click="switch_mode_buy"
                            data-i18n="shop.mode.buy">Buy</button>
                    <button id="shop-mode-sell"
                            class="tf-nav-auto tf-focus-ring-gold shop-tab-btn shop-mode-button"
                            data-class-selected="is_sell_mode"
                            data-event-click="switch_mode_sell"
                            data-i18n="shop.mode.sell">Sell</button>
                </div>

                <div id="shop-category-tabs" data-class-focused="is_category_tabs_focused">
                    <button id="shop-category-consumable"
                            class="tf-nav-auto tf-focus-ring-gold shop-tab-btn shop-category-button"
                            data-class-selected="is_consumable_category"
                            data-event-click="switch_category_consumable"
                            data-i18n="shop.category.consumable">Consumable</button>
                    <button id="shop-category-equipment"
                            class="tf-nav-auto tf-focus-ring-gold shop-tab-btn shop-category-button"
                            data-class-selected="is_equipment_category"
                            data-event-click="switch_category_equipment"
                            data-i18n="shop.category.equipment">Equipment</button>
                </div>

                <div class="shop-empty-text" data-if="is_buy_mode &amp;&amp; !has_buy_entries">{{ empty_text }}</div>
                <div class="shop-empty-text" data-if="is_sell_mode &amp;&amp; !has_sell_entries">{{ empty_text }}</div>

                <div id="shop-buy-list" data-if="is_buy_mode &amp;&amp; has_buy_entries" data-class-focused="is_entry_list_focused">
                    <div class="shop-entry-row" data-for="entry : buy_entries">
                        <button class="shop-entry shop-buy-entry"
                                data-attr-data-shop-index="entry.index"
                                data-class-selected="entry.is_selected"
                                data-class-disabled="entry.is_disabled"
                                data-attrif-disabled="entry.is_disabled"
                                data-event-click="buy_entry_select">
                            <div class="shop-entry-icon" data-style-decorator="entry.icon_decorator"></div>
                            <div class="shop-entry-name" data-rml="entry.item_name"></div>
                            <div class="shop-entry-price">{{ entry.price_text }}</div>
                        </button>
                    </div>
                </div>

                <div id="shop-sell-list" data-if="is_sell_mode &amp;&amp; has_sell_entries" data-class-focused="is_entry_list_focused">
                    <div class="shop-entry-row" data-for="entry : sell_entries">
                        <button id="shop-sell-entry-{{ entry.slot_index }}"
                                class="shop-entry shop-sell-entry"
                                data-attr-data-shop-index="entry.index"
                                data-class-selected="entry.is_selected"
                                data-class-disabled="entry.is_disabled"
                                data-event-click="sell_entry_select">
                            <div class="shop-entry-icon" data-style-decorator="entry.icon_decorator"></div>
                            <div class="shop-entry-name" data-rml="entry.item_name"></div>
                            <div class="shop-entry-price">{{ entry.price_text }}</div>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Right: detail + actions -->
            <div id="shop-detail-col">
                <div id="shop-detail-name">{{ detail_name }}</div>
                <div id="shop-detail-desc">{{ detail_description }}</div>

                <div id="shop-detail-divider"></div>

                <div id="shop-detail-info">
                    <div class="shop-info-row">
                        <div class="shop-info-label" data-i18n="shop.detail.price">Price</div>
                        <div class="shop-info-value">{{ detail_price_text }}</div>
                    </div>
                    <div class="shop-info-row">
                        <div class="shop-info-label">{{ detail_owned_label }}</div>
                        <div class="shop-info-value">{{ detail_owned_text }}</div>
                    </div>
                    <div class="shop-info-row">
                        <div class="shop-info-label" data-i18n="shop.detail.total">Total</div>
                        <div class="shop-info-value">{{ detail_total_text }}</div>
                    </div>
                    <div class="shop-info-row">
                        <div class="shop-info-label" data-i18n="shop.detail.after">After</div>
                        <div class="shop-info-value">{{ detail_after_gold_text }}</div>
                    </div>
                </div>

                <div id="shop-quantity-controls" data-class-focused="is_quantity_focused">
                    <button id="shop-qty-down"
                            class="tf-icon-button icon-arrow-left-light shop-qty-btn shop-qty-button"
                            data-class-disabled="!quantity_decrease_enabled"
                            data-attrif-disabled="!quantity_decrease_enabled"
                            data-event-click="adjust_quantity(-1)"></button>
                    <div id="shop-qty-readout">{{ detail_quantity_text }}</div>
                    <button id="shop-qty-up"
                            class="tf-icon-button icon-arrow-right-light shop-qty-btn shop-qty-button"
                            data-class-disabled="!quantity_increase_enabled"
                            data-attrif-disabled="!quantity_increase_enabled"
                            data-event-click="adjust_quantity(1)"></button>
                </div>

                <div id="shop-actions">
                    <button id="shop-primary-action-button"
                            class="tf-button-light shop-action-btn shop-action-button"
                            data-class-focused="is_primary_action_focused"
                            data-class-disabled="!primary_action_enabled"
                            data-attrif-disabled="!primary_action_enabled"
                            data-event-click="confirm_trade">{{ primary_action_text }}</button>
                    <button class="tf-button-light shop-action-btn shop-action-button"
                            data-event-click="close"
                            data-i18n="shop.leave">Leave</button>
                </div>
            </div>
        </div>

        <!-- Status bar -->
        <div id="shop-status">{{ status_text }}</div>
    </div>
</body>
</rml>
