<rml>
<head>
    <link type="text/rcss" href="../theme/base.rcss"/>
    <link type="text/rcss" href="../theme/reset.rcss"/>
    <link type="text/rcss" href="../theme/modal.rcss"/>
    <link type="text/rcss" href="../theme/nav.rcss"/>
    <link type="text/rcss" href="../theme/spritesheet.rcss"/>
    <link type="text/rcss" href="../theme/menu_widgets.rcss"/>
    <link type="text/rcss" href="../theme/overlay_scene.rcss"/>
    <link type="text/rcss" href="quest_offer.rcss"/>
</head>
<body class="tf-screen-root tf-nav-root" data-model="quest_offer">
    <div id="quest-offer-overlay" class="tf-modal-overlay"></div>

    <div id="quest-offer-panel" class="tf-scene-panel">
        <div id="quest-offer-speaker" class="tf-scene-title-gold">{{ speaker_text }}</div>
        <div id="quest-offer-line" class="tf-scene-title">{{ offer_text }}</div>

        <div id="quest-offer-card" class="tf-scene-card-frame">
            <div id="quest-offer-title" class="tf-scene-title">{{ quest_title }}</div>
            <div id="quest-offer-description" class="tf-scene-description">{{ quest_description }}</div>

            <div class="quest-offer-section tf-scene-info-row">
                <div class="quest-offer-label tf-scene-info-label" data-i18n="quest_offer.objective">Objective</div>
                <div class="quest-offer-value">{{ objectives_text }}</div>
            </div>

            <div class="quest-offer-section tf-scene-info-row">
                <div class="quest-offer-label tf-scene-info-label" data-i18n="quest_offer.reward">Reward</div>
                <div class="quest-offer-value">{{ rewards_text }}</div>
            </div>
        </div>

        <div id="quest-offer-actions">
            <button id="quest-offer-accept-button"
                    class="tf-button-light quest-offer-action-button"
                    data-event-click="accept"
                    data-i18n="quest_offer.accept">Accept</button>
            <button id="quest-offer-decline-button"
                    class="tf-button-light quest-offer-action-button"
                    data-event-click="decline"
                    data-i18n="quest_offer.decline">Decline</button>
        </div>
    </div>
</body>
</rml>
