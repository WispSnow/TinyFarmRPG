<rml>
<head>
    <link type="text/rcss" href="../theme/base.rcss"/>
    <link type="text/rcss" href="../theme/reset.rcss"/>
    <link type="text/rcss" href="../theme/modal.rcss"/>
    <link type="text/rcss" href="../theme/nav.rcss"/>
    <link type="text/rcss" href="../theme/spritesheet.rcss"/>
    <link type="text/rcss" href="../theme/menu_widgets.rcss"/>
    <link type="text/rcss" href="../theme/overlay_scene.rcss"/>
    <link type="text/rcss" href="appearance_customize.rcss"/>
</head>
<body class="tf-screen-root tf-nav-root" data-model="appearance_customize">
    <div id="appearance-overlay" class="tf-modal-overlay"></div>

    <div id="appearance-layout">
        <div id="appearance-left-column">
            <div id="appearance-left-header">
                <div id="appearance-title">{{ title_text }}</div>
                <div id="appearance-name-row" data-if="show_name_input">
                    <div id="appearance-name-label"
                         data-i18n="appearance.name_label">Name:</div>
                    <input id="appearance-name-input"
                           type="text"
                           data-value="player_name"
                           maxlength="16"/>
                </div>
                <div id="appearance-subtitle" data-if="!show_name_input">{{ subtitle_text }}</div>
            </div>

            <div id="appearance-preview-frame">
                <img id="appearance-portrait-preview"
                     data-if="portrait_src != ''"
                     data-attr-src="portrait_src"/>
            </div>
        </div>

        <div id="appearance-panel">
            <div id="appearance-slot-list" class="tf-scene-scroll">
                <div class="appearance-slot-row" data-for="slot : slots">
                    <div class="appearance-slot-label">{{ slot.label }}</div>
                    <button class="tf-icon-button icon-arrow-left-light appearance-step-button"
                            data-event-click="slot_prev(slot.slot_index)"></button>
                    <div class="appearance-slot-value">
                        <div class="appearance-variant-name">{{ slot.variant_label }}</div>
                        <div class="appearance-variant-index">{{ slot.index_label }}</div>
                    </div>
                    <button class="tf-icon-button icon-arrow-right-light appearance-step-button"
                            data-event-click="slot_next(slot.slot_index)"></button>
                </div>
            </div>

            <div id="appearance-tool-actions">
                <button id="appearance-random-button"
                        class="tf-button-light appearance-tool-button"
                        data-event-click="randomize"
                        data-i18n="appearance.random">Random</button>
                <button id="appearance-reset-button"
                        class="tf-button-light appearance-tool-button"
                        data-event-click="reset"
                        data-i18n="appearance.reset">Reset</button>
            </div>

            <div id="appearance-main-actions">
                <button id="appearance-confirm-button"
                        class="tf-button-light appearance-main-button"
                        data-event-click="confirm"
                        data-i18n="common.confirm">Confirm</button>
                <button id="appearance-cancel-button"
                        class="tf-button-light appearance-main-button"
                        data-event-click="cancel"
                        data-i18n="common.cancel">Cancel</button>
            </div>
        </div>
    </div>
</body>
</rml>
