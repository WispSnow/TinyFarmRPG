#save-slot-panel {
    left: 132dp;
    top: 32dp;
    width: 328dp;
    height: 248dp;
    padding: 24dp;
}

#save-slot-grid {
    width: 328dp;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8dp;
}

.save-slot-cell {
    width: 160dp;
}

.save-slot-button {
    width: 160dp;
    font-size: 12dp;
    white-space: nowrap;
    overflow: hidden;
}

#save-slot-back {
    margin-top: 24dp;
    margin-left: 84dp;
}

.save-slot-back-button {
    width: 160dp;
}

#save-slot-confirm-panel {
    left: 180dp;
    top: 110dp;
    width: 232dp;
    height: 92dp;
    padding: 24dp;
}

#save-slot-confirm-text {
    width: 100%;
    text-align: center;
    color: #ffffffff;
    font-effect: shadow(1dp 1dp #000000cc);
}

#save-slot-confirm-actions {
    position: absolute;
    left: 10dp;
    top: 60dp;
    width: 212dp;
    display: flex;
    flex-direction: row;
    gap: 12dp;
}

.save-slot-confirm-button {
    width: 100dp;
}
