body, div, h1, h2, h3, h4, p, hr {
    display: block;
}

body {
    margin: 0;
    width: 100%;
    height: 100%;
}

#slot-mask {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
}

#slot-panel {
    position: absolute;
    left: 120dp;
    top: 64dp;
    width: 400dp;
    padding: 20dp;
    background-color: #111827ee;
    border: 1dp #f8f4d0;
    border-radius: 8dp;
}

#slot-title {
    margin: 0 0 12dp 0;
    text-align: center;
    color: #f8f4d0;
}

#slot-grid {
    width: 100%;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8dp;
    margin-bottom: 16dp;
}

.slot-button {
    width: 196dp;
    height: 32dp;
    line-height: 32dp;
    padding: 0;
    background-color: #2a3348;
    border: 1dp #8ea8d6;
    color: #ffffff;
    text-align: center;
    cursor: pointer;
    font-size: 13dp;
}

.slot-button:hover {
    background-color: #3a4762;
}

.slot-button:active {
    background-color: #1f2736;
}

.slot-button.disabled {
    opacity: 0.45;
    pointer-events: none;
}

#slot-back {
    width: 160dp;
    height: 32dp;
    line-height: 32dp;
    padding: 0;
    margin-left: 120dp;
    background-color: #2a3348;
    border: 1dp #8ea8d6;
    color: #ffffff;
    text-align: center;
    cursor: pointer;
}

#slot-back:hover {
    background-color: #3a4762;
}

#slot-back:active {
    background-color: #1f2736;
}

#overwrite-layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    visibility: hidden;
    pointer-events: none;
}

#overwrite-layer.visible {
    visibility: visible;
    pointer-events: auto;
}

#overwrite-dialog {
    position: absolute;
    left: 180dp;
    top: 120dp;
    width: 280dp;
    padding: 20dp;
    background-color: #0b1220;
    border: 1dp #f8f4d0;
    border-radius: 8dp;
}

#overwrite-text {
    margin: 0 0 14dp 0;
    text-align: center;
    color: #f8f4d0;
}

#overwrite-actions {
    width: 100%;
    display: flex;
    flex-direction: row;
    gap: 12dp;
}

.confirm-button {
    width: 124dp;
    height: 32dp;
    line-height: 32dp;
    padding: 0;
    background-color: #2a3348;
    border: 1dp #8ea8d6;
    color: #ffffff;
    text-align: center;
    cursor: pointer;
}

.confirm-button:hover {
    background-color: #3a4762;
}

.confirm-button:active {
    background-color: #1f2736;
}

.confirm-button.secondary {
    border-color: #6b7280;
}
