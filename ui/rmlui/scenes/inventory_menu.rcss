/* ===========================================
 * Inventory Menu — RCSS
 * Two-column layout: inventory left, character right
 * =========================================== */

/* --- Spritesheets --- */

@spritesheet menu-inventory {
    src: ../../../assets/farm-rpg/UI/Inventory/inventory.png;
    menu-slot-bg:            7px  9px 18px 18px;
    menu-slot-bg-inner:      9px 11px 14px 14px;
    menu-slot-selected:      7px 41px 18px 18px;
    menu-slot-selected-inner: 9px 43px 14px 14px;
    menu-panel-bg:           0px 64px 48px 48px;
    menu-panel-bg-inner:    10px 74px 28px 28px;
    menu-equipment-slot-bg:        71px 41px 18px 18px;
    menu-equipment-slot-bg-inner:  74px 44px 12px 12px;
}

@spritesheet menu-banner {
    src: ../../../assets/farm-rpg/UI/Inventory/Banner.png;
    menu-party-card-bg:       67px  3px 42px 42px;
    menu-party-card-bg-inner: 76px 12px 24px 24px;
}

@spritesheet menu-armor {
    src: ../../../assets/farm-rpg/UI/Inventory/Slot Armor.png;
    equip-hat:        8px 40px 16px 16px;
    equip-shirt:     40px 40px 16px 16px;
    equip-pants:     72px 40px 16px 16px;
    equip-gloves:   104px 40px 16px 16px;
    equip-boots:    136px 40px 16px 16px;
    equip-necklace: 168px 40px 16px 16px;
    equip-ring:     200px 40px 16px 16px;
    equipment-slot-weapon-hint:    106px 41px 14px 15px;
    equipment-slot-head-hint:       11px 41px 12px 12px;
    equipment-slot-body-hint:       41px 42px 16px 11px;
    equipment-slot-boot-hint:      137px 41px 14px 14px;
    equipment-slot-accessory-hint: 170px 42px 12px 11px;
}

@spritesheet menu-hud {
    src: ../../../assets/farm-rpg/UI/HUD.png;
    tab-inventory:  48px 32px 16px 16px;
    tab-equipment:  96px 16px 16px 16px;
    tab-quests:    112px 32px 16px 16px;
    tab-map:        64px 32px 16px 16px;
    tab-options:   144px  0px 16px 16px;
    sort-icon:     368px 32px 16px 16px;
    sort-icon-pressed: 368px 48px 16px 16px;
    unequip-icon:  272px 64px 16px 16px;
    unequip-icon-pressed: 272px 80px 16px 16px;
    trash-closed:   64px  0px 16px 16px;
    trash-open:     80px  0px 16px 16px;
}

/* --- Overlay --- */

#menu-overlay {
    position: fixed;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: #1a1b26c0;
}

#tab-shortcut-tooltip-panel {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    width: auto;
    height: auto;
    padding: 4dp 6dp;
    decorator: ninepatch(tooltip-panel-bg, tooltip-panel-bg-inner, 1.0);
    z-index: 20;
    pointer-events: none;
}

#tab-shortcut-tooltip-text {
    display: inline-block;
    width: auto;
    height: auto;
    color: #2a1f17ff;
    font-size: 0.5625rem;
    line-height: 10dp;
    font-effect: shadow(1dp 1dp #ffffffcc);
    white-space: nowrap;
    pointer-events: none;
}

/* --- Menu Panel --- */

#menu-panel {
    position: fixed;
    left: 140dp;
    top: 68dp;
    width: 360dp;
    height: 238dp;
    decorator: ninepatch(menu-panel-bg, menu-panel-bg-inner, 1.0);
    padding: 10dp;
}

/* --- Tabset --- */

#menu-tabset {
    display: block;
    position: relative;
    width: 218dp;
}

#menu-tabset tabs {
    display: flex;
    flex-direction: row;
    gap: 6dp;
    height: 20dp;
    align-items: center;
    border-width: 0 0 1dp 0;
    border-color: #d9a88a66;
    padding: 0 0 4dp 0;
    margin-bottom: 8dp;
}

#menu-tabset panels,
#menu-tabset panel {
    display: block;
    width: 218dp;
}

#panel-inventory,
#panel-equipment {
    position: relative;
}

#menu-tabset tab {
    display: block;
}

.tab-icon {
    width: 20dp;
    height: 20dp;
    padding: 2dp;
    image-color: #d8dee9d0;
    transform: translateY(0);
    /* Keep pixel-art sprites on integer rows; animated Y translation can sample adjacent atlas rows. */
    transition: image-color 0.08s cubic-out;
}

#menu-tabset tab:selected {
    border-width: 0 0 2dp 0;
    border-color: #7aa2f7;
}

#tab-inventory  { decorator: image(tab-inventory); }
#tab-equipment  { decorator: image(tab-equipment); }
#tab-quests     { decorator: image(tab-quests); }
#tab-map        { decorator: image(tab-map); }
#tab-options    { decorator: image(tab-options); }

/* --- Two-Column Content --- */

#content-row {
    display: flex;
    flex-direction: row;
    gap: 10dp;
    height: 204dp;
}

#party-col {
    width: 112dp;
    height: 204dp;
}

#slot-region {
    position: relative;
    width: 218dp;
}

/* --- Hotbar Row --- */

#hotbar-grid {
    display: flex;
    flex-direction: row;
    gap: 2dp;
}

.hb-slot {
    width: 20dp;
    height: 20dp;
    decorator: ninepatch(menu-slot-selected, menu-slot-selected-inner, 1.0);
}

.hb-selected {
    box-shadow: #7aa2f7cc 0dp 0dp 0dp 1dp;
}

.hb-slot-drag-proxy:drag {
    opacity: 0.5;
}

.inv-slot-icon {
    position: absolute;
    left: 2dp;
    top: 2dp;
    width: 16dp;
    height: 16dp;
}

.inv-slot-count {
    position: absolute;
    left: 0;
    top: 0;
    width: 20dp;
    height: 20dp;
    text-align: right;
    vertical-align: bottom;
    font-size: 0.5rem;
    color: #ffffff;
    font-effect: shadow(1dp 1dp #000000cc);
    line-height: 20dp;
    padding: 0 1dp 0 0;
}

.hb-slot-index {
    position: absolute;
    left: 1dp;
    top: 0;
    font-size: 0.375rem;
    color: #ffffffaa;
    font-effect: shadow(1dp 1dp #000000aa);
}

.hb-active {
    box-shadow: #e0af68ff 0dp 0dp 0dp 1dp;
}

/* --- Backpack Area --- */

#backpack-area {
    margin-top: 4dp;
}

#backpack-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    width: 218dp;
    gap: 2dp;
}

/* --- Backpack Slot --- */

.bp-slot {
    width: 20dp;
    height: 20dp;
    decorator: ninepatch(menu-slot-bg, menu-slot-bg-inner, 1.0);
}

.bp-selected {
    decorator: ninepatch(menu-slot-selected, menu-slot-selected-inner, 1.0);
    box-shadow: #7aa2f7cc 0dp 0dp 0dp 1dp;
}

.bp-slot-drag-proxy:drag {
    opacity: 0.5;
}

/* --- Tab Actions --- */

#inventory-actions {
    position: absolute;
    right: 0;
    top: -32dp;
    width: 46dp;
    height: 20dp;
    display: flex;
    flex-direction: row;
    gap: 6dp;
    z-index: 6;
}

#sort-btn {
    width: 20dp;
    height: 20dp;
    padding: 2dp;
    decorator: image(sort-icon);
    image-color: #d8dee9d0;
    filter: saturate(0.8) brightness(0.95);
    transform: translateY(0);
    transition: transform 0.08s cubic-out, image-color 0.08s cubic-out, filter 0.08s cubic-out;
}

.tf-input-mouse #sort-btn:hover,
.tf-input-nav #sort-btn:focus {
    filter: saturate(1.2) brightness(1.08);
}

.tf-input-mouse #sort-btn:hover:active,
.tf-input-nav #sort-btn:focus:active,
#sort-btn:active {
    decorator: image(sort-icon-pressed);
    filter: saturate(1.0) brightness(0.85);
}

#trash-btn {
    width: 20dp;
    height: 20dp;
    padding: 2dp;
    decorator: image(trash-closed);
    image-color: #d8dee9d0;
    filter: saturate(0.8) brightness(0.95);
    transform: translateY(0);
    transition: transform 0.08s cubic-out, image-color 0.08s cubic-out, filter 0.08s cubic-out;
}

.tf-input-mouse #trash-btn:hover,
.tf-input-nav #trash-btn:focus {
    decorator: image(trash-open);
    filter: saturate(1.2) brightness(1.08);
}

.placeholder-panel {
    height: 154dp;
    text-align: center;
}

.placeholder-title {
    margin-top: 48dp;
    color: #a9b1d6;
    font-size: 0.75rem;
    font-effect: shadow(1dp 1dp #000000cc);
}

/* --- Equipment Panel --- */

#equipment-content {
    position: relative;
    width: 218dp;
    height: 172dp;
}

#equipment-header {
    height: 24dp;
    border-width: 0 0 1dp 0;
    border-color: #d9a88a44;
}

#equipment-actor-name {
    font-size: 0.6875rem;
    color: #ffffff;
    font-effect: shadow(1dp 1dp #000000cc);
}

#equipment-actor-summary {
    margin-top: 2dp;
    font-size: 0.5rem;
    color: #a9b1d6;
}

#equipment-main-row {
    display: block;
    margin-top: 5dp;
    height: 142dp;
}

#equipment-slot-list {
    display: flex;
    flex-direction: row;
    width: 174dp;
    height: 28dp;
}

.equipment-slot-entry {
    display: block;
    position: relative;
    width: 28dp;
    height: 28dp;
    decorator: ninepatch(menu-equipment-slot-bg, menu-equipment-slot-bg-inner, 1.0);
    border: 1dp #00000000;
    color: #f7f7f7;
    opacity: 0.78;
}

.equipment-slot-entry + .equipment-slot-entry {
    margin-left: 4dp;
}

.equipment-slot-entry.has-item {
    opacity: 1;
}

.equipment-slot-selected {
    decorator: ninepatch(menu-equipment-slot-bg, menu-equipment-slot-bg-inner, 1.0);
    border: 1dp #7aa2f7;
    box-shadow: #7aa2f7cc 0dp 0dp 0dp 1dp;
}

.equipment-slot-placeholder {
    position: absolute;
    left: 6dp;
    top: 6dp;
    width: 16dp;
    height: 16dp;
    opacity: 0.3;
}

.equipment-slot-icon {
    position: absolute;
    left: 2dp;
    top: 2dp;
    width: 24dp;
    height: 24dp;
}

#equipment-candidate-panel {
    width: 218dp;
    height: 108dp;
    margin-top: 6dp;
    overflow-y: auto;
    overflow-x: hidden;
}

#equipment-candidate-panel scrollbarvertical {
    width: 4dp;
    scrollbar-margin: 0dp;
}

#equipment-candidate-panel scrollbarvertical slidertrack {
    background-color: #d9a88a33;
    border-width: 0dp;
    border-color: #00000000;
}

#equipment-candidate-panel scrollbarvertical sliderbar {
    background-color: #b56f5ddd;
    border-width: 0dp;
    border-color: #00000000;
}

.equipment-candidate-entry {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 206dp;
    min-height: 22dp;
    padding: 2dp;
    background-color: #00000000;
    border: 1dp #d9a88a66;
    color: #f7f7f7;
}

.equipment-candidate-entry + .equipment-candidate-entry {
    margin-top: 2dp;
}

.tf-input-mouse .equipment-candidate-entry:hover,
.tf-input-nav .equipment-candidate-entry:focus,
.tf-input-mouse .equipment-slot-entry:hover,
.tf-input-nav .equipment-slot-entry:focus {
    border: 1dp #e0af68;
}

.equipment-candidate-icon {
    width: 16dp;
    height: 16dp;
}

.equipment-candidate-text {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-left: 6dp;
    width: 182dp;
    gap: 4dp;
}

.equipment-candidate-name {
    width: 82dp;
    font-size: 0.625rem;
    color: #ffffff;
    text-align: left;
}

.equipment-candidate-delta {
    width: 96dp;
    font-size: 0.5625rem;
    color: #9ece6a;
    text-align: right;
    white-space: normal;
    word-break: normal;
}

#equipment-candidate-empty {
    margin-top: 44dp;
    text-align: center;
    color: #a9b1d6;
    font-size: 0.625rem;
}

#equipment-detail {
    position: absolute;
    left: 0;
    top: 172dp;
    width: 218dp;
    height: 28dp;
    border-width: 1dp 0 0 0;
    border-color: #d9a88a44;
    padding-top: 3dp;
}

#equipment-detail-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    width: 218dp;
    height: 11dp;
}

#equipment-detail-title {
    width: 126dp;
    font-size: 0.625rem;
    color: #ffffff;
    font-effect: shadow(1dp 1dp #000000cc);
}

#equipment-detail-category {
    width: 80dp;
    font-size: 0.5625rem;
    color: #6f78a8;
    text-align: right;
}

#equipment-detail-description {
    margin-top: 1dp;
    width: 218dp;
    font-size: 0.625rem;
    line-height: 10dp;
    color: #5c6aa0;
}

#equipment-unequip-btn {
    position: absolute;
    left: 198dp;
    top: 33dp;
    width: 20dp;
    height: 20dp;
    padding: 2dp;
    decorator: image(unequip-icon);
    image-color: #d8dee9d0;
    border: 1dp #00000000;
    filter: saturate(0.8) brightness(0.95);
    transition: image-color 0.08s cubic-out, filter 0.08s cubic-out;
}

.tf-input-mouse #equipment-unequip-btn:hover,
.tf-input-nav #equipment-unequip-btn:focus {
    border: 1dp #f7768e;
    filter: saturate(1.2) brightness(1.08);
}

.tf-input-mouse #equipment-unequip-btn:hover:active,
.tf-input-nav #equipment-unequip-btn:focus:active,
#equipment-unequip-btn:active {
    decorator: image(unequip-icon-pressed);
    filter: saturate(1.0) brightness(0.85);
}

/* --- Quest Panel --- */

#quests-content {
    width: 218dp;
    height: 154dp;
    overflow-y: auto;
    padding-right: 2dp;
}

.quest-section + .quest-section {
    margin-top: 10dp;
    padding-top: 8dp;
    border-width: 1dp 0 0 0;
    border-color: #d9a88a44;
}

.quest-section-title {
    font-size: 0.6875rem;
    color: #ffffff;
    font-effect: shadow(1dp 1dp #000000cc);
}

.quest-empty {
    margin-top: 6dp;
    color: #a9b1d6;
    font-size: 0.625rem;
}

.quest-list {
    margin-top: 6dp;
}

.quest-entry {
    padding: 6dp;
    background-color: #24283bcc;
    border: 1dp #414868;
}

.quest-entry + .quest-entry {
    margin-top: 4dp;
}

.quest-entry-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    gap: 6dp;
}

.quest-title {
    width: 136dp;
    font-size: 0.625rem;
    color: #f7f7f7;
    font-effect: shadow(1dp 1dp #000000aa);
}

.quest-status {
    width: 56dp;
    text-align: right;
    font-size: 0.5625rem;
    color: #e0af68;
}

.quest-description {
    margin-top: 3dp;
    font-size: 0.5625rem;
    color: #a9b1d6;
}

.quest-progress {
    margin-top: 4dp;
    font-size: 0.5625rem;
    color: #7888bd;
    white-space: pre-wrap;
}

.quest-entry-completed .quest-status {
    color: #7dcfff;
}

/* --- Map Panel --- */

#map-content {
    position: relative;
    width: 218dp;
    height: 172dp;
}

#map-title {
    height: 13dp;
    font-size: 0.6875rem;
    color: #ffffff;
    font-effect: shadow(1dp 1dp #000000cc);
}

#map-preview-frame {
    position: absolute;
    left: 0;
    top: 19dp;
    width: 218dp;
    height: 126dp;
    overflow: hidden;
    background-color: #24283b99;
    border: 1dp #d9a88a66;
}

#map-preview-image {
    display: block;
    position: absolute;
}

.map-marker {
    position: absolute;
    padding: 0;
    border-width: 0;
    border-color: transparent;
    background-color: transparent;
    image-color: #ffffffff;
    filter: saturate(0.95) brightness(0.98);
    transition: filter 0.08s cubic-out, image-color 0.08s cubic-out;
}

.map-marker-player {
    image-color: #ffffffff;
}

.map-marker-quest-offer {
    image-color: #fce97fff;
}

.map-marker-quest-objective {
    image-color: #7dcfffff;
}

.map-marker-quest-turn-in {
    image-color: #ffd166ff;
    box-shadow: #ffd16666 0dp 0dp 0dp 1dp;
}

.map-marker-shop {
    image-color: #9ece6aff;
}

.map-marker-rest {
    image-color: #7dcfffff;
}

.map-marker-npc {
    image-color: #c0caf5ff;
}

.map-marker-selected {
    filter: saturate(1.25) brightness(1.2);
    box-shadow: #fce97fcc 0dp 0dp 0dp 1dp;
}

.tf-input-mouse .map-marker:hover,
.tf-input-nav .map-marker:focus {
    filter: saturate(1.35) brightness(1.25);
}

#map-empty-label {
    margin-top: 54dp;
    text-align: center;
    color: #a9b1d6;
    font-size: 0.625rem;
}

#map-detail-panel {
    position: absolute;
    left: 0;
    top: 150dp;
    width: 218dp;
    height: 34dp;
}

#map-detail-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 218dp;
    height: 13dp;
    gap: 4dp;
}

#map-detail-title {
    width: 140dp;
    font-size: 0.625rem;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-effect: shadow(1dp 1dp #000000cc);
}

#map-detail-type {
    width: 74dp;
    font-size: 0.5625rem;
    color: #e0af68;
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

#map-detail-description {
    width: 218dp;
    height: 20dp;
    margin-top: 1dp;
    font-size: 0.625rem;
    line-height: 10dp;
    color: #7888bd;
    white-space: normal;
    word-break: normal;
}

#map-status {
    position: absolute;
    left: 0;
    top: 151dp;
    width: 218dp;
    height: 14dp;
    font-size: 0.625rem;
    color: #7888bd;
    text-align: center;
}

/* --- Action Menu --- */

#action-menu {
    position: absolute;
    width: 84dp;
    padding: 4dp;
    background-color: #1f2335f0;
    border: 1dp #7aa2f7;
    z-index: 8;
}

#action-menu-title {
    font-size: 0.5625rem;
    color: #7888bd;
    margin-bottom: 3dp;
    font-effect: shadow(1dp 1dp #000000cc);
}

.action-menu-entry {
    width: 100%;
    min-height: 16dp;
    padding: 2dp 4dp;
    background-color: #24283bcc;
    color: #f7f7f7;
    font-size: 0.5625rem;
    text-align: left;
}

.action-menu-entry + .action-menu-entry {
    margin-top: 2dp;
}

.tf-input-mouse .action-menu-entry:hover,
.tf-input-nav .action-menu-entry:focus {
    background-color: #414868;
}

.action-danger {
    color: #f7768e;
}

/* --- Detail Panel --- */

#detail-area {
    margin-top: 6dp;
}

#detail-name {
    font-size: 0.75rem;
    color: #ffffff;
    font-effect: shadow(1dp 1dp #000000cc);
}

#detail-category {
    font-size: 0.625rem;
    color: #a9b1d6;
    margin-top: 2dp;
}

#detail-description {
    font-size: 0.625rem;
    color: #7888bd;
    margin-top: 2dp;
}

/* --- Party Column --- */

.party-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 112dp;
    height: 49dp;
    padding: 2dp 4dp;
    decorator: ninepatch(menu-party-card-bg, menu-party-card-bg-inner, 1.0);
    border: 1dp #00000000;
    color: #f7f7f7;
}

.party-card + .party-card {
    margin-top: 2dp;
}

.party-selected {
    border: 1dp #7aa2f7;
}

.party-targetable {
    border: 1dp #9ece6a;
}

.party-empty {
    opacity: 0.45;
}

.tf-input-mouse .party-card:hover,
.tf-input-nav .party-card:focus {
    border: 1dp #e0af68;
}

.tf-input-mouse .party-card:hover:active,
.tf-input-nav .party-card:focus:active,
.party-card:active {
    border: 1dp #fce97f;
}

.party-portrait {
    width: 36dp;
    height: 36dp;
}

.party-copy {
    margin-left: 3dp;
    width: 65dp;
    height: 44dp;
    overflow: hidden;
}

.party-name {
    font-size: 0.6875rem;
    line-height: 11dp;
    color: #ffffff;
    font-effect: shadow(1dp 1dp #000000cc);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.party-meta {
    margin-top: 1dp;
    font-size: 0.625rem;
    line-height: 10dp;
    color: #a9b1d6;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.party-resource {
    margin-top: 1dp;
    font-size: 0.625rem;
    line-height: 10dp;
    color: #7888bd;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* --- Footer --- */

#menu-footer {
    position: absolute;
    left: 0;
    top: 172dp;
    width: 218dp;
    height: 14dp;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    border-width: 1dp 0 0 0;
    border-color: #d9a88a44;
    padding-top: 3dp;
}

#gold-label {
    font-size: 0.625rem;
    color: #e0af68;
    font-effect: shadow(1dp 1dp #000000cc);
}

#farm-label {
    font-size: 0.625rem;
    color: #a9b1d6;
    text-align: right;
}

/* --- Options tab --- */

#panel-options {
    display: block;
    padding: 12dp 0 0 4dp;
}

#options-content {
    display: flex;
    flex-direction: column;
    width: 206dp;
}

.options-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 206dp;
    height: 28dp;
    margin-bottom: 4dp;
}

.options-row-label {
    width: 100dp;
    height: 20dp;
    line-height: 20dp;
    color: #e0af68;
    font-size: 0.6875rem;
}

.options-control {
    width: 102dp;
    margin-left: 4dp;
}

.options-row-value {
    width: 32dp;
    height: 26dp;
    line-height: 26dp;
    text-align: center;
    color: #ffffff;
    font-size: 0.6875rem;
    font-effect: shadow(1dp 1dp #000000cc);
}

.options-stepper {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 26dp;
}

.options-stepper-btn {
    width: 24dp;
    height: 24dp;
}

.options-toggle {
    height: 24dp;
    line-height: 24dp;
    background-color: #2f3650cc;
    border-width: 1dp;
    border-color: #565f89;
    color: #ffffff;
    text-align: center;
    font-size: 0.6875rem;
    tab-index: auto;
    nav-up: auto;
    nav-down: auto;
}

.options-toggle.on {
    background-color: #9ece6acc;
    border-color: #9ece6a;
}

.options-toggle:hover {
    background-color: #44537b;
}

.options-toggle.on:hover {
    background-color: #b4d77c;
}

.options-toggle:focus {
    border-color: #7aa2f7;
}
