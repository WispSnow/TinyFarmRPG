/* ===========================================
 * Inventory Menu — RCSS
 * Two-column layout: inventory left, character right
 * =========================================== */

/* --- Spritesheets --- */

@spritesheet menu-inventory {
    src: ../../../assets/farm-rpg/UI/Inventory/inventory.png;
    menu-slot-bg:            7px  9px 18px 18px;
    menu-slot-bg-inner:      9px 11px 14px 14px;
    menu-slot-selected:      7px 41px 18px 18px;
    menu-slot-selected-inner: 9px 43px 14px 14px;
    menu-panel-bg:           0px 64px 48px 48px;
    menu-panel-bg-inner:    10px 74px 28px 28px;
    menu-eq-slot-bg:        49px 65px 14px 14px;
    menu-eq-slot-selected:  49px 81px 14px 14px;
}

@spritesheet menu-armor {
    src: ../../../assets/farm-rpg/UI/Inventory/Slot Armor.png;
    equip-hat:        8px 40px 16px 16px;
    equip-shirt:     40px 40px 16px 16px;
    equip-pants:     72px 40px 16px 16px;
    equip-gloves:   104px 40px 16px 16px;
    equip-boots:    136px 40px 16px 16px;
    equip-necklace: 168px 40px 16px 16px;
    equip-ring:     200px 40px 16px 16px;
}

@spritesheet menu-hud {
    src: ../../../assets/farm-rpg/UI/HUD.png;
    tab-inventory:  48px 32px 16px 16px;
    tab-equipment:  96px 16px 16px 16px;
    tab-quests:    112px 32px 16px 16px;
    tab-map:        64px 32px 16px 16px;
    tab-options:   144px  0px 16px 16px;
    trash-closed:   64px  0px 16px 16px;
    trash-open:     80px  0px 16px 16px;
}

@spritesheet menu-portrait {
    src: ../../../assets/farm-rpg/Character and Portrait/Portrait/Premade/1.png;
    portrait-default: 0px 0px 64px 64px;
}

/* --- Overlay --- */

#menu-overlay {
    position: fixed;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: #1a1b26c0;
}

/* --- Menu Panel --- */

#menu-panel {
    position: fixed;
    left: 140dp;
    top: 68dp;
    width: 360dp;
    height: 224dp;
    decorator: ninepatch(menu-panel-bg, menu-panel-bg-inner, 1.0);
    padding: 10dp;
}

/* --- Tabset --- */

#menu-tabset {
    display: block;
    position: relative;
    width: 218dp;
}

#menu-tabset tabs {
    display: flex;
    flex-direction: row;
    gap: 6dp;
    height: 20dp;
    align-items: center;
    border-width: 0 0 1dp 0;
    border-color: #d9a88a66;
    padding: 0 0 4dp 0;
    margin-bottom: 8dp;
}

#menu-tabset panels,
#menu-tabset panel {
    display: block;
    width: 218dp;
}

#menu-tabset tab {
    display: block;
}

.tab-icon {
    width: 20dp;
    height: 20dp;
    padding: 2dp;
    image-color: #d8dee9d0;
    filter: saturate(0.8) brightness(0.95);
    transform: translateY(0);
    transition: transform 0.08s cubic-out, image-color 0.08s cubic-out, filter 0.08s cubic-out;
}

#menu-tabset tab:selected {
    border-width: 0 0 2dp 0;
    border-color: #7aa2f7;
}

/* 尚未实现功能的占位标签页：可点击但给予视觉提示。
   实现完毕后移除此类即可，不影响其他样式。 */
.tab-placeholder {
    opacity: 0.55;
    filter: saturate(0.5) brightness(0.85);
}

#tab-inventory  { decorator: image(tab-inventory); }
#tab-equipment  { decorator: image(tab-equipment); }
#tab-quests     { decorator: image(tab-quests); }
#tab-map        { decorator: image(tab-map); }
#tab-options    { decorator: image(tab-options); }

.tf-input-mouse .tab-icon:hover,
.tf-input-nav .tab-icon:focus {
    filter: saturate(1.12) brightness(1.08);
}

/* --- Two-Column Content --- */

#content-row {
    display: flex;
    flex-direction: row;
    gap: 14dp;
}

#char-col {
    width: 108dp;
}

#slot-region {
    position: relative;
    width: 218dp;
}

/* --- Hotbar Row --- */

#hotbar-grid {
    display: flex;
    flex-direction: row;
    gap: 2dp;
}

.hb-slot {
    width: 20dp;
    height: 20dp;
    decorator: ninepatch(menu-slot-selected, menu-slot-selected-inner, 1.0);
}

.hb-selected {
    box-shadow: #7aa2f7cc 0dp 0dp 0dp 1dp;
}

.hb-slot-drag-proxy:drag {
    opacity: 0.5;
}

.inv-slot-icon {
    position: absolute;
    left: 2dp;
    top: 2dp;
    width: 16dp;
    height: 16dp;
}

.inv-slot-count {
    position: absolute;
    left: 0;
    top: 0;
    width: 20dp;
    height: 20dp;
    text-align: right;
    vertical-align: bottom;
    font-size: 8dp;
    color: #ffffff;
    font-effect: shadow(1dp 1dp #000000cc);
    line-height: 20dp;
    padding: 0 1dp 0 0;
}

.hb-slot-index {
    position: absolute;
    left: 1dp;
    top: 0;
    font-size: 6dp;
    color: #ffffffaa;
    font-effect: shadow(1dp 1dp #000000aa);
}

.hb-active {
    box-shadow: #e0af68ff 0dp 0dp 0dp 1dp;
}

/* --- Backpack Area --- */

#backpack-area {
    margin-top: 4dp;
}

#backpack-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    width: 218dp;
    gap: 2dp;
}

/* --- Backpack Slot --- */

.bp-slot {
    width: 20dp;
    height: 20dp;
    decorator: ninepatch(menu-slot-bg, menu-slot-bg-inner, 1.0);
}

.bp-selected {
    decorator: ninepatch(menu-slot-selected, menu-slot-selected-inner, 1.0);
    box-shadow: #7aa2f7cc 0dp 0dp 0dp 1dp;
}

.bp-slot-drag-proxy:drag {
    opacity: 0.5;
}

/* --- Tab Actions --- */

#inventory-actions {
    position: absolute;
    right: 0;
    top: 0;
    width: 62dp;
    height: 20dp;
    display: flex;
    flex-direction: row;
    gap: 6dp;
    z-index: 6;
}

#sort-btn {
    width: 36dp;
    height: 20dp;
    padding: 2dp 6dp;
    background-color: #2e3440cc;
    border: 1dp #7aa2f7;
    color: #f7f7f7;
    font-size: 9dp;
    text-align: center;
    vertical-align: middle;
}

.tf-input-mouse #sort-btn:hover,
.tf-input-nav #sort-btn:focus {
    background-color: #3b4252;
}

#trash-btn {
    width: 20dp;
    height: 20dp;
    padding: 2dp;
    decorator: image(trash-closed);
    image-color: #d8dee9d0;
    filter: saturate(0.8) brightness(0.95);
    transform: translateY(0);
    transition: transform 0.08s cubic-out, image-color 0.08s cubic-out, filter 0.08s cubic-out;
}

.tf-input-mouse #trash-btn:hover,
.tf-input-nav #trash-btn:focus {
    decorator: image(trash-open);
    filter: saturate(1.2) brightness(1.08);
}

.placeholder-panel {
    height: 154dp;
    text-align: center;
}

.placeholder-title {
    margin-top: 48dp;
    color: #a9b1d6;
    font-size: 12dp;
    font-effect: shadow(1dp 1dp #000000cc);
}

/* --- Action Menu --- */

#action-menu {
    position: absolute;
    width: 84dp;
    padding: 4dp;
    background-color: #1f2335f0;
    border: 1dp #7aa2f7;
    z-index: 8;
}

#action-menu-title {
    font-size: 9dp;
    color: #c0caf5;
    margin-bottom: 3dp;
    font-effect: shadow(1dp 1dp #000000cc);
}

.action-menu-entry {
    width: 100%;
    min-height: 16dp;
    padding: 2dp 4dp;
    background-color: #24283bcc;
    color: #f7f7f7;
    font-size: 9dp;
    text-align: left;
}

.action-menu-entry + .action-menu-entry {
    margin-top: 2dp;
}

.tf-input-mouse .action-menu-entry:hover,
.tf-input-nav .action-menu-entry:focus {
    background-color: #414868;
}

.action-danger {
    color: #f7768e;
}

/* --- Detail Panel --- */

#detail-area {
    margin-top: 6dp;
}

#detail-name {
    font-size: 12dp;
    color: #ffffff;
    font-effect: shadow(1dp 1dp #000000cc);
}

#detail-category {
    font-size: 10dp;
    color: #a9b1d6;
    margin-top: 2dp;
}

#detail-description {
    font-size: 10dp;
    color: #c0caf5;
    margin-top: 2dp;
}

/* --- Character Column --- */

#char-portrait {
    width: 64dp;
    height: 64dp;
    margin: 0 auto;
    decorator: image(portrait-default);
}

#char-info {
    text-align: center;
    margin-top: 4dp;
}

#char-name {
    font-size: 12dp;
    color: #ffffff;
    font-effect: shadow(1dp 1dp #000000cc);
}

#char-title {
    font-size: 10dp;
    color: #a9b1d6;
    margin-top: 2dp;
}

/* Equipment Grid (4 col × 2 row) */

#equip-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    width: 86dp;
    gap: 2dp;
    margin: 8dp auto 0 auto;
}

.eq-slot {
    width: 20dp;
    height: 20dp;
    position: relative;
    decorator: ninepatch(menu-slot-bg, menu-slot-bg-inner, 1.0);
    opacity: 0.6;
}

.eq-placeholder {
    position: absolute;
    left: 2dp;
    top: 2dp;
    width: 16dp;
    height: 16dp;
    opacity: 0.4;
}

#eq-hat    .eq-placeholder { decorator: image(equip-hat); }
#eq-shirt  .eq-placeholder { decorator: image(equip-shirt); }
#eq-pants  .eq-placeholder { decorator: image(equip-pants); }
#eq-boots  .eq-placeholder { decorator: image(equip-boots); }
#eq-neck   .eq-placeholder { decorator: image(equip-necklace); }
#eq-gloves .eq-placeholder { decorator: image(equip-gloves); }
#eq-ring1  .eq-placeholder { decorator: image(equip-ring); }
#eq-ring2  .eq-placeholder { decorator: image(equip-ring); }

/* Stats / Gold */

#char-stats {
    text-align: center;
    margin-top: 8dp;
}

#gold-label {
    font-size: 10dp;
    color: #e0af68;
    font-effect: shadow(1dp 1dp #000000cc);
}

#farm-label {
    font-size: 10dp;
    color: #a9b1d6;
    margin-top: 2dp;
}
