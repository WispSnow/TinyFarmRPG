/* ===========================================
 * Inventory Menu — RCSS
 * Stardew Valley 风格物品栏全屏菜单
 * =========================================== */

body, div, h1, h2, h3, h4, p, hr, button {
    display: block;
}

/* --- Spritesheets --- */

@spritesheet menu-inventory {
    src: ../../../assets/farm-rpg/UI/Inventory/inventory.png;
    menu-slot-bg:            7px  9px 18px 18px;
    menu-slot-bg-inner:      9px 11px 14px 14px;
    menu-slot-selected:      7px 41px 18px 18px;
    menu-slot-selected-inner: 9px 43px 14px 14px;
    menu-panel-bg:           0px 64px 48px 48px;
    menu-panel-bg-inner:    10px 74px 28px 28px;
    menu-eq-slot-bg:        49px 65px 14px 14px;
    menu-eq-slot-selected:  49px 81px 14px 14px;
}

@spritesheet menu-armor {
    src: ../../../assets/farm-rpg/UI/Inventory/Slot Armor.png;
    equip-hat:        8px 40px 16px 16px;
    equip-shirt:     40px 40px 16px 16px;
    equip-pants:     72px 40px 16px 16px;
    equip-gloves:   104px 40px 16px 16px;
    equip-boots:    136px 40px 16px 16px;
    equip-necklace: 168px 40px 16px 16px;
    equip-ring:     200px 40px 16px 16px;
}

@spritesheet menu-hud {
    src: ../../../assets/farm-rpg/UI/HUD.png;
    tab-inventory:  48px 32px 16px 16px;
    tab-equipment:  96px 16px 16px 16px;
    tab-quests:    112px 32px 16px 16px;
    tab-map:        64px 32px 16px 16px;
    tab-options:   144px  0px 16px 16px;
    trash-closed:   64px  0px 16px 16px;
    trash-open:     80px  0px 16px 16px;
}

@spritesheet menu-portrait {
    src: ../../../assets/farm-rpg/Character and Portrait/Portrait/Premade/1.png;
    portrait-default: 0px 0px 64px 64px;
}

/* --- Overlay --- */

#menu-overlay {
    position: fixed;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: #1a1b26c0;
}

/* --- Menu Panel --- */

#menu-panel {
    position: fixed;
    left: 100dp;
    top: 25dp;
    width: 440dp;
    height: 310dp;
    decorator: ninepatch(menu-panel-bg, menu-panel-bg-inner, 1.0);
    padding: 10dp;
}

/* --- Tab Bar --- */

#tab-bar {
    display: flex;
    flex-direction: row;
    gap: 6dp;
    height: 20dp;
    align-items: center;
}

.tab-icon {
    width: 20dp;
    height: 20dp;
    padding: 2dp;
    tab-index: auto;
    nav-up: auto;
    nav-down: auto;
    nav-left: auto;
    nav-right: auto;
}

.tab-icon:hover,
.tab-icon:focus {
    box-shadow: #fce97fff 0dp 0dp 0dp 1dp;
}

.tab-active {
    border-width: 0 0 2dp 0;
    border-color: #7aa2f7;
}

.tab-disabled {
    opacity: 0.4;
}

#tab-inventory  { decorator: image(tab-inventory); }
#tab-equipment  { decorator: image(tab-equipment); }
#tab-quests     { decorator: image(tab-quests); }
#tab-map        { decorator: image(tab-map); }
#tab-options    { decorator: image(tab-options); }

/* --- Separator --- */

.menu-separator {
    height: 1dp;
    margin: 4dp 0;
    background-color: #d9a88a66;
}

/* --- Hotbar Row --- */

#hotbar-area {
    margin-top: 4dp;
}

#hotbar-grid {
    display: flex;
    flex-direction: row;
    gap: 2dp;
}

.hb-slot {
    width: 20dp;
    height: 20dp;
    position: relative;
    decorator: ninepatch(menu-slot-selected, menu-slot-selected-inner, 1.0);
    tab-index: auto;
    nav-up: auto;
    nav-down: auto;
    nav-left: auto;
    nav-right: auto;
}

.hb-slot:focus {
    box-shadow: #7aa2f7cc 0dp 0dp 0dp 1dp;
}

.hb-slot-drag-proxy {
    position: absolute;
    left: 0;
    top: 0;
    width: 20dp;
    height: 20dp;
    drag: none;
    pointer-events: auto;
}

.hb-slot-drag-proxy.draggable {
    drag: clone;
    cursor: move;
}

.hb-slot-drag-proxy:drag {
    opacity: 0.5;
}

.hb-slot-icon {
    position: absolute;
    left: 2dp;
    top: 2dp;
    width: 16dp;
    height: 16dp;
    transform-origin: 50% 50%;
    transition: transform 0.08s cubic-out;
}

.hb-slot:hover .hb-slot-icon {
    transform: scale(1.15);
}

.hb-slot-count {
    display: none;
}

.has-count .hb-slot-count {
    display: block;
    position: absolute;
    left: 0;
    top: 0;
    width: 20dp;
    height: 20dp;
    text-align: right;
    vertical-align: bottom;
    font-size: 8dp;
    color: #ffffff;
    font-effect: shadow(1dp 1dp #000000cc);
    line-height: 20dp;
    padding: 0 1dp 0 0;
}

.hb-slot-index {
    position: absolute;
    left: 1dp;
    top: 0;
    font-size: 6dp;
    color: #ffffffaa;
    font-effect: shadow(1dp 1dp #000000aa);
}

.hb-active {
    box-shadow: #e0af68ff 0dp 0dp 0dp 1dp;
}

/* --- Backpack Area --- */

#backpack-area {
    display: flex;
    flex-direction: row;
    margin-top: 4dp;
}

#backpack-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    width: 218dp;
    gap: 2dp;
}

/* --- Backpack Slot --- */

.bp-slot {
    width: 20dp;
    height: 20dp;
    position: relative;
    decorator: ninepatch(menu-slot-bg, menu-slot-bg-inner, 1.0);
    tab-index: auto;
    nav-up: auto;
    nav-down: auto;
    nav-left: auto;
    nav-right: auto;
}

.bp-slot:focus {
    decorator: ninepatch(menu-slot-selected, menu-slot-selected-inner, 1.0);
    box-shadow: #7aa2f7cc 0dp 0dp 0dp 1dp;
}

.bp-slot-drag-proxy {
    position: absolute;
    left: 0;
    top: 0;
    width: 20dp;
    height: 20dp;
    drag: none;
    pointer-events: auto;
}

.bp-slot-drag-proxy.draggable {
    drag: clone;
    cursor: move;
}

.bp-slot-drag-proxy:drag {
    opacity: 0.5;
}

.bp-slot-icon {
    position: absolute;
    left: 2dp;
    top: 2dp;
    width: 16dp;
    height: 16dp;
    transform-origin: 50% 50%;
    transition: transform 0.08s cubic-out;
}

.bp-slot:hover .bp-slot-icon {
    transform: scale(1.15);
}

.bp-slot-count {
    display: none;
}

.has-count .bp-slot-count {
    display: block;
    position: absolute;
    left: 0;
    top: 0;
    width: 20dp;
    height: 20dp;
    text-align: right;
    vertical-align: bottom;
    font-size: 8dp;
    color: #ffffff;
    font-effect: shadow(1dp 1dp #000000cc);
    line-height: 20dp;
    padding: 0 1dp 0 0;
}

/* --- Trash Button --- */

#trash-btn {
    width: 20dp;
    height: 20dp;
    margin-left: 8dp;
    padding: 2dp;
    decorator: image(trash-closed);
    tab-index: auto;
    nav-up: auto;
    nav-down: auto;
    nav-left: auto;
    nav-right: auto;
}

#trash-btn:hover,
#trash-btn:focus {
    decorator: image(trash-open);
    box-shadow: #f7768ecc 0dp 0dp 0dp 1dp;
}

/* --- Character Area --- */

#char-area {
    display: flex;
    flex-direction: row;
    margin-top: 4dp;
    height: 80dp;
    align-items: flex-start;
}

/* Portrait */

#char-portrait {
    width: 64dp;
    height: 64dp;
    decorator: image(portrait-default);
}

/* Name / Title */

#char-info {
    display: flex;
    flex-direction: column;
    margin-left: 8dp;
    width: 120dp;
    justify-content: center;
}

#char-name {
    font-size: 16dp;
    color: #ffffff;
    font-effect: shadow(1dp 1dp #000000cc);
}

#char-title {
    font-size: 16dp;
    color: #a9b1d6;
    margin-top: 4dp;
}

/* Equipment Grid (2 col × 4 row) */

#equip-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    width: 42dp;
    gap: 2dp;
    margin-left: 8dp;
}

.eq-slot {
    width: 20dp;
    height: 20dp;
    position: relative;
    decorator: ninepatch(menu-slot-bg, menu-slot-bg-inner, 1.0);
    opacity: 0.6;
}

.eq-placeholder {
    position: absolute;
    left: 2dp;
    top: 2dp;
    width: 16dp;
    height: 16dp;
    opacity: 0.4;
}

#eq-hat   .eq-placeholder { decorator: image(equip-hat); }
#eq-neck  .eq-placeholder { decorator: image(equip-necklace); }
#eq-shirt .eq-placeholder { decorator: image(equip-shirt); }
#eq-gloves .eq-placeholder { decorator: image(equip-gloves); }
#eq-pants .eq-placeholder { decorator: image(equip-pants); }
#eq-ring1 .eq-placeholder { decorator: image(equip-ring); }
#eq-boots .eq-placeholder { decorator: image(equip-boots); }
#eq-ring2 .eq-placeholder { decorator: image(equip-ring); }

/* Stats / Gold */

#char-stats {
    display: flex;
    flex-direction: column;
    margin-left: 8dp;
    justify-content: center;
}

#gold-label {
    font-size: 16dp;
    color: #e0af68;
    font-effect: shadow(1dp 1dp #000000cc);
}

#farm-label {
    font-size: 16dp;
    color: #a9b1d6;
    margin-top: 4dp;
}
