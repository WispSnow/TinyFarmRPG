/* ===========================================
 * Appearance Customize — RCSS
 * Preview frame (left, transparent so the world-pass character shows
 * through) + ninepatch control panel (right). Title sits above both.
 * Logical screen: 640×360dp
 * =========================================== */

body, div, h1, h2, h3, h4, p, hr {
    display: block;
}

body {
    overflow: hidden;
    background-color: transparent;
}

#appearance-overlay {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: #00000099;
    pointer-events: auto;
}

/* ===== Header (no panel background) ===== */

#appearance-title {
    position: absolute;
    left: 30dp;
    top: 28dp;
    width: 240dp;
    height: 18dp;
    line-height: 18dp;
    color: #fce97fff;
    font-effect: shadow(1dp 1dp #000000cc);
}

#appearance-subtitle {
    position: absolute;
    left: 30dp;
    top: 52dp;
    width: 240dp;
    height: 14dp;
    line-height: 14dp;
    color: #a9b1d6ff;
    font-size: 0.625rem;
    font-effect: shadow(1dp 1dp #000000cc);
}

/* ===== Preview frame (transparent fill so the character shows through) ===== */

#appearance-preview-frame {
    position: absolute;
    left: 30dp;
    top: 78dp;
    width: 240dp;
    height: 232dp;
    border: 1dp #d9a88aaa;
    background-color: #00000044;
    pointer-events: auto;
}

#appearance-preview-label {
    position: absolute;
    left: 6dp;
    top: 6dp;
    color: #a9b1d6cc;
    font-size: 0.5625rem;
    font-effect: shadow(1dp 1dp #000000cc);
    pointer-events: none;
}

/* ===== Control panel (ninepatch on the right) ===== */

#appearance-panel {
    position: absolute;
    left: 290dp;
    top: 26dp;
    width: 320dp;
    height: 308dp;
    padding: 10dp;
    decorator: ninepatch(inventory-panel-bg, inventory-panel-bg-inner, 1.0);
    pointer-events: auto;
}

#appearance-slot-list {
    width: 100%;
}

.appearance-slot-row {
    width: 100%;
    height: 30dp;
    margin-bottom: 2dp;
    display: flex;
    flex-direction: row;
    align-items: center;
}

.appearance-slot-label {
    width: 70dp;
    height: 28dp;
    line-height: 28dp;
    color: #2a1f17ff;
    font-size: 0.6875rem;
    font-effect: shadow(1dp 1dp #ffffff44);
}

.appearance-step-button {
    /* Navigation tab-index comes from tf-icon-button. */
    width: 26dp;
    height: 26dp;
    nav-up: auto;
    nav-down: auto;
    nav-left: auto;
    nav-right: auto;
}

.appearance-slot-value {
    flex-grow: 1;
    height: 28dp;
    padding-left: 6dp;
    padding-right: 6dp;
}

.appearance-variant-name {
    width: 100%;
    height: 14dp;
    line-height: 14dp;
    color: #2a1f17ff;
    font-size: 0.6875rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.appearance-variant-index {
    width: 100%;
    height: 10dp;
    line-height: 10dp;
    color: #6f4f37cc;
    font-size: 0.5625rem;
}

#appearance-tool-actions {
    margin-top: 12dp;
    width: 100%;
    display: flex;
    flex-direction: row;
    gap: 10dp;
}

.appearance-tool-button {
    /* Navigation tab-index comes from tf-button-light. */
    width: 145dp;
    nav-up: auto;
    nav-down: auto;
    nav-left: auto;
    nav-right: auto;
}

#appearance-main-actions {
    margin-top: 6dp;
    width: 100%;
    display: flex;
    flex-direction: row;
    gap: 10dp;
}

.appearance-main-button {
    /* Navigation tab-index comes from tf-button-light. */
    width: 145dp;
    nav-up: auto;
    nav-down: auto;
    nav-left: auto;
    nav-right: auto;
}
