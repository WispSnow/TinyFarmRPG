/* ===========================================
 * Appearance Customize — RCSS
 * Preview frame (left, transparent so the world-pass character shows
 * through) + ninepatch control panel (right). Title sits above both.
 * Logical screen: 640×360dp
 * =========================================== */

body, div, h1, h2, h3, h4, p, hr {
    display: block;
}

img {
    display: block;
}

input {
    display: block;
}

body {
    overflow: hidden;
    background-color: transparent;
}

#appearance-overlay {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: transparent;
    pointer-events: auto;
}

/* ===== Header (no panel background) ===== */

#appearance-title {
    position: absolute;
    left: 42dp;
    top: 34dp;
    width: 220dp;
    height: 18dp;
    line-height: 18dp;
    color: #fce97fff;
    font-effect: shadow(1dp 1dp #000000cc);
}

#appearance-subtitle {
    position: absolute;
    left: 42dp;
    top: 60dp;
    width: 220dp;
    height: 14dp;
    line-height: 14dp;
    color: #a9b1d6ff;
    font-size: 0.625rem;
    font-effect: shadow(1dp 1dp #000000cc);
}

#appearance-name-label {
    position: absolute;
    left: 42dp;
    top: 58dp;
    width: 44dp;
    height: 20dp;
    line-height: 20dp;
    color: #6b4a3aff;
    font-size: 0.625rem;
    font-effect: shadow(1dp 1dp #ffffff44);
}

#appearance-name-input {
    position: absolute;
    left: 88dp;
    top: 58dp;
    width: 104dp;
    height: 20dp;
    padding-left: 5dp;
    padding-right: 5dp;
    line-height: 20dp;
    color: #2a1f17ff;
    background-color: #d9a88a33;
    border: 1dp #d9a88aaa;
    font-size: 0.625rem;
    font-effect: shadow(1dp 1dp #ffffff44);
    tab-index: auto;
    nav-up: auto;
    nav-down: auto;
    nav-left: auto;
    nav-right: auto;
}

#appearance-name-input:focus {
    border-color: #7aa2f7;
}

/* ===== Preview frame (transparent fill so the character shows through) ===== */

#appearance-preview-frame {
    position: absolute;
    left: 42dp;
    top: 104dp;
    width: 220dp;
    height: 204dp;
    border: 1dp #d9a88aaa;
    background-color: transparent;
    pointer-events: auto;
}

#appearance-portrait-preview {
    position: absolute;
    left: 14dp;
    top: 6dp;
    width: 192dp;
    height: 192dp;
    image-color: #ffffffff;
    pointer-events: none;
}

/* ===== Control panel (ninepatch on the right) ===== */

#appearance-panel-region {
    position: absolute;
    left: 292dp;
    top: 0;
    width: 312dp;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    pointer-events: none;
}

#appearance-panel {
    width: 292dp;
    height: auto;
    padding: 10dp;
    decorator: ninepatch(menu-party-card-bg, menu-party-card-bg-inner, 1.0);
    pointer-events: auto;
}

#appearance-slot-list {
    width: 100%;
}

.appearance-slot-row {
    width: 100%;
    height: 28dp;
    margin-bottom: 1dp;
    display: flex;
    flex-direction: row;
    align-items: center;
}

.appearance-slot-label {
    width: 70dp;
    height: 26dp;
    line-height: 26dp;
    color: #2a1f17ff;
    font-size: 0.6875rem;
    font-effect: shadow(1dp 1dp #ffffff44);
}

.appearance-step-button {
    /* Navigation tab-index comes from tf-icon-button. */
    width: 26dp;
    height: 26dp;
    nav-up: auto;
    nav-down: auto;
    nav-left: auto;
    nav-right: auto;
}

.appearance-slot-value {
    flex-grow: 1;
    height: 26dp;
    padding-left: 6dp;
    padding-right: 6dp;
    text-align: center;
}

.appearance-variant-name {
    width: 100%;
    height: 14dp;
    line-height: 14dp;
    text-align: center;
    color: #2a1f17ff;
    font-size: 0.6875rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.appearance-variant-index {
    width: 100%;
    height: 10dp;
    line-height: 10dp;
    text-align: center;
    color: #6f4f37cc;
    font-size: 0.5625rem;
}

#appearance-tool-actions {
    margin-top: 10dp;
    width: 100%;
    display: flex;
    flex-direction: row;
    gap: 8dp;
}

.appearance-tool-button {
    /* Navigation tab-index comes from tf-button-light. */
    width: 142dp;
    height: 30dp;
    line-height: 30dp;
    nav-up: auto;
    nav-down: auto;
    nav-left: auto;
    nav-right: auto;
}

#appearance-main-actions {
    margin-top: 5dp;
    width: 100%;
    display: flex;
    flex-direction: row;
    gap: 8dp;
}

.appearance-main-button {
    /* Navigation tab-index comes from tf-button-light. */
    width: 142dp;
    height: 30dp;
    line-height: 30dp;
    nav-up: auto;
    nav-down: auto;
    nav-left: auto;
    nav-right: auto;
}
