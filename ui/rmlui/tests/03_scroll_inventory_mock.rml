<rml>
<head>
    <link type="text/rcss" href="../theme/base.rcss"/>
    <link type="text/rcss" href="03_scroll_inventory_mock.rcss"/>
</head>
<body>
    <div id="screen">
        <div class="panel inv-panel">
            <div class="label-large">Inventory Mock</div>
            <div class="label-small">Scroll list and clipped rendering test.</div>
            <div class="divider"></div>

            <div id="list">
                <div class="row"><div class="slot"></div><div class="label item-name">Apple x03</div><button class="button row-btn">Use</button></div>
                <div class="row"><div class="slot"></div><div class="label item-name">Berry x11</div><button class="button row-btn">Use</button></div>
                <div class="row"><div class="slot"></div><div class="label item-name">Carrot x08</div><button class="button row-btn">Use</button></div>
                <div class="row"><div class="slot"></div><div class="label item-name">Corn x21</div><button class="button row-btn">Use</button></div>
                <div class="row"><div class="slot"></div><div class="label item-name">Egg x06</div><button class="button row-btn">Use</button></div>
                <div class="row"><div class="slot"></div><div class="label item-name">Fiber x14</div><button class="button row-btn">Use</button></div>
                <div class="row"><div class="slot"></div><div class="label item-name">Fish x02</div><button class="button row-btn">Use</button></div>
                <div class="row"><div class="slot"></div><div class="label item-name">Flour x09</div><button class="button row-btn">Use</button></div>
                <div class="row"><div class="slot"></div><div class="label item-name">Herb x17</div><button class="button row-btn">Use</button></div>
                <div class="row"><div class="slot"></div><div class="label item-name">Honey x04</div><button class="button row-btn">Use</button></div>
                <div class="row"><div class="slot"></div><div class="label item-name">Iron Ore x12</div><button class="button row-btn">Use</button></div>
                <div class="row"><div class="slot"></div><div class="label item-name">Milk x05</div><button class="button row-btn">Use</button></div>
                <div class="row"><div class="slot"></div><div class="label item-name">Potato x16</div><button class="button row-btn">Use</button></div>
                <div class="row"><div class="slot"></div><div class="label item-name">Tomato x07</div><button class="button row-btn">Use</button></div>
            </div>
        </div>
    </div>
</body>
</rml>
