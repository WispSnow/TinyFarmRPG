body {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
}

#fade-overlay {
    display: block;
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: #000000;
    opacity: 0;
    transition: opacity 0s linear-in-out;
    pointer-events: none;
}

#fade-overlay.is-opaque {
    opacity: 1;
}
