/* ===========================================
 * TinyFarm RmlUi Sprite Sheet Definitions
 * 统一引用现有 UI 图集
 * =========================================== */

/* --- 按钮图集 (button.png: 48x48, 3 states x 16px) --- */
@spritesheet ui-buttons {
    src: ../../../assets/farm-rpg/UI/button.png;
    btn-normal:  0px 0px  48px 16px;
    btn-hover:   0px 16px 48px 16px;
    btn-pressed: 0px 32px 48px 16px;

    primary-button:         0px 16px 48px 16px;
    primary-button-inner:   3px 21px 42px 6px;
    primary-button-pressed: 0px 32px 48px 16px;
    primary-button-pressed-inner: 3px 37px 42px 6px;

    secondary-button:         0px 64px 48px 16px;
    secondary-button-inner:   3px 69px 42px 6px;
    secondary-button-pressed: 0px 80px 48px 16px;
    secondary-button-pressed-inner: 3px 85px 42px 6px;

    menu-icon:         432px 208px 16px 16px;
    menu-icon-pressed: 432px 224px 16px 16px;

    volume-up-icon:         240px 16px 16px 16px;
    volume-up-icon-pressed: 240px 32px 16px 16px;
    volume-down-icon:         256px 16px 16px 16px;
    volume-down-icon-pressed: 256px 32px 16px 16px;

    arrow-left-icon:         384px 16px 16px 16px;
    arrow-left-icon-pressed: 384px 32px 16px 16px;
    arrow-right-icon:         368px 16px 16px 16px;
    arrow-right-icon-pressed: 368px 32px 16px 16px;
}

/* --- 物品栏槽位图集 (Slots.png) --- */
@spritesheet ui-slots {
    src: ../../../assets/farm-rpg/UI/Inventory/Slots.png;
    slot-normal:   0px 0px  16px 16px;
    slot-selected: 16px 0px 16px 16px;
    slot-locked:   32px 0px 16px 16px;
}

/* --- HUD 图集 (HUD.png) --- */
@spritesheet ui-hud {
    src: ../../../assets/farm-rpg/UI/HUD.png;
    hud-frame: 0px 0px 64px 32px;

    page-left-icon:         384px 0px 16px 16px;
    page-left-icon-pressed: 384px 16px 16px 16px;
    page-right-icon:         400px 0px 16px 16px;
    page-right-icon-pressed: 400px 16px 16px 16px;
}

/* --- 时钟 (Clock.png) --- */
@spritesheet ui-clock {
    src: ../../../assets/farm-rpg/UI/Clock/Clock.png;
    clock-face: 0px 0px 32px 32px;
}

/* --- 时钟指针 (clock hand.png: 8帧 x 32px) --- */
@spritesheet ui-clock-hand {
    src: ../../../assets/farm-rpg/UI/Clock/clock hand.png;
    clock-hand-0:   0px 0px 32px 32px;
    clock-hand-1:  32px 0px 32px 32px;
    clock-hand-2:  64px 0px 32px 32px;
    clock-hand-3:  96px 0px 32px 32px;
    clock-hand-4: 128px 0px 32px 32px;
    clock-hand-5: 160px 0px 32px 32px;
    clock-hand-6: 192px 0px 32px 32px;
    clock-hand-7: 224px 0px 32px 32px;
}

/* --- 时钟面板背景 (Extras.png, ninepatch 用 outer+inner) --- */
@spritesheet ui-clock-extras {
    src: ../../../assets/farm-rpg/UI/Clock/Extras.png;
    /* 背景面板 outer=全区域, inner=去掉九宫格边距(l1,t3,r1,b1) */
    clock-panel-bg:        66px 65px 59px 28px;
    clock-panel-bg-inner:  67px 68px 57px 24px;
    /* 标签背景 outer=全区域, inner=去掉九宫格边距(各1px) */
    clock-label-bg:        71px 99px 33px 10px;
    clock-label-bg-inner:  72px 100px 31px 8px;
}

/* --- 进度条 (Bars.png) --- */
@spritesheet ui-bars {
    src: ../../../assets/farm-rpg/UI/Bars.png;
    bar-bg:   0px 0px 48px 8px;
    bar-fill: 0px 8px 48px 8px;
}


/* --- 对话气泡 (dialogue box.png) --- */
@spritesheet ui-dialogue {
    src: ../../../assets/farm-rpg/UI/dialogue box.png;
    dialogue-bubble-bg:       0px 48px 48px 48px;
    dialogue-bubble-bg-inner: 3px 52px 42px 41px;
}

/* --- Tooltip 面板 (Inventory/Banner.png) --- */
@spritesheet ui-tooltip {
    src: ../../../assets/farm-rpg/UI/Inventory/Banner.png;
    tooltip-panel-bg:       3px 3px 42px 42px;
    tooltip-panel-bg-inner: 12px 12px 24px 24px;
}
