.tf-modal-overlay {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: #00000099;
    pointer-events: auto;
}

.tf-modal-panel {
    position: absolute;
    background-color: #000000bf;
    pointer-events: auto;
}

.tf-modal-panel-strong {
    position: absolute;
    background-color: #000000d9;
    pointer-events: auto;
}

.tf-fill-layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    pointer-events: auto;
}
