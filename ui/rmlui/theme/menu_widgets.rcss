button {
    margin: 0;
    padding: 0;
    background-color: transparent;
    border-width: 0;
    border-color: transparent;
    color: #ffffffff;
    font-family: "VonwaonBitmap 16px";
    font-size: 1rem;
    text-align: center;
    cursor: pointer;
    font-effect: shadow(1dp 1dp #000000cc);
}

.tf-button-primary,
.tf-button-secondary,
.tf-button-light,
.tf-icon-button {
    tab-index: auto;
    nav-up: auto;
    nav-down: auto;
    nav-left: auto;
    nav-right: auto;
    transform: translateY(0);
    transition: transform 0.08s cubic-out, color 0.08s cubic-out, image-color 0.08s cubic-out,
        filter 0.08s cubic-out;
}

.tf-button-primary,
.tf-button-secondary,
.tf-button-light {
    height: 32dp;
    line-height: 32dp;
}

.tf-button-primary {
    decorator: ninepatch(primary-button, primary-button-inner, 1.0);
}

.tf-input-mouse .tf-button-primary:hover,
.tf-input-nav .tf-button-primary:focus {
    transform: translateY(-1dp);
    color: #fce97fff;
}

.tf-input-mouse .tf-button-primary:hover:active,
.tf-input-nav .tf-button-primary:focus:active,
.tf-input-mouse .tf-button-primary:active,
.tf-input-nav .tf-button-primary:active,
.tf-button-primary:active {
    decorator: ninepatch(primary-button-pressed, primary-button-pressed-inner, 1.0);
    transform: translateY(1dp);
    color: #999999ff;
}

.tf-button-secondary {
    decorator: ninepatch(secondary-button, secondary-button-inner, 1.0);
}

.tf-input-mouse .tf-button-secondary:hover,
.tf-input-nav .tf-button-secondary:focus {
    transform: translateY(-1dp);
    color: #fce97fff;
}

.tf-input-mouse .tf-button-secondary:hover:active,
.tf-input-nav .tf-button-secondary:focus:active,
.tf-input-mouse .tf-button-secondary:active,
.tf-input-nav .tf-button-secondary:active,
.tf-button-secondary:active {
    decorator: ninepatch(secondary-button-pressed, secondary-button-pressed-inner, 1.0);
    transform: translateY(1dp);
    color: #999999ff;
}

.tf-button-primary.disabled,
.tf-button-primary:disabled,
.tf-button-secondary.disabled,
.tf-button-secondary:disabled {
    color: #666666ff;
    opacity: 0.75;
    transform: translateY(0);
}

.tf-button-light {
    decorator: ninepatch(light-button, light-button-inner, 1.0);
    color: #2a1f17ff;
    font-effect: shadow(1dp 1dp #ffffff66);
}

.tf-input-mouse .tf-button-light:hover,
.tf-input-nav .tf-button-light:focus {
    transform: translateY(-1dp);
    color: #8b4f1aff;
}

.tf-input-mouse .tf-button-light:hover:active,
.tf-input-nav .tf-button-light:focus:active,
.tf-input-mouse .tf-button-light:active,
.tf-input-nav .tf-button-light:active,
.tf-button-light:active {
    decorator: ninepatch(light-button-pressed, light-button-pressed-inner, 1.0);
    transform: translateY(1dp);
    color: #6b5544ff;
}

.tf-button-light.disabled,
.tf-button-light:disabled {
    color: #85705a99;
    opacity: 0.7;
    transform: translateY(0);
}

.tf-icon-button {
    width: 32dp;
    height: 32dp;
    image-color: #d8dee9d8;
    filter: saturate(0.75) brightness(0.95);
}

.tf-input-mouse .tf-icon-button:hover,
.tf-input-nav .tf-icon-button:focus {
    transform: translateY(-1dp);
    image-color: #fce97fff;
    filter: saturate(1.15) brightness(1.08);
}

.tf-input-mouse .tf-icon-button:hover:active,
.tf-input-nav .tf-icon-button:focus:active,
.tf-input-mouse .tf-icon-button:active,
.tf-input-nav .tf-icon-button:active,
.tf-icon-button:active {
    transform: translateY(1dp);
    image-color: #ffffffff;
    filter: saturate(1.0) brightness(0.85);
}

.tf-icon-button.icon-menu {
    decorator: image(menu-icon);
}

.tf-icon-button.icon-menu:active {
    decorator: image(menu-icon-pressed);
}

.tf-icon-button.icon-volume-up {
    decorator: image(volume-up-icon);
}

.tf-icon-button.icon-volume-up:active {
    decorator: image(volume-up-icon-pressed);
}

.tf-icon-button.icon-volume-down {
    decorator: image(volume-down-icon);
}

.tf-icon-button.icon-volume-down:active {
    decorator: image(volume-down-icon-pressed);
}

.tf-icon-button.icon-arrow-left {
    decorator: image(arrow-left-icon);
}

.tf-icon-button.icon-arrow-left:active {
    decorator: image(arrow-left-icon-pressed);
}

.tf-icon-button.icon-arrow-right {
    decorator: image(arrow-right-icon);
}

.tf-icon-button.icon-arrow-right:active {
    decorator: image(arrow-right-icon-pressed);
}

.tf-icon-button.icon-arrow-left-light {
    decorator: image(arrow-left-light-icon);
}

.tf-icon-button.icon-arrow-left-light:active {
    decorator: image(arrow-left-light-icon-pressed);
}

.tf-icon-button.icon-arrow-right-light {
    decorator: image(arrow-right-light-icon);
}

.tf-icon-button.icon-arrow-right-light:active {
    decorator: image(arrow-right-light-icon-pressed);
}

.tf-icon-button.icon-page-left {
    decorator: image(page-left-icon);
}

.tf-icon-button.icon-page-left:active {
    decorator: image(page-left-icon-pressed);
}

.tf-icon-button.icon-page-right {
    decorator: image(page-right-icon);
}

.tf-icon-button.icon-page-right:active {
    decorator: image(page-right-icon-pressed);
}

.tf-icon-button.disabled,
.tf-icon-button:disabled {
    opacity: 0.6;
    image-color: #9aa5b1b0;
    filter: saturate(0.4) brightness(0.7);
    transform: translateY(0);
}

.tf-value-label {
    width: 96dp;
    height: 32dp;
    line-height: 32dp;
    text-align: center;
    color: #ffffffff;
    font-effect: shadow(1dp 1dp #000000cc);
}
