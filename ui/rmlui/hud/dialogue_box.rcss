body, div, h1, h2, h3, h4, p, hr {
    display: block;
}

body {
    pointer-events: none;
}

#dialogue-box-panel {
    position: absolute;
    left: 20dp;
    bottom: 0dp;
    width: 600dp;
    height: 92dp;
    pointer-events: none;
}

#dialogue-box-bg {
    position: absolute;
    left: 0dp;
    top: 0dp;
    width: 600dp;
    height: 92dp;
    decorator: ninepatch(hud-dialogue-bg, hud-dialogue-bg-inner, 1.0);
    image-color: #ffffffff;
    background-color: #00000000;
    opacity: 0.92;
    pointer-events: none;
}

#dialogue-box-content {
    display: flex;
    flex-direction: row;
    align-items: center;
    position: absolute;
    left: 8dp;
    top: 8dp;
    width: 584dp;
    height: 76dp;
    color: #ffffffff;
    font-effect: shadow(1dp 1dp #000000cc);
    pointer-events: none;
}

#dialogue-box-portrait-frame {
    width: 56dp;
    height: 56dp;
    min-width: 56dp;
    margin-right: 10dp;
    pointer-events: none;
}

#dialogue-box-portrait-frame.is-hidden {
    display: none;
}

#dialogue-box-portrait {
    width: 56dp;
    height: 56dp;
}

#dialogue-box-copy {
    flex-grow: 1;
    min-height: 60dp;
    padding-right: 18dp;
}

#dialogue-box-speaker {
    height: 16dp;
    margin-bottom: 4dp;
    color: #fce97fff;
    font-size: 1rem;
    line-height: 16dp;
}

#dialogue-box-speaker.is-hidden {
    display: none;
}

#dialogue-box-text {
    color: #f7f7f7ff;
    font-size: 1rem;
    line-height: 16dp;
    white-space: pre-wrap;
    word-break: break-word;
}

#dialogue-box-continue {
    position: absolute;
    left: 558dp;
    top: 56dp;
    width: 12dp;
    height: 12dp;
    color: #7dcfffff;
    font-size: 0.625rem;
    line-height: 12dp;
    text-align: center;
    animation: 0.6s linear infinite dialogue-box-blink;
}

#dialogue-box-continue.is-hidden {
    display: none;
}

@keyframes dialogue-box-blink {
    from { opacity: 1; }
    50% { opacity: 0; }
    to { opacity: 1; }
}
