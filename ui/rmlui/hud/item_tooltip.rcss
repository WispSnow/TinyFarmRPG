body {
    pointer-events: none;
}

#item-tooltip-panel {
    display: inline-block;
    position: absolute;
    left: 0;
    top: 0;
    width: auto;
    height: auto;
    min-width: 104dp;
    min-height: 8dp;
    padding: 8dp;
    decorator: ninepatch(tooltip-panel-bg, tooltip-panel-bg-inner, 1.0);
    pointer-events: none;
}

#item-tooltip-name,
#item-tooltip-category,
#item-tooltip-description {
    color: #000000ff;
    max-width: 240dp;
    white-space: pre-wrap;
    word-break: break-word;
    pointer-events: none;
}

#item-tooltip-name {
    font-size: 1rem;
    line-height: 16dp;
    font-effect: shadow(1dp 1dp #ffffffcc);
    margin-bottom: 3dp;
}

#item-tooltip-category {
    color: #333333ff;
    font-size: 0.875rem;
    line-height: 14dp;
    margin-bottom: 3dp;
}

#item-tooltip-description {
    font-size: 1rem;
    line-height: 16dp;
}
