body, div, h1, h2, h3, h4, p, hr, button, img, span {
    display: block;
}

body {
    width: 100%;
    height: 100%;
    pointer-events: none;
}

#item-tooltip-panel {
    position: absolute;
    left: 0;
    top: 0;
    width: 104dp;
    height: 8dp;
    padding: 8dp;
    decorator: ninepatch(tooltip-panel-bg, tooltip-panel-bg-inner, 1.0);
    pointer-events: none;
}

#item-tooltip-name,
#item-tooltip-category,
#item-tooltip-description {
    color: #000000ff;
    max-width: 240dp;
    pointer-events: none;
}

#item-tooltip-name {
    font-size: 16dp;
    line-height: 16dp;
    font-effect: shadow(1dp 1dp #ffffffcc);
    margin-bottom: 3dp;
}

#item-tooltip-category {
    color: #333333ff;
    font-size: 14dp;
    line-height: 14dp;
    margin-bottom: 3dp;
}

#item-tooltip-description {
    font-size: 16dp;
    line-height: 16dp;
}
