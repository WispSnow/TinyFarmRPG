<rml>
<head>
    <link type="text/rcss" href="../theme/base.rcss"/>
    <link type="text/rcss" href="../theme/reset.rcss"/>
    <link type="text/rcss" href="../theme/spritesheet.rcss"/>
    <link type="text/rcss" href="time_clock.rcss"/>
</head>
<body class="tf-screen-root" data-model="time_clock">
    <div id="time-clock">
        <!-- 右侧面板（先渲染，在底层） -->
        <div class="info-panel">
            <div class="label-stack">
                <div class="label-bg"><span>{{ day_text }}</span></div>
                <div class="label-bg"><span>{{ time_text }}</span></div>
            </div>
        </div>
        <!-- 表盘底图（后渲染，覆盖面板重叠区域） -->
        <div class="clock-face"></div>
        <!-- 指针（最上层） -->
        <div class="clock-hand" data-style-decorator="hand_decorator"></div>
    </div>
</body>
</rml>
