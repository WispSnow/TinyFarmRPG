body, div, h1, h2, h3, h4, p, hr, button, img, span {
    display: block;
}

body {
    width: 100%;
    height: 100%;
    pointer-events: none;
}

#dialogue-bubble-panel {
    position: absolute;
    left: 0;
    top: 0;
    width: 144dp;
    height: 32dp;
    decorator: ninepatch(dialogue-bubble-bg, dialogue-bubble-bg-inner, 1.0);
    pointer-events: none;
}

#dialogue-bubble-text {
    color: #000000ff;
    pointer-events: none;
}
