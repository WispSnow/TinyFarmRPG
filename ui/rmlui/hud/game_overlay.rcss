body, div, h1, h2, h3, h4, p, hr {
    display: block;
}

body {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
}

#game-prompt-bar {
    position: absolute;
    left: 12dp;
    bottom: 12dp;
    background-color: #081018e8;
    border: 1dp #6f8093ff;
    padding: 4dp 6dp;
    pointer-events: none;
}

.game-prompt-item {
    display: inline-block;
    margin-right: 8dp;
}

.game-prompt-item:last-child {
    margin-right: 0;
}

.game-prompt-label {
    color: #8eb7daff;
    margin-bottom: 1dp;
    font-size: 10dp;
}

.game-prompt-value {
    color: #f6f3e8ff;
    font-size: 12dp;
}
