body, div, h1, h2, h3, h4, p, hr {
    display: block;
}

body {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
}

#game-overlay-top-right {
    position: absolute;
    right: 10dp;
    top: 10dp;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8dp;
    pointer-events: none;
}

#game-menu-button {
    pointer-events: auto;
}
