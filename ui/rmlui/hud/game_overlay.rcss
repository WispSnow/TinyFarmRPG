body, div, h1, h2, h3, h4, p, hr, button, img {
    display: block;
}

body {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
}

#game-menu-anchor {
    position: absolute;
    right: 10dp;
    top: 10dp;
    width: 32dp;
    height: 32dp;
}

#game-menu-button {
    width: 32dp;
    height: 32dp;
    pointer-events: auto;
}

#game-prompt-bar {
    position: absolute;
    left: 10dp;
    bottom: 10dp;
    background-color: #0f1a26dd;
    border: 1dp #7c92a8ff;
    padding: 4dp 6dp;
    pointer-events: none;
}

.game-prompt-item {
    display: inline-block;
    margin-right: 10dp;
}

.game-prompt-item:last-child {
    margin-right: 0;
}

.game-prompt-label {
    color: #8eb7daff;
    margin-bottom: 1dp;
    font-size: 10dp;
}

.game-prompt-value {
    color: #f6f3e8ff;
    font-size: 12dp;
}
