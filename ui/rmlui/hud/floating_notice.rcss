body, div, h1, h2, h3, h4, p, hr {
    display: block;
}

body {
    pointer-events: none;
}

#floating-notice-panel {
    display: inline-block;
    position: absolute;
    left: 0;
    top: 0;
    width: auto;
    height: auto;
    min-width: 144dp;
    min-height: 32dp;
    padding: 8dp;
    decorator: ninepatch(hud-dialogue-bg, hud-dialogue-bg-inner, 1.0);
    pointer-events: none;
}

#floating-notice-text {
    color: #000000ff;
    max-width: 144dp;
    font-size: 1rem;
    line-height: 16dp;
    white-space: pre-wrap;
    word-break: break-word;
    pointer-events: none;
}
