<rml>
<head>
    <link type="text/rcss" href="learn_custom_elements.rcss"/>
</head>
<body data-model="demo">

    <!-- 标题栏 -->
    <div class="page-header">
        <span class="page-title">L08 — Custom Elements &amp; Doc Management</span>
        <span class="page-hint">hp-bar 自定义元素 • Show/Hide 双文档 • DOM 动态操作</span>
    </div>

    <div class="content-row">

        <!-- ① 角色状态面板：使用自定义 <hp-bar> 元素 -->
        <div class="panel status-panel">
            <h2>Party Status</h2>

            <div class="char-name">Hero</div>

            <!-- HP Bar：data-attr-value 将 hp 绑定到 <hp-bar> 的 value 属性 -->
            <div class="bar-group">
                <span class="bar-label bar-label-hp">HP</span>
                <hp-bar data-attr-value="hp" data-attr-max="max_hp"/>
                <span class="bar-value">{{hp}} / {{max_hp}}</span>
            </div>

            <!-- MP Bar：bar-color 属性固定为蓝色 -->
            <div class="bar-group">
                <span class="bar-label bar-label-mp">MP</span>
                <hp-bar bar-color="#1f6feb"
                        data-attr-value="mp" data-attr-max="max_mp"/>
                <span class="bar-value">{{mp}} / {{max_mp}}</span>
            </div>

            <!-- Gold -->
            <div class="gold-row">
                <span class="gold-icon">G</span>
                <span class="gold-val">{{gold}}</span>
            </div>
        </div>

        <!-- ② 操作按钮面板 -->
        <div class="panel controls-panel">
            <h2>Actions</h2>
            <div class="btn" data-event-click="on_damage">Damage -15</div>
            <div class="btn" data-event-click="on_heal">Heal +20</div>
            <div class="btn" data-event-click="on_mp_use">MP -10</div>
            <div class="btn btn-menu" data-event-click="toggle_menu">Menu</div>
            <div class="btn btn-clear" data-event-click="clear_log">Clear Log</div>
        </div>

    </div>

    <!-- ③ 行动日志：通过 CreateElement + AppendChild 动态添加 -->
    <div class="panel log-panel">
        <div class="log-header">
            <span>Action Log</span>
            <span class="log-hint">(CreateElement + AppendChild + RemoveChild)</span>
        </div>
        <div id="action-log" class="log-container">
        </div>
    </div>

    <!-- 底部知识点 -->
    <div class="info-bar">
        custom element: <span class="code">hp-bar</span> •
        instancer: <span class="code">ElementInstancerGeneric</span> •
        DOM: <span class="code">CreateElement / AppendChild / SetInnerRML</span> •
        docs: <span class="code">Show / Hide / PullToFront</span>
    </div>

</body>
</rml>
