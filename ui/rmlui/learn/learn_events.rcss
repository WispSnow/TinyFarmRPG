/* === 重置 === */
body, div, h1, h2, h3, h4, p, hr {
    display: block;
}

body {
    margin: 0;
    padding: 10dp;
    font-size: 13dp;
    font-family: "VonwaonBitmap 16px";
    color: #c0caf5;
}

/* === 通用 === */
.section {
    margin-bottom: 8dp;
    padding: 6dp;
    background-color: #1a1b26d0;
    border: 1dp #414868;
    border-radius: 6dp;
}

h2 {
    margin: 0 0 4dp 0;
    font-size: 14dp;
    color: #7aa2f7;
}

.label {
    margin: 2dp 0;
    font-size: 11dp;
    color: #565f89;
}

.demo-row {
    display: flex;
    flex-direction: row;
    gap: 8dp;
}
.demo-col {
    flex: 1;
}

/* === ① Click Counter === */
.counter-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10dp;
}
.click-btn {
    padding: 6dp 20dp;
    background-color: #7aa2f7;
    border-radius: 4dp;
    color: #1a1b26;
    font-size: 13dp;
    font-weight: bold;
    text-align: center;
}
.click-btn:hover {
    background-color: #89b4fa;
}
.click-btn:active {
    background-color: #bb9af7;
}
.counter-display {
    font-size: 20dp;
    font-weight: bold;
    color: #e0af68;
    font-effect: glow(1dp #e0af6860);
}

/* === ② Command Menu === */
.cmd-row {
    display: flex;
    flex-direction: row;
    gap: 8dp;
    align-items: flex-start;
}
.cmd-list {
    display: flex;
    flex-direction: column;
    gap: 3dp;
    flex: 0 0 120dp;
}
.cmd-btn {
    padding: 5dp 12dp;
    background-color: #414868;
    border-radius: 3dp;
    color: #c0caf5;
    font-size: 12dp;
    text-align: center;
}
.cmd-btn:hover {
    background-color: #565f89;
    color: #ffffff;
}
.cmd-btn:active {
    background-color: #7aa2f7;
    color: #1a1b26;
}
.cmd-log-box {
    flex: 1;
    padding: 8dp;
    background-color: #24283b;
    border: 1dp #414868;
    border-radius: 4dp;
    min-height: 60dp;
}
.cmd-log-text {
    font-size: 13dp;
    color: #9ece6a;
    font-effect: glow(1dp #9ece6a40);
}

/* === ③ Hover Info === */
.hover-row {
    display: flex;
    flex-direction: row;
    gap: 8dp;
    align-items: flex-start;
}
.hover-items {
    display: flex;
    flex-direction: column;
    gap: 3dp;
    flex: 0 0 120dp;
}
.info-item {
    padding: 5dp 12dp;
    background-color: #414868;
    border-radius: 3dp;
    color: #c0caf5;
    font-size: 12dp;
    text-align: center;
}
.info-item:hover {
    background-color: #565f89;
    color: #ffffff;
    border: 1dp #7aa2f7;
}
.hover-display-box {
    flex: 1;
    padding: 8dp;
    background-color: #24283b;
    border: 1dp #414868;
    border-radius: 4dp;
    min-height: 40dp;
}
.hover-display-text {
    font-size: 12dp;
    color: #a9b1d6;
}
