/* === 重置 === */
body, div, h1, h2, h3, h4, p, hr {
    display: block;
}

body {
    margin: 0;
    padding: 10dp;
    font-size: 13dp;
    font-family: "VonwaonBitmap 16px";
    color: #c0caf5;
}

/* === 通用 === */
.section {
    margin-bottom: 14dp;
    padding: 8dp;
    background-color: #1a1b26d0;
    border: 1dp #414868;
    border-radius: 6dp;
}

h2 {
    margin: 0 0 6dp 0;
    font-size: 15dp;
    color: #7aa2f7;
}

.label {
    margin: 4dp 0;
    font-size: 11dp;
    color: #565f89;
}

/* 通用 item 方块 */
.item {
    padding: 4dp 10dp;
    border-radius: 3dp;
    text-align: center;
    color: #1a1b26;
    font-size: 13dp;
}
.item.a { background-color: #9ece6a; }
.item.b { background-color: #7aa2f7; }
.item.c { background-color: #f7768e; }

/* === ① flex-direction === */
.demo-row {
    display: flex;
    flex-direction: row;
    gap: 10dp;
}
.demo-col {
    flex: 1;
}

.dir-row {
    display: flex;
    flex-direction: row;
    gap: 4dp;
}
.dir-col {
    display: flex;
    flex-direction: column;
    gap: 4dp;
}
.dir-row-rev {
    display: flex;
    flex-direction: row-reverse;
    gap: 4dp;
}

/* === ② justify-content === */
.jc-demos {
    display: flex;
    flex-direction: column;
    gap: 4dp;
}
.jc-entry {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8dp;
}
.jc-entry .label {
    flex: 0 0 100dp;
    margin: 0;
    text-align: right;
}
.jc-box {
    display: flex;
    flex-direction: row;
    flex: 1;
    height: 20dp;
    background-color: #24283b;
    border: 1dp #414868;
    border-radius: 3dp;
    padding: 2dp;
}
.dot {
    width: 16dp;
    height: 16dp;
    border-radius: 3dp;
    background-color: #bb9af7;
}

.jc-start   { justify-content: flex-start; gap: 3dp; }
.jc-center  { justify-content: center; gap: 3dp; }
.jc-between { justify-content: space-between; }
.jc-evenly  { justify-content: space-evenly; }

/* === ③ align-items === */
.ai-box {
    display: flex;
    flex-direction: row;
    gap: 4dp;
    height: 56dp;
    background-color: #24283b;
    border: 1dp #414868;
    border-radius: 3dp;
    padding: 4dp;
}
.ai-item {
    width: 28dp;
    border-radius: 3dp;
    text-align: center;
    color: #1a1b26;
    font-size: 12dp;
    background-color: #e0af68;
}
.ai-short { height: 20dp; }
.ai-tall  { height: 44dp; }

.ai-stretch { align-items: stretch; }
.ai-stretch .ai-item { height: auto; }
.ai-center  { align-items: center; }
.ai-end     { align-items: flex-end; }

/* === ④ flex-grow === */
.grow-box {
    display: flex;
    flex-direction: row;
    gap: 4dp;
}
.grow-item {
    padding: 6dp 0;
    text-align: center;
    border-radius: 3dp;
    color: #1a1b26;
    font-size: 13dp;
}
.g1 { flex: 1; background-color: #73daca; }
.g2 { flex: 2; background-color: #ff9e64; }

/* === ⑤ Grid (flex-wrap) === */
.grid-box {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 3dp;
    width: 198dp;     /* 6 * 30dp + 5 * 3dp = 195dp + padding wiggle */
}
.grid-cell {
    flex: 0 0 30dp;
    height: 30dp;
    background-color: #3b4261;
    border: 1dp #565f89;
    border-radius: 2dp;
    text-align: center;
    padding: 6dp 0 0 0;
    font-size: 11dp;
    color: #a9b1d6;
}
.grid-cell:hover {
    background-color: #565f89;
    color: #ffffff;
}
