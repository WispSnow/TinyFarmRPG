/* ==========================================================
   L12: JRPG Window Framework & Keyboard Navigation
   ========================================================== */

/* === Spritesheet === */
@spritesheet jrpg-ui {
    src: ../../../assets/textures/UI/learn_spritesheet.png;
    resolution: 1x;

    /* Ninepatch: outer rect + inner content rect */
    window-outer: 0px 0px 32px 32px;
    window-inner: 4px 4px 24px 24px;
}

/* === Reset === */
body, div, h1, h2, h3, h4, p, hr {
    display: block;
}

/* === Body === */
body {
    position: relative;
    margin: 0;
    padding: 8dp;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    font-size: 12dp;
    font-family: "VonwaonBitmap 16px";
    color: #c0caf5;
}

/* ==========================================================
   JRPG Window Skin — ninepatch + image-color variants
   ========================================================== */

.jrpg-window {
    decorator: ninepatch(window-outer, window-inner, 1.0);
    padding: 6dp 8dp;
}

/* Color variants (multiplicative tint on the base sprite) */
.win-blue  { image-color: #8090c0; }
.win-teal  { image-color: #70a898; }
.win-dark  { image-color: #606068; }
.win-gold  { image-color: #c0a070; }

/* --- Window title bar --- */
.win-title {
    font-size: 11dp;
    font-weight: bold;
    color: #e0af68;
    padding-bottom: 3dp;
    margin-bottom: 4dp;
    border-bottom: 1dp #565f89;
}

/* --- Window content area --- */
.win-body {
    padding: 2dp 0;
}

/* ==========================================================
   Page Layout
   ========================================================== */

.page-header {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    gap: 6dp;
    margin-bottom: 6dp;
}
.page-title {
    font-size: 13dp;
    font-weight: bold;
    color: #7aa2f7;
}
.page-hint {
    font-size: 10dp;
    color: #565f89;
}

.main-row {
    display: flex;
    flex-direction: row;
    gap: 6dp;
}
.menu-col {
    width: 140dp;
}
.info-col {
    flex-grow: 1;
}

.status-row {
    margin-top: 6dp;
}

/* ==========================================================
   Menu Items — keyboard navigable
   ========================================================== */

.menu-item {
    padding: 3dp 6dp;
    color: #c0caf5;

    /* Make focusable via Tab / arrow keys */
    tab-index: auto;

    /* Spatial navigation: auto-find neighbours */
    nav-up: auto;
    nav-down: auto;

    /* Smooth state transitions */
    transition: background-color padding-left color 0.12s cubic-out;
}

.menu-item:hover {
    background-color: #7aa2f720;
    color: #7dcfff;
}

.menu-item:focus-visible {
    background-color: #7aa2f730;
    color: #7dcfff;
    padding-left: 14dp;
}

.menu-item:active {
    background-color: #7aa2f750;
    color: #ffffff;
}

/* --- Cursor indicator (child of menu-item) --- */
.cursor {
    display: inline;
    color: #e0af68;
    margin-right: 2dp;
    font-size: 10dp;
    opacity: 0;
}

.menu-item:focus-visible .cursor {
    opacity: 1;
    animation: 0.8s linear infinite cursor-blink;
}

@keyframes cursor-blink {
    from { opacity: 1; }
    50%  { opacity: 0; }
    to   { opacity: 1; }
}

/* ==========================================================
   Info Panel Content
   ========================================================== */

.info-title {
    font-size: 13dp;
    font-weight: bold;
    color: #bb9af7;
    margin-bottom: 6dp;
}

.info-desc {
    font-size: 11dp;
    color: #a9b1d6;
    line-height: 1.4;
}

.info-placeholder {
    font-size: 11dp;
    color: #565f89;
}

/* ==========================================================
   Status Bar
   ========================================================== */

.status-text {
    font-size: 10dp;
    color: #565f89;
    text-align: center;
}

/* ==========================================================
   Modal Overlay & Popup Dialog
   ========================================================== */

.modal-overlay {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: #00000080;
}

.modal-overlay.visible {
    display: flex;
    justify-content: center;
    align-items: center;
}

.popup-window {
    width: 200dp;
    transform-origin: 50% 50%;
}

.popup-msg {
    text-align: center;
    font-size: 11dp;
    color: #c0caf5;
    margin-bottom: 6dp;
}

.popup-choices {
    display: flex;
    flex-direction: row;
    gap: 8dp;
    justify-content: center;
    margin-top: 6dp;
    text-align: center;
}

/* Popup buttons: restrict navigation to stay within popup */
.popup-choices .menu-item {
    display: inline-block;
    padding: 3dp 16dp;
    text-align: center;
}

#popup-yes {
    nav-left: none;
    nav-right: #popup-no;
    nav-up: none;
    nav-down: none;
}

#popup-no {
    nav-left: #popup-yes;
    nav-right: none;
    nav-up: none;
    nav-down: none;
}

/* ==========================================================
   Window Animations
   ========================================================== */

@keyframes window-open {
    from {
        transform: scale(0.85);
        opacity: 0;
    }
    to {
        transform: scale(1.0);
        opacity: 1;
    }
}

@keyframes window-close {
    from {
        transform: scale(1.0);
        opacity: 1;
    }
    to {
        transform: scale(0.85);
        opacity: 0;
    }
}

.anim-open {
    animation: 0.2s cubic-out window-open;
}

.anim-close {
    animation: 0.15s cubic-in window-close;
}
