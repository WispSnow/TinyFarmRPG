/* =====================
   @keyframes 定义
   ===================== */

/* 中毒脉冲：hue-rotate + saturate 循环 */
@keyframes poison-pulse {
    from { filter: hue-rotate(80deg) saturate(2.0); }
    50%  { filter: hue-rotate(130deg) saturate(3.0); }
    to   { filter: hue-rotate(80deg) saturate(2.0); }
}

/* 色相环绕 */
@keyframes hue-cycle {
    from { filter: hue-rotate(0deg); }
    to   { filter: hue-rotate(360deg); }
}

/* === 重置 === */
body, div, h1, h2, h3, h4, p, hr {
    display: block;
}

body {
    margin: 0;
    padding: 8dp;
    font-size: 12dp;
    font-family: "VonwaonBitmap 16px";
    color: #c0caf5;
}

/* =====================
   页面布局
   ===================== */

.page-header {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    gap: 8dp;
    margin-bottom: 6dp;
}
.page-title {
    font-size: 14dp;
    color: #7aa2f7;
    font-weight: bold;
}
.page-hint {
    font-size: 10dp;
    color: #565f89;
}

.content-row {
    display: flex;
    flex-direction: row;
    gap: 6dp;
    margin-bottom: 6dp;
    width: 624dp;
}

.col {
    flex: 1;
}

h2 {
    margin: 0 0 4dp 0;
    font-size: 12dp;
    color: #e0af68;
}

.section-label {
    font-size: 10dp;
    color: #565f89;
    margin-bottom: 2dp;
}

/* =====================
   通用面板
   ===================== */

.panel {
    background-color: #1a1b2680;
    border: 1dp #2d3354;
    border-radius: 4dp;
    padding: 6dp;
    margin-bottom: 4dp;
}

/* =====================
   左列：Filter 函数一览
   ===================== */

.filter-row {
    display: flex;
    flex-direction: row;
    gap: 6dp;
    align-items: center;
    margin-bottom: 2dp;
}

.swatch {
    width: 40dp;
    height: 16dp;
    border-radius: 2dp;
    transition: filter 0.5s cubic-out;
}

.filter-label {
    font-size: 9dp;
    color: #565f89;
}

/* 各 filter 函数演示（hover 切回原值） */
.swatch-blur {
    background-color: #7aa2f7;
    filter: blur(2dp);
}
.swatch-blur:hover {
    filter: blur(0dp);
}

.swatch-bright {
    background-color: #7aa2f7;
    filter: brightness(0.3);
}
.swatch-bright:hover {
    filter: brightness(1.0);
}

.swatch-contrast {
    background-color: #9ece6a;
    filter: contrast(0.3);
}
.swatch-contrast:hover {
    filter: contrast(1.0);
}

.swatch-gray {
    background-color: #f7768e;
    filter: grayscale(1.0);
}
.swatch-gray:hover {
    filter: grayscale(0.0);
}

.swatch-sepia {
    background-color: #7aa2f7;
    filter: sepia(1.0);
}
.swatch-sepia:hover {
    filter: sepia(0.0);
}

.swatch-hue {
    background-color: #f7768e;
    filter: hue-rotate(180deg);
}
.swatch-hue:hover {
    filter: hue-rotate(0deg);
}

.swatch-invert {
    background-color: #7aa2f7;
    filter: invert(1.0);
}
.swatch-invert:hover {
    filter: invert(0.0);
}

.swatch-saturate {
    background-color: #bb9af7;
    filter: saturate(3.0);
}
.swatch-saturate:hover {
    filter: saturate(1.0);
}

.swatch-shadow {
    background-color: #bb9af7;
    filter: drop-shadow(#00000099 3dp 3dp 2dp);
}
.swatch-shadow:hover {
    filter: drop-shadow(#00000000 0dp 0dp 0dp);
}

/* =====================
   中列：交互演示
   ===================== */

/* 毛玻璃容器 */
.glass-container {
    position: relative;
    height: 70dp;
    margin-bottom: 4dp;
    border-radius: 4dp;
    overflow: hidden;
    background-color: #1a1b26;
}
.glass-bg {
    display: flex;
    flex-direction: row;
    gap: 4dp;
    padding: 6dp;
}
.bg-block {
    width: 36dp;
    height: 58dp;
    border-radius: 3dp;
}
.bg-red    { background-color: #f7768e; }
.bg-blue   { background-color: #7aa2f7; }
.bg-green  { background-color: #9ece6a; }
.bg-purple { background-color: #bb9af7; }

.glass-panel {
    position: absolute;
    top: 10dp;
    left: 15dp;
    right: 15dp;
    bottom: 10dp;
    background-color: #1a1b2680;
    backdrop-filter: blur(5dp);
    border: 1dp #c0caf540;
    border-radius: 4dp;
    padding: 8dp;
    text-align: center;
}
.glass-title {
    font-size: 11dp;
    color: #e0af68;
    font-weight: bold;
    margin-bottom: 2dp;
}
.glass-text {
    font-size: 10dp;
    color: #c0caf5;
}

/* 角色头像 + 中毒效果 */
.avatar-row {
    display: flex;
    flex-direction: row;
    gap: 6dp;
    align-items: center;
    margin-bottom: 4dp;
    padding: 6dp;
    background-color: #1a1b2680;
    border: 1dp #2d3354;
    border-radius: 4dp;
}

.avatar {
    width: 32dp;
    height: 32dp;
    background-color: #3d6aaa;
    border-radius: 4dp;
    text-align: center;
    padding-top: 8dp;
    font-size: 14dp;
    color: #ffffff;
}
.avatar.poisoned {
    animation: 2s cubic-in-out infinite poison-pulse;
}

.avatar-name {
    font-size: 11dp;
    color: #c0caf5;
    font-weight: bold;
}
.avatar-hp {
    font-size: 10dp;
    color: #9ece6a;
}
.poison-tag {
    font-size: 9dp;
    color: #9ece6a;
    font-weight: bold;
}

/* 操作按钮 */
.action-btn {
    padding: 4dp 10dp;
    margin-bottom: 4dp;
    background-color: #2d3354;
    border: 1dp #565f89;
    border-radius: 3dp;
    text-align: center;
    font-size: 11dp;
    color: #c0caf5;
    transition: background-color 0.2s cubic-out;
}
.action-btn:hover {
    background-color: #3d6aaa;
}
.action-btn:active {
    background-color: #7aa2f7;
}

/* 色相环绕动画盒 */
.hue-cycle-box {
    width: 80dp;
    height: 18dp;
    background-color: #f7768e;
    border-radius: 3dp;
    text-align: center;
    font-size: 10dp;
    color: #ffffff;
    padding-top: 3dp;
    animation: 3s linear infinite hue-cycle;
}

/* =====================
   右列：阴影 & 遮罩
   ===================== */

.shadow-row {
    display: flex;
    flex-direction: row;
    gap: 8dp;
    align-items: center;
    margin-bottom: 6dp;
}
.shadow-box {
    width: 36dp;
    height: 22dp;
    background-color: #2d3354;
    border-radius: 3dp;
}
.shadow-label {
    font-size: 9dp;
    color: #565f89;
}

.shadow-outer {
    box-shadow: #00000080 3dp 3dp 5dp 0dp;
}
.shadow-inset {
    box-shadow: #00000080 2dp 2dp 4dp 0dp inset;
}
.shadow-multi {
    box-shadow: #f7768e60 -2dp -2dp 4dp 0dp, #7aa2f760 2dp 2dp 4dp 0dp;
}
.shadow-colored {
    box-shadow: #7aa2f780 0dp 0dp 8dp 2dp;
}

/* 发光效果（用 drop-shadow filter，可动画） */
.glow-box {
    width: 80dp;
    height: 22dp;
    background-color: #2d3354;
    border: 1dp #7aa2f7;
    border-radius: 3dp;
    text-align: center;
    padding-top: 5dp;
    font-size: 10dp;
    color: #7aa2f7;
    filter: drop-shadow(#7aa2f700 0dp 0dp 0dp);
    transition: filter 0.4s cubic-out;
    margin-bottom: 4dp;
}
.glow-box:hover {
    filter: drop-shadow(#7aa2f7cc 0dp 0dp 8dp);
}

/* 遮罩演示 */
.mask-demo {
    background-color: #7aa2f7;
    border-radius: 3dp;
    padding: 6dp;
    mask-image: linear-gradient(180deg, #000000ff, #00000000);
}
.mask-line {
    font-size: 10dp;
    color: #1a1b26;
    font-weight: bold;
}

/* =====================
   底部信息栏
   ===================== */

.info-bar {
    padding: 3dp 6dp;
    background-color: #1a1b2680;
    border: 1dp #2d3354;
    border-radius: 3dp;
    font-size: 10dp;
    color: #565f89;
}
.code {
    color: #9ece6a;
}
.status {
    color: #bb9af7;
}
