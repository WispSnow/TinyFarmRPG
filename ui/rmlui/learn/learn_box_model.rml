<rml>
<head>
    <link type="text/rcss" href="learn_box_model.rcss"/>
</head>
<body>
    <!-- ① 盒模型可视化 -->
    <div id="box-demo" class="section">
        <h2>Box Model</h2>
        <div class="box-outer">
            <div class="box-inner">
                content area
            </div>
        </div>
        <p class="note">padding(绿) + border(蓝) 包裹 content(暗)</p>
    </div>

    <!-- ② box-sizing 对比 -->
    <div id="sizing-demo" class="section">
        <h2>box-sizing</h2>
        <div class="sizing-row">
            <div class="box-content-box">
                <p class="box-label">content-box</p>
                <p class="box-detail">width: 160dp</p>
                <p class="box-detail">actual: 196dp</p>
            </div>
            <div class="box-border-box">
                <p class="box-label">border-box</p>
                <p class="box-detail">width: 160dp</p>
                <p class="box-detail">actual: 160dp</p>
            </div>
        </div>
    </div>

    <!-- ③ 定位演示 -->
    <div id="position-demo" class="section">
        <h2>Position</h2>
        <div class="pos-container">
            <div class="pos-static">static</div>
            <div class="pos-relative">relative</div>
            <div class="pos-absolute">absolute</div>
        </div>
    </div>

    <!-- ④ overflow 演示 -->
    <div id="overflow-demo" class="section">
        <h2>Overflow: auto</h2>
        <div class="scroll-box">
            <p>Line 1 - overflow test</p>
            <p>Line 2 - The quick brown fox</p>
            <p>Line 3 - jumps over the lazy dog</p>
            <p>Line 4 - RCSS overflow demo</p>
            <p>Line 5 - scrollable content</p>
            <p>Line 6 - mouse wheel to scroll</p>
            <p>Line 7 - bottom</p>
        </div>
    </div>

    <!-- ⑤ 固定定位 HUD 示例 -->
    <div id="hud-badge">FIXED</div>
</body>
</rml>
