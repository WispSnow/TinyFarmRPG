/* === 重置 === */
body, div, h1, h2, h3, h4, p, hr, hp-bar {
    display: block;
}

body {
    margin: 0;
    padding: 8dp;
    font-size: 12dp;
    font-family: "VonwaonBitmap 16px";
    color: #c0caf5;
}

/* =====================
   页面布局
   ===================== */

.page-header {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    gap: 8dp;
    margin-bottom: 4dp;
}
.page-title {
    font-size: 14dp;
    color: #7aa2f7;
    font-weight: bold;
}
.page-hint {
    font-size: 10dp;
    color: #565f89;
}

.content-row {
    display: flex;
    flex-direction: row;
    gap: 8dp;
    margin-bottom: 4dp;
}

/* =====================
   通用面板
   ===================== */

.panel {
    padding: 6dp;
    background-color: #1a2035cc;
    border: 1dp #2d4a7a;
    border-radius: 4dp;
}

h2 {
    margin: 0 0 4dp 0;
    font-size: 13dp;
    color: #7aa2f7;
}

/* =====================
   自定义 <hp-bar> 元素
   ===================== */

hp-bar {
    width: 130dp;
    height: 10dp;
    background-color: #1e2540;
    border: 1dp #2d4060;
    border-radius: 2dp;
    overflow: hidden;
}

hp-bar .hp-bar-fill {
    display: block;
    height: 100%;
    border-radius: 2dp;
    /* background-color 由 C++ OnAttributeChange 动态设置 */
}

/* =====================
   角色状态面板
   ===================== */

.status-panel {
    flex: 3;
}

.char-name {
    font-size: 14dp;
    color: #e0af68;
    font-weight: bold;
    margin-bottom: 4dp;
}

.bar-group {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6dp;
    margin-bottom: 4dp;
}

.bar-label {
    font-size: 11dp;
    font-weight: bold;
    min-width: 20dp;
}
.bar-label-hp {
    color: #9ece6a;
}
.bar-label-mp {
    color: #7aa2f7;
}

.bar-value {
    font-size: 11dp;
    color: #a9b1d6;
    min-width: 60dp;
}

.gold-row {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    gap: 4dp;
    margin-top: 4dp;
    padding: 3dp 6dp;
    background-color: #1a1b2640;
    border: 1dp #3a3000;
    border-radius: 3dp;
}
.gold-icon {
    font-size: 13dp;
    color: #ffd700;
    font-weight: bold;
}
.gold-val {
    font-size: 12dp;
    color: #ffd700;
}

/* =====================
   操作按钮
   ===================== */

.controls-panel {
    flex: 2;
}

.btn {
    display: block;
    padding: 4dp 10dp;
    margin-bottom: 4dp;
    background-color: #414868;
    border-radius: 3dp;
    color: #c0caf5;
    font-size: 11dp;
    text-align: center;
}
.btn:hover {
    background-color: #565f89;
    color: #ffffff;
}
.btn:active {
    background-color: #7aa2f7;
    color: #1a1b26;
}

.btn-menu {
    background-color: #2d4a6a;
    color: #7dcfff;
}
.btn-menu:hover {
    background-color: #3d5a7a;
}

.btn-clear {
    background-color: #3b2020;
    color: #f7768e;
}
.btn-clear:hover {
    background-color: #4b3030;
}

/* =====================
   日志面板
   ===================== */

.log-panel {
    margin-bottom: 4dp;
}

.log-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 3dp;
}
.log-header span {
    font-size: 12dp;
    color: #7aa2f7;
    font-weight: bold;
}
.log-hint {
    font-size: 10dp;
    color: #565f89;
    font-weight: normal;
}

.log-container {
    min-height: 50dp;
    max-height: 80dp;
    overflow: auto;
    padding: 3dp 6dp;
    background-color: #1e254040;
    border: 1dp #2d3354;
    border-radius: 3dp;
}

.log-entry {
    display: block;
    font-size: 10dp;
    color: #a9b1d6;
    padding: 1dp 0;
}

/* =====================
   菜单覆盖层 (第二文档)
   ===================== */

.overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 640dp;
    height: 360dp;
    background-color: #00000088;
    display: flex;
    justify-content: center;
    align-items: center;
}

.menu-panel {
    width: 180dp;
    padding: 10dp;
    background-color: #1a2035ee;
    border: 2dp #7aa2f7;
    border-radius: 6dp;
}

.menu-title {
    font-size: 14dp;
    color: #7aa2f7;
    font-weight: bold;
    text-align: center;
    margin-bottom: 8dp;
}

.menu-item {
    display: block;
    padding: 5dp 10dp;
    margin-bottom: 3dp;
    font-size: 12dp;
    color: #c0caf5;
    border-radius: 3dp;
}
.menu-item:hover {
    background-color: #2d3354;
    color: #ffffff;
}

.menu-sep {
    display: block;
    height: 1dp;
    background-color: #2d3354;
    margin: 4dp 0;
}

.menu-close {
    color: #f7768e;
    text-align: center;
}
.menu-close:hover {
    background-color: #3b2020;
}

/* =====================
   底部信息栏
   ===================== */

.info-bar {
    padding: 3dp 6dp;
    background-color: #1a1b2680;
    border: 1dp #2d3354;
    border-radius: 3dp;
    font-size: 10dp;
    color: #565f89;
}
.code {
    color: #9ece6a;
}
