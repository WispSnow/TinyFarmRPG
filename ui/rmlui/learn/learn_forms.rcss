/* === 重置 === */
body, div, h1, h2, h3, h4, p, hr, form, progress {
    display: block;
}

body {
    margin: 0;
    padding: 8dp;
    font-size: 12dp;
    font-family: "VonwaonBitmap 16px";
    color: #c0caf5;
}

/* =====================
   页面布局
   ===================== */

.page-header {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    gap: 8dp;
    margin-bottom: 4dp;
}
.page-title {
    font-size: 14dp;
    color: #7aa2f7;
    font-weight: bold;
}
.page-hint {
    font-size: 10dp;
    color: #565f89;
}

.content-row {
    display: flex;
    flex-direction: row;
    gap: 8dp;
    margin-bottom: 4dp;
}

/* =====================
   通用面板
   ===================== */

.panel {
    padding: 6dp;
    background-color: #1a2035cc;
    border: 1dp #2d4a7a;
    border-radius: 4dp;
}

h2 {
    margin: 0 0 4dp 0;
    font-size: 13dp;
    color: #7aa2f7;
}

/* =====================
   Tabset 标签页
   ===================== */

tabset {
    display: block;
}

tabset tabs {
    display: flex;
    flex-direction: row;
    gap: 2dp;
    margin-bottom: 4dp;
}

tabset tab {
    display: inline-block;
    padding: 3dp 10dp;
    font-size: 11dp;
    color: #565f89;
    background-color: #1e2540;
    border: 1dp #2d3354;
    border-radius: 3dp 3dp 0 0;
}
tabset tab:hover {
    color: #a9b1d6;
    background-color: #24283b;
}
tabset tab:selected {
    color: #c0caf5;
    background-color: #2d3354;
    border: 1dp #7aa2f7;
    border-bottom: 1dp #2d3354;
}

tabset panels {
    display: block;
}

tabset panel {
    display: block;
    padding: 6dp;
    background-color: #1e254040;
    border: 1dp #2d3354;
    border-radius: 0 0 3dp 3dp;
    min-height: 170dp;
}

/* =====================
   表单组
   ===================== */

.form-panel {
    flex: 3;
}

.form-group {
    display: block;
    margin-bottom: 6dp;
}

.form-label {
    display: block;
    font-size: 11dp;
    color: #a9b1d6;
    margin-bottom: 2dp;
}

/* =====================
   Range 滑块
   ===================== */

.slider-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6dp;
}

input.range {
    width: 180dp;
    height: 20dp;
}
input.range sliderarrowdec,
input.range sliderarrowinc {
    width: 0;
    height: 0;
}
input.range slidertrack {
    height: 6dp;
    background-color: #1e2540;
    border: 1dp #414868;
    border-radius: 3dp;
}
input.range sliderbar {
    width: 12dp;
    height: 12dp;
    margin-top: -3dp;
    background-color: #7aa2f7;
    border-radius: 6dp;
}
input.range sliderbar:hover {
    background-color: #89b4fa;
}
input.range sliderbar:active {
    background-color: #5a7fcf;
}

.slider-value {
    font-size: 11dp;
    color: #9ece6a;
    min-width: 24dp;
    text-align: right;
}

/* =====================
   Progress 进度条
   ===================== */

progress {
    width: 100%;
    height: 6dp;
    background-color: #1e2540;
    border: 1dp #2d4060;
    border-radius: 2dp;
    margin-top: 2dp;
}
progress fill {
    background-color: #7aa2f7;
    border-radius: 2dp;
}
.progress-green fill {
    background-color: #9ece6a;
}

/* =====================
   Checkbox / Radio
   ===================== */

.check-row, .radio-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 4dp;
    margin-bottom: 3dp;
}

input.checkbox, input.radio {
    width: 14dp;
    height: 14dp;
    border: 1dp #414868;
    background-color: #1e2540;
}
input.checkbox:checked {
    background-color: #7aa2f7;
    border: 1dp #7aa2f7;
}
input.radio {
    border-radius: 7dp;
}
input.radio:checked {
    background-color: #7aa2f7;
    border: 1dp #7aa2f7;
}

.check-label, .radio-label {
    font-size: 11dp;
    color: #c0caf5;
}

/* =====================
   Select 下拉框
   ===================== */

select {
    width: 130dp;
    border: 1dp #414868;
    background-color: #1e2540;
    border-radius: 2dp;
}
select selectvalue {
    color: #c0caf5;
    padding: 2dp 4dp;
    font-size: 11dp;
}
select selectarrow {
    width: 16dp;
    background-color: #24283b;
}
select selectbox {
    background-color: #1a2035;
    border: 1dp #414868;
    border-radius: 2dp;
}
select selectbox option {
    display: block;
    padding: 3dp 6dp;
    font-size: 11dp;
    color: #c0caf5;
}
select selectbox option:hover {
    background-color: #2d3354;
}
select selectbox option:checked {
    background-color: #7aa2f7;
    color: #1a1b26;
}

/* =====================
   Text / Password / TextArea
   ===================== */

input.text, input.password {
    width: 180dp;
    border: 1dp #414868;
    background-color: #1e2540;
    color: #c0caf5;
    padding: 3dp 6dp;
    border-radius: 2dp;
    font-size: 11dp;
}
input.text:focus, input.password:focus {
    border: 1dp #7aa2f7;
}

textarea {
    display: block;
    width: 260dp;
    height: 48dp;
    border: 1dp #414868;
    background-color: #1e2540;
    color: #c0caf5;
    padding: 3dp 6dp;
    border-radius: 2dp;
    font-size: 11dp;
    overflow: auto;
}
textarea:focus {
    border: 1dp #7aa2f7;
}

/* =====================
   按钮
   ===================== */

.button-row {
    display: flex;
    flex-direction: row;
    gap: 8dp;
    margin-top: 6dp;
}

input.submit {
    padding: 4dp 14dp;
    background-color: #7aa2f7;
    color: #1a1b26;
    border-radius: 3dp;
    font-size: 11dp;
    font-weight: bold;
}
input.submit:hover {
    background-color: #89b4fa;
}
input.submit:active {
    background-color: #5a7fcf;
}

.btn {
    padding: 4dp 14dp;
    background-color: #414868;
    border-radius: 3dp;
    color: #c0caf5;
    font-size: 11dp;
    text-align: center;
}
.btn:hover {
    background-color: #565f89;
    color: #ffffff;
}
.btn:active {
    background-color: #7aa2f7;
    color: #1a1b26;
}

/* =====================
   Preview 预览面板
   ===================== */

.preview-panel {
    flex: 2;
}

.preview-item {
    display: block;
    font-size: 11dp;
    padding: 2dp 0;
    color: #a9b1d6;
}
.preview-key {
    color: #565f89;
}
.preview-val {
    color: #9ece6a;
}

hr {
    margin: 4dp 0;
    border: 0;
    height: 1dp;
    background-color: #2d3354;
}

.submit-log {
    display: block;
    font-size: 11dp;
    color: #e0af68;
    padding: 2dp 0;
}

/* =====================
   底部信息栏
   ===================== */

.info-bar {
    padding: 3dp 6dp;
    background-color: #1a1b2680;
    border: 1dp #2d3354;
    border-radius: 3dp;
    font-size: 10dp;
    color: #565f89;
}
.code {
    color: #9ece6a;
}
