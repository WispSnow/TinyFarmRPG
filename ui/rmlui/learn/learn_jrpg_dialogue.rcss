/* ==========================================================
   L13: JRPG Dialogue System
   ========================================================== */

/* === Spritesheets === */

@spritesheet window-skin {
    src: ../../../assets/textures/UI/learn_spritesheet.png;
    resolution: 1x;

    window-outer: 0px 0px 32px 32px;
    window-inner: 4px 4px 24px 24px;
}

@spritesheet portraits {
    src: ../../../assets/farm-rpg/Character and Portrait/Portrait/Premade/1.png;
    resolution: 1x;

    /* 3 rows x 5 cols, each 64x64 */
    face-0:   0px   0px 64px 64px;
    face-1:  64px   0px 64px 64px;
    face-2: 128px   0px 64px 64px;
    face-3: 192px   0px 64px 64px;
    face-4: 256px   0px 64px 64px;
    face-5:   0px  64px 64px 64px;
    face-6:  64px  64px 64px 64px;
    face-7: 128px  64px 64px 64px;
    face-8: 192px  64px 64px 64px;
    face-9: 256px  64px 64px 64px;
    face-10:  0px 128px 64px 64px;
    face-11: 64px 128px 64px 64px;
    face-12:128px 128px 64px 64px;
    face-13:192px 128px 64px 64px;
    face-14:256px 128px 64px 64px;
}

/* === Reset === */
body, div, h1, h2, h3, h4, p, hr {
    display: block;
}

/* === Body === */
body {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 6dp;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    font-size: 12dp;
    font-family: "VonwaonBitmap 16px";
    color: #c0caf5;
}

/* === JRPG Window (reused from L12) === */

.jrpg-window {
    decorator: ninepatch(window-outer, window-inner, 1.0);
    padding: 6dp 8dp;
}

.win-blue { image-color: #8090c0; }
.win-dark { image-color: #606068; }

/* ==========================================================
   Page Layout
   ========================================================== */

.page-header {
    margin-bottom: 4dp;
}
.page-title {
    font-size: 13dp;
    font-weight: bold;
    color: #7aa2f7;
}

/* Scene area: empty space above dialogue, holds choices window */
.scene-area {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-end;
    padding: 0 8dp 4dp 0;
    background-color: #0d0d18;
}

/* ==========================================================
   Name Tag — overlaps the top of the dialogue window
   ========================================================== */

.name-tag-row {
    position: relative;
    z-index: 1;
    margin-bottom: -8dp;
    padding-left: 16dp;
}

.name-tag {
    display: inline-block;
    padding: 2dp 12dp;
    font-size: 11dp;
    font-weight: bold;
    color: #7dcfff;
}

/* ==========================================================
   Dialogue Window
   ========================================================== */

.dialogue-window .win-body {
    min-height: 48dp;
}

.dialogue-row {
    display: flex;
    flex-direction: row;
    gap: 8dp;
    align-items: flex-start;
}

/* --- Portrait --- */
.portrait {
    width: 48dp;
    height: 48dp;
    min-width: 48dp;
    border: 1dp #565f89;
}

/* Portrait face classes (decorator switches the displayed sprite) */
.face-0  { decorator: image(face-0); }
.face-1  { decorator: image(face-1); }
.face-2  { decorator: image(face-2); }
.face-3  { decorator: image(face-3); }
.face-4  { decorator: image(face-4); }
.face-5  { decorator: image(face-5); }
.face-6  { decorator: image(face-6); }
.face-7  { decorator: image(face-7); }
.face-8  { decorator: image(face-8); }
.face-9  { decorator: image(face-9); }
.face-10 { decorator: image(face-10); }
.face-11 { decorator: image(face-11); }
.face-12 { decorator: image(face-12); }
.face-13 { decorator: image(face-13); }
.face-14 { decorator: image(face-14); }

/* --- Text area --- */
.text-area {
    flex-grow: 1;
    font-size: 11dp;
    line-height: 1.5;
    color: #c0caf5;
}

/* Blinking "continue" marker */
.continue-marker {
    display: inline;
    color: #7dcfff;
    margin-left: 2dp;
    animation: 0.6s linear infinite cursor-blink;
}

@keyframes cursor-blink {
    from { opacity: 1; }
    50%  { opacity: 0; }
    to   { opacity: 1; }
}

/* ==========================================================
   Choices Window
   ========================================================== */

.choices-window {
    width: 220dp;
    margin-bottom: 2dp;
}

.choice-item {
    padding: 3dp 6dp;
    color: #c0caf5;
    tab-index: auto;
    nav-up: auto;
    nav-down: auto;
    transition: background-color padding-left color 0.12s cubic-out;
}

.choice-item:hover {
    background-color: #7aa2f720;
    color: #7dcfff;
}

.choice-item:focus-visible {
    background-color: #7aa2f730;
    color: #7dcfff;
    padding-left: 14dp;
}

.choice-item:active {
    background-color: #7aa2f750;
    color: #ffffff;
}

.cursor {
    display: inline;
    color: #e0af68;
    margin-right: 2dp;
    font-size: 10dp;
    opacity: 0;
}

.choice-item:focus-visible .cursor {
    opacity: 1;
    animation: 0.8s linear infinite cursor-blink;
}

/* ==========================================================
   Status Bar
   ========================================================== */

.status-row {
    margin-top: 4dp;
}

.status-text {
    font-size: 10dp;
    color: #565f89;
    text-align: center;
}

/* ==========================================================
   End-of-dialogue styling
   ========================================================== */

.end-text {
    color: #565f89;
    text-align: center;
    font-size: 11dp;
}
