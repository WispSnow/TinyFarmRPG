<rml>
<head>
    <link type="text/rcss" href="learn_animation.rcss"/>
    <title>L10 Animation</title>
</head>
<body data-model="anim">

<!-- 页面标题 -->
<div class="page-header">
    <div class="page-title">L10 Animation &amp; Transitions</div>
    <div class="page-hint">transition / @keyframes / transform</div>
</div>

<!-- 主体三列布局 -->
<div class="content-row">

    <!-- 左列：Transition 过渡 -->
    <div class="col">
        <h2>Transitions</h2>

        <div class="section-label">hover: slide + color</div>
        <div class="panel">
            <div class="menu-item">New Game</div>
            <div class="menu-item">Continue</div>
            <div class="menu-item">Options</div>
            <div class="menu-item">Exit</div>
        </div>

        <div class="section-label">hover: bg-color transition</div>
        <div class="color-btn">Color Transition</div>

        <div class="section-label">hover: elastic width</div>
        <div class="size-box">Stretch</div>
    </div>

    <!-- 中列：Animation 关键帧动画 -->
    <div class="col">
        <h2>@keyframes</h2>

        <div class="panel">
            <div class="anim-row">
                <div class="anim-box spin-box">&#x21BB;</div>
                <div class="anim-label">spin — linear infinite</div>
            </div>
            <div class="anim-row">
                <div class="anim-box pulse-box">&#x2665;</div>
                <div class="anim-label">pulse — cubic-in-out</div>
            </div>
            <div class="anim-row">
                <div class="anim-box bounce-box">&#x25B2;</div>
                <div class="anim-label">bounce — quadratic-out</div>
            </div>
            <div class="anim-row">
                <div class="anim-box blink-box">!</div>
                <div class="anim-label">blink — opacity</div>
            </div>
        </div>

        <div class="section-label">4 built-in timing families</div>
        <div class="section-label">+ elastic / bounce / back</div>
    </div>

    <!-- 右列：交互动画 -->
    <div class="col">
        <h2>Interactive</h2>

        <!-- 伤害数字弹出 -->
        <div class="section-label">damage popup (translateY + opacity)</div>
        <div class="panel">
            <div id="dmg-area" class="dmg-area">
            </div>
            <div class="action-btn" data-event-click="on_hit">Attack!</div>
        </div>

        <!-- 窗口打开/关闭 -->
        <div class="section-label">window open/close (scale + opacity)</div>
        <div class="action-btn" data-event-click="toggle_window">Toggle Window</div>

        <div id="popup-window" class="popup-panel">
            <div class="popup-title">Item Found!</div>
            <div class="popup-body">You obtained a Rusty Sword.</div>
        </div>
    </div>

</div>

<!-- 底部信息栏 -->
<div class="info-bar">
    <span class="code">transition:</span> property duration timing |
    <span class="code">@keyframes</span> + <span class="code">animation:</span> name duration [infinite] |
    Status: <span class="status">{{status_text}}</span>
</div>

</body>
</rml>
