/* === 重置 === */
body, div, h1, h2, h3, h4, p, hr {
    display: block;
}

body {
    margin: 0;
    padding: 10dp;
    font-size: 13dp;
    font-family: "VonwaonBitmap 16px";
    color: #c0caf5;
}

/* === 通用 === */
.section {
    margin-bottom: 8dp;
    padding: 6dp;
    background-color: #1a1b26d0;
    border: 1dp #414868;
    border-radius: 6dp;
}

h2 {
    margin: 0 0 4dp 0;
    font-size: 14dp;
    color: #7aa2f7;
}

.label {
    margin: 2dp 0;
    font-size: 11dp;
    color: #565f89;
}

/* === 布局（与 L03 相同模式） === */
.demo-row {
    display: flex;
    flex-direction: row;
    gap: 8dp;
}
.demo-col {
    flex: 1;
}
.vert-list {
    display: flex;
    flex-direction: column;
    gap: 3dp;
}

/* === ① Font === */
.font-sample {
    padding: 3dp 8dp;
    background-color: #24283b;
    border-radius: 3dp;
}
.font-normal { font-size: 13dp; }
.font-large  { font-size: 20dp; }
.font-bold   { font-weight: bold; }
.font-spaced { letter-spacing: 3dp; }

/* === ② Text === */
.text-left    { text-align: left; }
.text-center  { text-align: center; }
.text-right   { text-align: right; }

.text-box {
    padding: 2dp 6dp;
    background-color: #24283b;
    border-radius: 3dp;
    margin-bottom: 2dp;
    font-size: 12dp;
}

.text-underline    { text-decoration: underline; }
.text-overline     { text-decoration: overline; }
.text-line-through { text-decoration: line-through; }

.text-upper { text-transform: uppercase; }
.text-lower { text-transform: lowercase; }
.text-cap   { text-transform: capitalize; }

/* === ③ Overflow === */
.overflow-box {
    padding: 2dp 6dp;
    background-color: #24283b;
    border: 1dp #414868;
    border-radius: 3dp;
    font-size: 12dp;
    white-space: nowrap;
    overflow-x: hidden;
}
.truncate    { text-overflow: ellipsis; }
.no-truncate { text-overflow: clip; }

/* === ④ Colors + Opacity === */
.color-chip {
    width: 36dp;
    height: 22dp;
    border-radius: 3dp;
    border: 1dp #414868;
}
.chip-lbl {
    flex: 0 0 36dp;
    font-size: 9dp;
    color: #565f89;
    text-align: center;
    margin: 0;
}
.label-row {
    gap: 8dp;
    margin-top: 2dp;
}
.spacer {
    width: 16dp;
}
.opacity-chip {
    width: 36dp;
    height: 22dp;
    background-color: #7aa2f7;
    border-radius: 3dp;
    text-align: center;
    padding-top: 4dp;
    font-size: 10dp;
    color: #1a1b26;
}

.c-hex6  { background-color: #7aa2f7; }
.c-hex8  { background-color: #7aa2f780; }
.c-rgb   { background-color: rgb(158, 206, 106); }
.c-rgba  { background-color: rgba(247, 118, 142, 0.6); }
.c-hsl   { background-color: hsl(265deg, 89%, 78%); }
.c-named { background-color: orange; }

.op-100 { opacity: 1.0; }
.op-75  { opacity: 0.75; }
.op-50  { opacity: 0.5; }
.op-25  { opacity: 0.25; }

/* === ⑤ Decorator === */
.dec-box {
    height: 40dp;
    border-radius: 4dp;
    border: 1dp #41486880;
}
.dec-linear {
    decorator: linear-gradient(180deg, #7aa2f7, #1a1b26);
}
.dec-linear-h {
    decorator: linear-gradient(90deg, #9ece6a, #e0af68);
}
.dec-radial {
    decorator: radial-gradient(circle, #bb9af7, #1a1b26);
}
.dec-conic {
    decorator: conic-gradient(from 0deg, #f7768e, #e0af68, #9ece6a, #7aa2f7, #bb9af7, #f7768e);
}
.dec-multi {
    decorator:
        radial-gradient(circle 20dp at 75% 25%, #ff966040, transparent),
        linear-gradient(180deg, #24283b, #1a1b26);
}
.dec-repeat {
    decorator: repeating-linear-gradient(45deg, #414868 0%, #414868 10%, #24283b 10%, #24283b 20%);
}

/* === ⑥ Font Effect === */
.fe-sample {
    padding: 6dp 0;
    font-size: 16dp;
    text-align: center;
    color: #c0caf5;
    background-color: #24283b;
    border-radius: 3dp;
}
.fe-shadow  { font-effect: shadow(2dp 2dp #000); }
.fe-glow    { font-effect: glow(2dp #ed5); }
.fe-outline { font-effect: outline(2dp #f7768e); }
.fe-blur    { font-effect: blur(3dp #7aa2f7); }
.fe-combo   { font-effect: glow(2dp #ff6a), outline(1dp #0005); }
.fe-name-glow { font-effect: glow(1dp #e0af6880); }

/* === ⑦ 角色卡片 === */
.char-card {
    padding: 8dp;
    border: 1dp #414868;
    border-radius: 6dp;
}
.char-card-bg {
    decorator: linear-gradient(180deg, #24283b, #1a1b26);
}
.char-name {
    font-size: 16dp;
    font-weight: bold;
    color: #e0af68;
    text-align: center;
    margin: 0;
}
.char-class {
    font-size: 10dp;
    color: #565f89;
    text-align: center;
    margin: 1dp 0 0 0;
}
.char-hr {
    margin: 4dp 0;
    height: 1dp;
    border: 0;
    background-color: #414868;
}
.char-stats {
    display: flex;
    flex-direction: column;
    gap: 1dp;
    margin-bottom: 4dp;
}
.stat-row {
    display: flex;
    flex-direction: row;
}
.stat-label {
    flex: 0 0 40dp;
    font-size: 11dp;
    color: #a9b1d6;
    text-align: right;
    padding-right: 6dp;
}
.stat-value {
    flex: 1;
    font-size: 11dp;
}
.stat-hp  { color: #9ece6a; }
.stat-mp  { color: #7aa2f7; }
.stat-atk { color: #f7768e; }
.stat-def { color: #e0af68; }
.char-desc {
    font-size: 10dp;
    color: #565f89;
    line-height: 1.4;
}

/* === Hover 按钮 === */
.hover-btn {
    display: flex;
    padding: 4dp 12dp;
    background-color: #414868;
    border-radius: 3dp;
    color: #c0caf5;
    font-size: 12dp;
    text-align: center;
    justify-content: center;
}
.hover-btn:hover {
    background-color: #565f89;
    color: #ffffff;
}
.hover-btn:active {
    background-color: #7aa2f7;
    color: #1a1b26;
}
