/* === 重置：RmlUi 默认 display 是 inline，需要手动设置块级元素 === */
body, div, h1, h2, h3, h4, p, hr {
    display: block;
}

body {
    margin: 0;
    padding: 12dp;
    font-size: 14dp;
    font-family: "VonwaonBitmap 16px";
    color: #c0caf5;
}

/* === 通用区块 === */
.section {
    margin-bottom: 16dp;
    padding: 10dp;
    background-color: #1a1b26d0;
    border: 1dp #414868;
    border-radius: 6dp;
}

h2 {
    margin: 0 0 8dp 0;
    font-size: 16dp;
    color: #7aa2f7;
}

.note {
    margin: 8dp 0 0 0;
    font-size: 12dp;
    color: #565f89;
}

/* === ① 盒模型可视化 === */
.box-outer {
    padding: 14dp;
    background-color: #9ece6a40;
    border: 3dp #7aa2f7;
    border-radius: 4dp;
    margin: 8dp 0;
}

.box-inner {
    padding: 10dp;
    background-color: #24283b;
    text-align: center;
    border-radius: 2dp;
}

/* === ② box-sizing 对比 === */
.sizing-row {
    display: flex;
    flex-direction: row;
    gap: 12dp;
}

.box-content-box, .box-border-box {
    width: 160dp;
    padding: 12dp;
    border-radius: 4dp;
    text-align: center;
}

.box-content-box {
    box-sizing: content-box;
    border: 2dp #f7768e;
    background-color: #f7768e20;
}

.box-border-box {
    box-sizing: border-box;
    border: 2dp #9ece6a;
    background-color: #9ece6a20;
}

.box-label {
    margin: 0 0 4dp 0;
    font-size: 14dp;
    color: #ffffff;
}

.box-detail {
    margin: 2dp 0;
    font-size: 12dp;
    color: #a9b1d6;
}

/* === ③ 定位演示 === */
.pos-container {
    position: relative;
    height: 100dp;
    background-color: #24283b;
    border: 1dp #414868;
    border-radius: 4dp;
}

.pos-static {
    padding: 4dp 8dp;
    background-color: #565f8940;
    border: 1dp #565f89;
}

.pos-relative {
    position: relative;
    top: 4dp;
    left: 16dp;
    padding: 4dp 8dp;
    background-color: #e0af6840;
    border: 1dp #e0af68;
}

.pos-absolute {
    position: absolute;
    right: 8dp;
    top: 8dp;
    padding: 4dp 8dp;
    background-color: #bb9af740;
    border: 1dp #bb9af7;
    border-radius: 4dp;
}

/* === ④ overflow 演示 === */
.scroll-box {
    height: 72dp;
    overflow-y: auto;
    padding: 6dp;
    background-color: #24283b;
    border: 1dp #414868;
    border-radius: 4dp;
}

.scroll-box p {
    margin: 2dp 0;
    font-size: 13dp;
    white-space: nowrap;
}

/* === ⑤ 固定定位 HUD === */
#hud-badge {
    position: fixed;
    right: 12dp;
    top: 12dp;
    padding: 4dp 10dp;
    background-color: #f7768ec0;
    border-radius: 4dp;
    font-size: 12dp;
    color: #ffffff;
}
