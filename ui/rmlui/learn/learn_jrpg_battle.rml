<rml>
<head>
    <link type="text/rcss" href="learn_jrpg_battle.rcss"/>
    <title>L14 JRPG Battle</title>
</head>
<body data-model="battle">

    <!-- Battle Scene (enemies / damage popups / turn indicator) -->
    <div class="battle-scene" id="battle-scene">
        <div class="turn-indicator">{{turn_text}}</div>
        <div class="log-text" id="log-text">{{log_text}}</div>
        <!-- damage popups are injected here dynamically -->
    </div>

    <!-- Bottom HUD -->
    <div class="battle-hud">

        <!-- Left: Command Menu -->
        <div class="cmd-panel jrpg-window win-blue" id="cmd-panel">
            <div class="win-title">Command</div>
            <div id="cmd-list">
                <div class="cmd-item" id="cmd-0"
                     data-event-click="on_cmd(0)"><span class="cursor">&gt;</span> Attack</div>
                <div class="cmd-item" id="cmd-1"
                     data-event-click="on_cmd(1)"><span class="cursor">&gt;</span> Skills</div>
                <div class="cmd-item" id="cmd-2"
                     data-event-click="on_cmd(2)"><span class="cursor">&gt;</span> Items</div>
                <div class="cmd-item" id="cmd-3"
                     data-event-click="on_cmd(3)"><span class="cursor">&gt;</span> Defend</div>
                <div class="cmd-item" id="cmd-4"
                     data-event-click="on_cmd(4)"><span class="cursor">&gt;</span> Flee</div>
            </div>
        </div>

        <!-- Right: Party Status -->
        <div class="party-panel jrpg-window win-dark" id="party-panel">
            <div class="party-list" id="party-list">
                <div data-for="member : party" class="char-card"
                     data-class-active-char="member.is_active">
                    <div class="char-portrait" id="portrait-{{it_index}}"
                         data-class-face-0="member.face_0"
                         data-class-face-1="member.face_1"
                         data-class-face-2="member.face_2"
                         data-class-face-3="member.face_3"
                         data-class-face-4="member.face_4"
                         data-class-face-5="member.face_5">
                    </div>
                    <div class="char-info">
                        <div class="char-name">{{member.name}}</div>
                        <div class="stat-row">
                            <span class="stat-label">HP</span>
                            <progress data-attr-value="member.hp_ratio"
                                      data-class-hp-low="member.hp_low">
                            </progress>
                            <span class="stat-value">{{member.hp}}/{{member.max_hp}}</span>
                        </div>
                        <div class="stat-row">
                            <span class="stat-label">MP</span>
                            <progress class="mp-bar"
                                      data-attr-value="member.mp_ratio">
                            </progress>
                            <span class="stat-value">{{member.mp}}/{{member.max_mp}}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Sub-menu: Skills -->
    <div class="sub-panel jrpg-window win-teal hidden" id="skills-panel">
        <div class="win-title">Skills</div>
        <div class="sub-list" id="skills-list">
            <div data-for="skill : skills" class="sub-item"
                 data-class-disabled="skill.disabled"
                 data-event-click="on_skill(it_index)">
                <span class="cursor">&gt;</span>
                <span class="sub-item-name">{{skill.name}}</span>
                <span class="sub-item-cost">MP {{skill.cost}}</span>
            </div>
        </div>
        <div class="desc-bar" id="skill-desc">{{skill_desc}}</div>
    </div>

    <!-- Sub-menu: Items -->
    <div class="sub-panel jrpg-window win-teal hidden" id="items-panel">
        <div class="win-title">Items</div>
        <div class="sub-list" id="items-list">
            <div data-for="item : items" class="sub-item"
                 data-class-disabled="item.disabled"
                 data-event-click="on_item(it_index)">
                <span class="cursor">&gt;</span>
                <span class="sub-item-name">{{item.name}}</span>
                <span class="sub-item-cost">x{{item.qty}}</span>
            </div>
        </div>
        <div class="desc-bar" id="item-desc">{{item_desc}}</div>
    </div>

</body>
</rml>
