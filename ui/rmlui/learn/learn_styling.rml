<rml>
<head>
    <link type="text/rcss" href="learn_styling.rcss"/>
</head>
<body>
    <!-- ① Font properties -->
    <div class="section">
        <h2>Font Properties</h2>
        <div class="demo-row">
            <div class="font-sample font-normal">13dp normal</div>
            <div class="font-sample font-large">20dp large</div>
            <div class="font-sample font-bold">bold weight</div>
            <div class="font-sample font-spaced">spacing 3dp</div>
        </div>
    </div>

    <!-- ② Text alignment, decoration, transform -->
    <div class="section">
        <h2>Text Align / Decoration / Transform</h2>
        <div class="demo-row">
            <div class="demo-col">
                <p class="label">align</p>
                <div class="text-box text-left">left</div>
                <div class="text-box text-center">center</div>
                <div class="text-box text-right">right</div>
            </div>
            <div class="demo-col">
                <p class="label">decoration</p>
                <div class="text-box text-underline">underline</div>
                <div class="text-box text-overline">overline</div>
                <div class="text-box text-line-through">line-through</div>
            </div>
            <div class="demo-col">
                <p class="label">transform</p>
                <div class="text-box text-upper">upper</div>
                <div class="text-box text-lower">LOWER</div>
                <div class="text-box text-cap">capitalize</div>
            </div>
        </div>
    </div>

    <!-- ③ Text overflow -->
    <div class="section">
        <h2>Text Overflow</h2>
        <div class="demo-row">
            <div class="demo-col">
                <p class="label">ellipsis</p>
                <div class="overflow-box truncate">This is a long sentence truncated with ellipsis</div>
            </div>
            <div class="demo-col">
                <p class="label">clip</p>
                <div class="overflow-box no-truncate">This is a long sentence clipped without indicator</div>
            </div>
        </div>
    </div>

    <!-- ④ Colors + Opacity -->
    <div class="section">
        <h2>Colors &amp; Opacity</h2>
        <div class="demo-row">
            <div class="color-chip c-hex6"></div>
            <div class="color-chip c-hex8"></div>
            <div class="color-chip c-rgb"></div>
            <div class="color-chip c-rgba"></div>
            <div class="color-chip c-hsl"></div>
            <div class="color-chip c-named"></div>
            <div class="spacer"></div>
            <div class="opacity-chip op-100">1.0</div>
            <div class="opacity-chip op-75">.75</div>
            <div class="opacity-chip op-50">.50</div>
            <div class="opacity-chip op-25">.25</div>
        </div>
        <div class="demo-row label-row">
            <p class="chip-lbl">#RGB</p>
            <p class="chip-lbl">#RGBA</p>
            <p class="chip-lbl">rgb</p>
            <p class="chip-lbl">rgba</p>
            <p class="chip-lbl">hsl</p>
            <p class="chip-lbl">named</p>
        </div>
    </div>

    <!-- ⑤ Decorators -->
    <div class="section">
        <h2>Decorators</h2>
        <div class="demo-row">
            <div class="demo-col">
                <div class="dec-box dec-linear"></div>
                <p class="label">linear-v</p>
            </div>
            <div class="demo-col">
                <div class="dec-box dec-linear-h"></div>
                <p class="label">linear-h</p>
            </div>
            <div class="demo-col">
                <div class="dec-box dec-radial"></div>
                <p class="label">radial</p>
            </div>
            <div class="demo-col">
                <div class="dec-box dec-conic"></div>
                <p class="label">conic</p>
            </div>
            <div class="demo-col">
                <div class="dec-box dec-multi"></div>
                <p class="label">multi</p>
            </div>
            <div class="demo-col">
                <div class="dec-box dec-repeat"></div>
                <p class="label">repeat</p>
            </div>
        </div>
    </div>

    <!-- ⑥ Font Effect -->
    <div class="section">
        <h2>Font Effect</h2>
        <div class="demo-row">
            <div class="demo-col">
                <div class="fe-sample fe-shadow">shadow</div>
            </div>
            <div class="demo-col">
                <div class="fe-sample fe-glow">glow</div>
            </div>
            <div class="demo-col">
                <div class="fe-sample fe-outline">outline</div>
            </div>
            <div class="demo-col">
                <div class="fe-sample fe-blur">blur</div>
            </div>
            <div class="demo-col">
                <div class="fe-sample fe-combo">combo</div>
            </div>
        </div>
    </div>

    <!-- ⑦ Character Card + Hover -->
    <div class="section">
        <div class="demo-row">
            <div class="demo-col">
                <h2>Character Card</h2>
                <div class="char-card char-card-bg">
                    <p class="char-name fe-name-glow">Aria</p>
                    <p class="char-class">White Mage</p>
                    <div class="char-hr"></div>
                    <div class="char-stats">
                        <div class="stat-row"><span class="stat-label">HP</span><span class="stat-value stat-hp">320 / 320</span></div>
                        <div class="stat-row"><span class="stat-label">MP</span><span class="stat-value stat-mp">185 / 200</span></div>
                        <div class="stat-row"><span class="stat-label">ATK</span><span class="stat-value stat-atk">42</span></div>
                        <div class="stat-row"><span class="stat-label">DEF</span><span class="stat-value stat-def">58</span></div>
                    </div>
                    <p class="char-desc">A gentle healer who protects allies with sacred magic.</p>
                </div>
            </div>
            <div class="demo-col">
                <h2>:hover / :active</h2>
                <div class="vert-list">
                    <div class="hover-btn">Attack</div>
                    <div class="hover-btn">Magic</div>
                    <div class="hover-btn">Items</div>
                    <div class="hover-btn">Defend</div>
                    <div class="hover-btn">Flee</div>
                </div>
            </div>
        </div>
    </div>
</body>
</rml>
