<rml>
<head>
    <link type="text/rcss" href="learn_forms.rcss"/>
</head>
<body data-model="settings">

    <!-- 标题栏 -->
    <div class="page-header">
        <span class="page-title">L07 — 表单控件 (Form Controls)</span>
        <span class="page-hint">滑块/复选框/单选/下拉/输入/进度条/标签页 • Confirm 触发 form submit</span>
    </div>

    <div class="content-row">

        <!-- ① 表单面板：<form> 包裹 tabset + 按钮 -->
        <form class="panel form-panel" data-event-submit="on_submit">

            <tabset>
                <!-- ── Tab 1: Audio ── -->
                <tab>Audio</tab>
                <!-- ── Tab 2: Display ── -->
                <tab>Display</tab>
                <!-- ── Tab 3: Profile ── -->
                <tab>Profile</tab>

                <!-- ── Panel 1: Audio 音频设置 ── -->
                <panel>
                    <!-- BGM Volume: <input type="range"> + data-value 双向绑定 -->
                    <div class="form-group">
                        <div class="form-label">BGM Volume</div>
                        <div class="slider-row">
                            <input type="range" name="bgm_volume"
                                   min="0" max="100" step="5"
                                   data-value="bgm_volume"/>
                            <span class="slider-value">{{bgm_volume}}</span>
                        </div>
                        <!-- <progress> 可视化音量，data-attr-value 单向绑定属性 -->
                        <progress data-attr-value="bgm_volume" max="100"/>
                    </div>

                    <!-- SE Volume -->
                    <div class="form-group">
                        <div class="form-label">SE Volume</div>
                        <div class="slider-row">
                            <input type="range" name="se_volume"
                                   min="0" max="100" step="5"
                                   data-value="se_volume"/>
                            <span class="slider-value">{{se_volume}}</span>
                        </div>
                        <progress class="progress-green" data-attr-value="se_volume" max="100"/>
                    </div>
                </panel>

                <!-- ── Panel 2: Display 显示设置 ── -->
                <panel>
                    <!-- Fullscreen: <input type="checkbox"> + data-checked 绑定 bool -->
                    <div class="form-group">
                        <div class="check-row">
                            <input type="checkbox" name="fullscreen"
                                   data-checked="fullscreen"/>
                            <span class="check-label">Fullscreen</span>
                        </div>
                    </div>

                    <!-- Text Speed: <select> + data-value 绑定选中项 -->
                    <div class="form-group">
                        <div class="form-label">Text Speed</div>
                        <select name="text_speed" data-value="text_speed">
                            <option value="slow">Slow</option>
                            <option value="medium">Medium</option>
                            <option value="fast">Fast</option>
                        </select>
                    </div>

                    <!-- Window Mode: <input type="radio"> 分组 + data-checked 绑定 string -->
                    <div class="form-group">
                        <div class="form-label">Window Mode</div>
                        <div class="radio-row">
                            <input type="radio" name="window_mode" value="windowed"
                                   data-checked="window_mode"/>
                            <span class="radio-label">Windowed</span>
                        </div>
                        <div class="radio-row">
                            <input type="radio" name="window_mode" value="borderless"
                                   data-checked="window_mode"/>
                            <span class="radio-label">Borderless</span>
                        </div>
                        <div class="radio-row">
                            <input type="radio" name="window_mode" value="exclusive"
                                   data-checked="window_mode"/>
                            <span class="radio-label">Exclusive</span>
                        </div>
                    </div>
                </panel>

                <!-- ── Panel 3: Profile 档案设置 ── -->
                <panel>
                    <!-- Player Name: <input type="text"> + data-value -->
                    <div class="form-group">
                        <div class="form-label">Player Name</div>
                        <input type="text" name="player_name"
                               data-value="player_name" maxlength="16"/>
                    </div>

                    <!-- Password: <input type="password"> 演示密码遮罩 -->
                    <div class="form-group">
                        <div class="form-label">Password (demo)</div>
                        <input type="password" name="password" size="20"/>
                    </div>

                    <!-- Notes: <textarea> + data-value 多行文本绑定 -->
                    <div class="form-group">
                        <div class="form-label">Notes</div>
                        <textarea name="notes" cols="30" rows="3"
                                  data-value="notes"/>
                    </div>
                </panel>
            </tabset>

            <!-- 按钮栏：submit 触发 <form> submit 事件 -->
            <div class="button-row">
                <input type="submit" value="Confirm"/>
                <div class="btn" data-event-click="on_reset">Reset</div>
            </div>

        </form>

        <!-- ② 预览面板：实时显示数据绑定值 -->
        <div class="panel preview-panel">
            <h2>Preview</h2>

            <div class="preview-item">
                <span class="preview-key">BGM: </span>
                <span class="preview-val">{{bgm_volume}}%</span>
            </div>
            <div class="preview-item">
                <span class="preview-key">SE: </span>
                <span class="preview-val">{{se_volume}}%</span>
            </div>
            <div class="preview-item">
                <span class="preview-key">Speed: </span>
                <span class="preview-val">{{text_speed}}</span>
            </div>
            <div class="preview-item">
                <span class="preview-key">Fullscreen: </span>
                <span class="preview-val" data-if="fullscreen">Yes</span>
                <span class="preview-val" data-if="!fullscreen">No</span>
            </div>
            <div class="preview-item">
                <span class="preview-key">Window: </span>
                <span class="preview-val">{{window_mode}}</span>
            </div>
            <div class="preview-item">
                <span class="preview-key">Name: </span>
                <span class="preview-val">{{player_name}}</span>
            </div>
            <div class="preview-item">
                <span class="preview-key">Notes: </span>
                <span class="preview-val">{{notes}}</span>
            </div>

            <hr/>
            <div class="submit-log">Submit: {{submit_log}}</div>
        </div>

    </div>

    <!-- 底部知识点速览 -->
    <div class="info-bar">
        range: <span class="code">data-value</span> •
        checkbox: <span class="code">data-checked</span> •
        radio: <span class="code">data-checked</span> •
        select: <span class="code">data-value</span> •
        progress: <span class="code">data-attr-value</span> •
        form: <span class="code">data-event-submit</span>
    </div>

</body>
</rml>
