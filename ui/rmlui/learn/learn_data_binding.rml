<rml>
<head>
    <link type="text/rcss" href="learn_data_binding.rcss"/>
</head>
<body data-model="character">

    <!-- 标题栏 -->
    <div class="page-header">
        <span class="page-title">L06 — 数据绑定 (Data Binding)</span>
        <span class="page-hint">HP/MP 每 3s 自动回复 • 点击技能消耗 MP • Toggle Poison 演示 data-if</span>
    </div>

    <div class="content-row">

        <!-- ① 角色状态面板：标量绑定 + data-style + data-if + transform -->
        <div class="panel char-panel">

            <!-- 姓名 + 等级：{{name}}  {{level}} 文本插值 -->
            <div class="char-name-row">
                <span class="char-name">{{name}}</span>
                <span class="char-level">Lv.{{level}}</span>
            </div>
            <p class="char-job">{{job}}</p>

            <!-- HP Bar: data-style-width 根据 hp/max_hp 动态设置宽度 -->
            <div class="stat-block">
                <div class="stat-header">
                    <span class="stat-label hp-label">HP</span>
                    <span class="stat-value">{{hp}} / {{max_hp}}</span>
                </div>
                <div class="bar-track">
                    <div class="bar-fill hp-fill" data-style-width="hp * 100 / max_hp + '%'"></div>
                </div>
            </div>

            <!-- MP Bar -->
            <div class="stat-block">
                <div class="stat-header">
                    <span class="stat-label mp-label">MP</span>
                    <span class="stat-value">{{mp}} / {{max_mp}}</span>
                </div>
                <div class="bar-track">
                    <div class="bar-fill mp-fill" data-style-width="mp * 100 / max_mp + '%'"></div>
                </div>
            </div>

            <!-- Gold: {{gold | format_gold}} 管道 Transform 函数 -->
            <div class="gold-row">
                <span class="gold-icon">G</span>
                <span class="gold-value">{{gold | format_gold}}</span>
            </div>

            <!-- Status: data-if 条件显示，is_poisoned / is_stunned 变量控制 -->
            <div class="status-row">
                <span class="status-label">Status:</span>
                <span class="status-badge poison-badge" data-if="is_poisoned">Poisoned</span>
                <span class="status-badge stun-badge" data-if="is_stunned">Stunned</span>
                <span class="status-normal" data-if="!is_poisoned &amp;&amp; !is_stunned">Normal</span>
            </div>

            <!-- 演示按钮：触发 toggle_poison 回调，改变 is_poisoned 后 UI 自动刷新 -->
            <div class="demo-btn" data-event-click="toggle_poison">Toggle Poison</div>

        </div>

        <!-- ② 技能列表：data-for + RegisterStruct<Skill> + data-class + data-event-click -->
        <div class="panel skills-panel">

            <h2>Skills</h2>

            <!-- data-for 渲染技能数组，skill 为循环变量，it_index 为当前索引 -->
            <!-- data-class-mp-low: 当技能消耗 > 当前 MP 时添加 .mp-low 样式 -->
            <div class="skill-list">
                <div class="skill-row"
                     data-for="skill : skills"
                     data-event-click="use_skill(it_index)"
                     data-class-mp-low="skill.mp_cost > mp">
                    <!-- skill.name / skill.mp_cost：访问已注册结构体成员 -->
                    <span class="skill-name">{{skill.name}}</span>
                    <span class="skill-cost" data-if="skill.mp_cost > 0">{{skill.mp_cost}} MP</span>
                    <span class="skill-free" data-if="skill.mp_cost == 0">Free</span>
                </div>
            </div>

            <!-- last_skill_used: 每次点击后由 C++ DirtyVariable 刷新 -->
            <div class="last-skill-row">
                Last used: <span class="skill-hl">{{last_skill_used}}</span>
            </div>

        </div>

    </div>

    <!-- 底部知识点速览（info-bar 脱离 data-model 作用域，用静态文本描述语法）-->
    <div class="info-bar">
        文本插值: <span class="code">name</span> •
        动态样式: <span class="code">data-style-width</span> •
        条件显示: <span class="code">data-if</span> •
        列表渲染: <span class="code">data-for</span> •
        事件回调: <span class="code">data-event-click="fn(it_index)"</span> •
        Transform: <span class="code">gold | format_gold</span>
    </div>

</body>
</rml>
