<rml>
<head>
    <link type="text/rcss" href="../theme/base.rcss"/>
    <link type="text/rcss" href="../theme/animation.rcss"/>
    <link type="text/rcss" href="01_card_showcase.rcss"/>
</head>
<body>
    <div id="screen">
        <div class="panel card anim-slide-in-top transition-opacity">
            <div class="label-large">Card Showcase</div>
            <div class="label">Use this page to test document load and switch behavior.</div>
            <div class="divider"></div>
            <div class="flex-row gap-8 button-row">
                <button class="button button-primary transition-color" data-command="accept">Primary</button>
                <button class="button transition-color" data-command="cancel">Secondary</button>
                <button class="button transition-color" data-command="danger">Danger</button>
            </div>
        </div>
    </div>
</body>
</rml>
