<!-- RmlUi 入门：基本文档结构 -->
<rml>
<head>
    <!-- 引用外部样式表 -->
    <link type="text/rcss" href="learn_hello.rcss"/>
</head>
<body>
    <!-- 主面板容器 -->
    <div id="panel">
        <h1>Hello, RmlUi!</h1>
        <p>This is a minimal RmlUi document for learning.</p>

        <!-- 基本布局：水平排列 -->
        <div class="row">
            <div class="card">Card A</div>
            <div class="card">Card B</div>
        </div>

        <button id="btn-test">Click Me</button>
    </div>
</body>
</rml>
